      </header>
      <a data-reveal href="/services" class="btn btn-ghost">See All Services →</a>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      <!-- 🌟 AI IMAGE GENERATION (wide) -->
      <a data-reveal href="/ai-services" class="group relative overflow-hidden rounded-3xl border border-golden/25 bg-white/80 p-7 shadow-soft backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:shadow-lift dark:bg-night-soft/80 md:col-span-2">
        <span class="pointer-events-none absolute -right-6 -top-6 text-[110px] opacity-[0.07] transition duration-500 group-hover:scale-110 group-hover:opacity-[0.12]">🌟</span>
        <span class="grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-saffron to-golden text-2xl text-white shadow-gold">🌟</span>
        <h3 class="mt-4 font-display text-xl font-bold">AI Image Generation</h3>
        <p class="mt-2 max-w-md text-sm leading-relaxed text-sandal-deep/70 dark:text-cream/60">Generate divine imagery from text — any style, any resolution, with custom deity presets and 4K upscaling built in.</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="chip bg-saffron/10 text-saffron">Custom Deity Styles</span>
          <span class="chip bg-golden/15 text-golden">4K Upscaling</span>
          <span class="chip bg-sandal/10 text-sandal-deep dark:bg-white/5 dark:text-cream/60">Any Size</span>
        </div>
        <span class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-saffron">Open Studio <span class="transition group-hover:translate-x-1">→</span></span>
      </a>

      <!-- 🖼️ FEATURED: DEVOTIONAL POSTERS (tall, real image) -->
      <a data-reveal href="/ai-services?studio=poster" class="group relative overflow-hidden rounded-3xl border border-golden/25 bg-white/80 shadow-soft backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:shadow-lift dark:bg-night-soft/80 md:row-span-2">
        <img src="/templates/ganesh-utsav.png" onerror="this.onerror=null;this.src='https://picsum.photos/seed/ganesh-utsav-poster/480/672'" alt="Devotional poster — Ganesh Utsav" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" />
        <span class="absolute inset-0 bg-gradient-to-t from-ink/95 via-ink/40 to-transparent"></span>
        <span class="chip absolute left-4 top-4 bg-white/90 !px-2.5 !py-1 text-[10px] font-bold text-ink shadow-soft">🖼️ Featured</span>
        <span class="relative flex h-full min-h-[320px] flex-col justify-end p-7">
          <span class="grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-saffron to-golden text-2xl text-white shadow-gold">🪔</span>
          <h3 class="mt-4 font-display text-xl font-bold text-white">Devotional Posters</h3>
          <p class="mt-2 text-sm leading-relaxed text-cream/80">Traditional festival poster templates, organized by category — select, customize, and generate in minutes.</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-goldsoft">Poster Studio <span class="transition group-hover:translate-x-1">→</span></span>
        </span>
      </a>

      <!-- 🎬 VIDEO & REELS -->
      <a data-reveal href="/ai-services?studio=video" class="group relative overflow-hidden rounded-3xl border border-golden/25 bg-white/80 p-7 shadow-soft backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:shadow-lift dark:bg-night-soft/80">
        <span class="pointer-events-none absolute -right-6 -top-6 text-[110px] opacity-[0.07] transition duration-500 group-hover:scale-110 group-hover:opacity-[0.12]">🎬</span>
        <span class="grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-saffron to-golden text-2xl text-white shadow-gold">🎬</span>
        <h3 class="mt-4 font-display text-xl font-bold">Video Generation</h3>
        <p class="mt-2 text-sm leading-relaxed text-sandal-deep/70 dark:text-cream/60">Cinematic aarti films, festival aftermovies, and devotional edits crafted with soulful pacing — scroll-stopping vertical content with strong hooks, seamless transitions, and trending devotional audio.</p>
        <span class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-saffron">See How <span class="transition group-hover:translate-x-1">→</span></span>
      </a>

      <!-- 🎙️ VOICEOVERS -->
        <a data-reveal href="/ai-services?studio=voice" class="group relative overflow-hidden rounded-3xl border border-golden/25 bg-white/80 p-7 shadow-soft backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:shadow-lift dark:bg-night-soft/80">
        <span class="pointer-events-none absolute -right-6 -top-6 text-[110px] opacity-[0.07] transition duration-500 group-hover:scale-110 group-hover:opacity-[0.12]">🎙️</span>
        <span class="grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-saffron to-golden text-2xl text-white shadow-gold">🎙️</span>
        <h3 class="mt-4 font-display text-xl font-bold">Voiceovers</h3>
        <p class="mt-2 text-sm leading-relaxed text-sandal-deep/70 dark:text-cream/60">Warm, studio-quality narration in Marathi, Hindi, Sanskrit, and English — matched to the tone of every occasion.</p>
        <span class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-saffron">Listen Sample <span class="transition group-hover:translate-x-1">→</span></span>
      </a>

      <!-- 📺 YOUTUBE MANAGEMENT (dark wide) -->
      <a data-reveal href="/services" class="group relative overflow-hidden rounded-3xl border border-golden/25 bg-gradient-to-br from-ink to-[#3a2410] p-7 text-cream shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-lift dark:from-night-soft dark:to-black md:col-span-3">
        <span class="pointer-events-none absolute -right-6 -top-6 text-[110px] opacity-[0.08] transition duration-500 group-hover:scale-110 group-hover:opacity-[0.14]">📺</span>
        <div class="flex flex-wrap items-center gap-6">
          <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-saffron to-golden text-2xl text-white shadow-gold">📺</span>

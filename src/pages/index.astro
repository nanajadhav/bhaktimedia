            <div class="mt-3 flex flex-wrap gap-2">
              <span class="chip bg-white/10 text-cream/80">Livestream Setup</span>
              <span class="chip bg-white/10 text-cream/80">Thumbnail Design</span>
              <span class="chip bg-white/10 text-cream/80">SEO Growth</span>
            </div>
          </div>
          <span class="inline-flex items-center gap-1 text-sm font-bold text-goldsoft">See Growth <span class="transition group-hover:translate-x-1">→</span></span>

---
import Layout from "../layouts/Layout.astro";
import CTA from "../components/CTA.astro";
import { deityGallery } from "../data/gallery";
import { picsum } from "../lib/utils";

const HERO = "/murti/datta/preview/dt-001.png";

const SERVICES = [
  { icon: "🪔", title: "Devotional Posters", desc: "Traditional festival poster templates — category wise, select karo aur generate karo.", chips: [] },
  { icon: "🛕", title: "Temple Branding", desc: "Complete identity systems for mandirs — signage, trusts, events and print collateral.", chips: [] },
  { icon: "📺", title: "YouTube Management", desc: "End-to-end channel care: strategy, aarti livestreams, editing, thumbnails, SEO.", chips: ["Channel strategy", "Aarti livestreams", "SEO & analytics"] },
  { icon: "✨", title: "AI Image Generation", desc: "Text se divine images — koi bhi style, koi bhi size, custom deity styles and 4K upscaling.", chips: ["Custom deity styles", "4K upscaling", "Poster-ready art"] },
  { icon: "🎬", title: "Video Editing", desc: "Cinematic aarti films, utsav aftermovies, and devotional edits with soulful pacing.", chips: [] },
  { icon: "📱", title: "Bhakti Reels", desc: "Scroll-stopping vertical devotion — hooks, transitions, and trending devotional audio.", chips: [] },
  { icon: "🎙️", title: "Voiceovers", desc: "Warm, studio-grade narration in Marathi, Hindi, Sanskrit, and English.", chips: [] },
  { icon: "🖼️", title: "Thumbnail Design", desc: "High-CTR thumbnails tuned for spiritual audiences and YouTube's algorithm.", chips: [] },
  { icon: "📣", title: "Social Media", desc: "Calendars, captions, and community management for temples and creators.", chips: [] },
  { icon: "🌐", title: "Website Design", desc: "Fast, SEO-ready temple and creator websites built on modern stacks.", chips: [] },
];

const POSTERS = [
  { title: "Ganesh Utsav 2026", deity: "Shri Ganesh", img: "/templates/ganesh-utsav.png", fest: "ganesh" },
  { title: "Swami Samarth Jayanti", deity: "Shri Swami Samarth", img: "/templates/swami-samarth-jayanti.png", fest: "swami" },
  { title: "Datta Jayanti", deity: "Shri Datta", img: "/templates/datta-jayanti.png", fest: "datta" },
  { title: "Hanuman Chalisa", deity: "Shri Hanuman", img: "/templates/hanuman-chalisa.png", fest: "hanuman" },
  { title: "Navratri Utsav", deity: "Maa Durga", img: "/templates/navratri-utsav.png", fest: "navratri" },
];

const GALLERY = deityGallery.flatMap((d) =>
  d.images.slice(0, 2).map((i) => ({ ...i, did: d.id, dname: d.name }))
);

const TESTIMONIALS = [
  { quote: "BhaktiMedia redesigned our temple's entire digital presence — aarti livestream graphics to festival posters. Devotees noticed immediately.", name: "Ramesh Kulkarni", role: "Trustee, Shri Ganesh Mandir, Pune", init: "RK" },
  { quote: "Our YouTube channel grew from 8K to 240K subscribers in one year. The thumbnails alone doubled our click-through rate.", name: "Sneha Deshpande", role: "Creator, Bhakti Sagar (240K subs)", init: "SD" },
  { quote: "The AI posters they created for our Utsav looked divine — every detail was respectful, accurate, and beautiful.", name: "Ajay Patil", role: "Utsav Committee, Akurdi", init: "AP" },
  { quote: "Professional, fast, and deeply respectful of our traditions. The Marathi voiceovers gave me goosebumps.", name: "Meera Joshi", role: "Temple Trust, Nashik", init: "MJ" },
  { quote: "They handle our reels, posters, and ads end-to-end. It feels like having a full creative team inside the trust.", name: "Vikram Bhosale", role: "Administrator, Datta Mandir", init: "VB" },
];

const BLOGS = [
  { tag: "AI & Ethics", date: "8 Jul 2026", read: "1 min read", title: "AI Image Generation for Bhakti: Prompts, Ethics & Aesthetics", desc: "How we generate devotional AI art that is beautiful, accurate and respectful of tradition.", seed: "blog-ai-ethics" },
  { tag: "Temple Branding", date: "2 May 2026", read: "1 min read", title: "How Temples Can Grow Their Digital Presence in 2026", desc: "Livestreams, festival calendars aur devotee community — ek practical playbook.", seed: "blog-temple-growth" },
  { tag: "Reels", date: "18 Apr 2026", read: "1 min read", title: "Bhakti Reels: 7 Hooks That Stop the Scroll", desc: "Vertical devotion ke liye proven hooks jo scroll roktein hain.", seed: "blog-reels-hooks" },
];

const MANTRAS = ["श्री गणेशाय नमः", "श्री गुरुदेव नमः", "श्री स्वामी समर्थ", "श्री दत्तात्रेय नमः", "हनुमान् चिरंजीवी", "जय श्री राम", "हरे कृष्ण हरे राम", "ॐ शांति शांति शांति"];
---
<Layout title="Home" description="BhaktiMedia — devotional posters, AI images, reels, YouTube management aur temple branding. Digital devotion for every heart.">
<style>
  @keyframes bhm-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .bhm-marquee { animation: bhm-marquee 32s linear infinite; }
</style>

  <!-- ═══ HERO ═══ -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute -right-32 top-10 h-[420px] w-[420px] rounded-full bg-saffron/10 blur-3xl"></div>
    <span class="pointer-events-none absolute right-6 top-24 select-none font-dev text-[140px] text-saffron/5">ॐ</span>
    <div class="container-x grid items-center gap-10 px-4 pb-16 pt-28 sm:px-6 lg:grid-cols-2 lg:pb-24">
      <div>
        <span class="chip bg-saffron/10 text-saffron">🪔 Digital Devotion For Every Heart</span>
        <h1 class="mt-5 font-display text-4xl font-bold leading-tight sm:text-5xl xl:text-6xl">
          Experience <span class="bg-gradient-to-r from-saffron to-golden bg-clip-text text-transparent">Divine</span> Creativity Through Digital Media.
        </h1>
        <p class="mt-5 max-w-lg text-sm leading-relaxed text-sandal-deep/70 dark:text-cream/60">
          BhaktiMedia creates devotional videos, AI images, reels, posters, YouTube content, social media branding and spiritual digital experiences — built with the same care a temple gives its sanctum.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/services" class="btn btn-primary">Explore →</a>
          <a href="#posters" class="btn btn-outline">▶ Watch Demo</a>
          <a href="/contact" class="btn btn-glass">Contact Us</a>
        </div>
        <div class="mt-7 flex items-center gap-3">
          <div class="flex -space-x-2">
            {["RK", "SD", "AP", "MJ"].map((i) => (
              <span class="grid size-8 place-items-center rounded-full bg-gradient-to-br from-saffron to-golden text-[10px] font-bold text-white ring-2 ring-temple dark:ring-night">{i}</span>
            ))}
          </div>
          <p class="text-xs text-sandal-deep/60 dark:text-cream/50"><b class="text-golden">★★★★★</b><br/>Trusted by 100+ temples & creators across India</p>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-md">
        <div class="overflow-hidden rounded-t-[999px] rounded-b-3xl border border-golden/30 shadow-lift">
          <img src={HERO} onerror={`this.onerror=null;this.src='${picsum("divine-hero", 800, 1000)}'`} alt="Divine AI art — Shri Datta" class="aspect-[4/5] w-full object-cover" />
        </div>
        <span class="chip absolute left-4 top-6 bg-white/90 text-[10px] font-bold text-ink shadow-soft">✨ AI Generated Art</span>
        <div class="absolute -bottom-4 left-1/2 flex -translate-x-1/2 items-center gap-2 rounded-full bg-white px-4 py-2 shadow-lift dark:bg-night">
          <span class="grid size-7 place-items-center rounded-full bg-gradient-to-br from-saffron to-golden text-xs text-white">▶</span>
          <span class="text-xs font-bold">2.4M views <span class="font-normal text-sandal-deep/60 dark:text-cream/50">• Bhakti Reels + Ganesh Utsav</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ MANTRA MARQUEE ═══ -->
  <div class="overflow-hidden bg-ink py-3 dark:bg-white/5">
    <div class="bhm-marquee flex w-max gap-8">
      {[...MANTRAS, ...MANTRAS].map((m) => (
        <span class="flex items-center gap-8 whitespace-nowrap font-dev text-sm text-goldsoft">{m} <span class="text-saffron">✦</span></span>
      ))}
    </div>
  </div>

  <!-- ═══ SERVICES ═══ -->
  <section class="section">
    <div class="container-x px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Our Seva</p>
          <h2 class="mt-2 font-display text-3xl font-bold sm:text-4xl">Crafted With Devotion,<br/>Delivered With <span class="text-saffron">Precision</span></h2>
          <p class="mt-2 font-dev text-sm text-goldsoft">॥ सेवा परमो धर्मः ॥</p>
        </div>
        <a href="/services" class="btn btn-glass !py-2 !text-xs">All services ↗</a>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {SERVICES.map((s) => (
          <div class="card group p-5 shadow-soft transition hover:-translate-y-1 hover:shadow-lift">
            <div class="flex items-start justify-between">
              <span class="grid size-10 place-items-center rounded-xl bg-gradient-to-br from-saffron to-golden text-lg text-white shadow-gold">{s.icon}</span>
              <span class="text-sandal/40 transition group-hover:text-saffron">↗</span>
            </div>
            <p class="mt-3 font-display text-sm font-bold">{s.title}</p>
            <p class="mt-1.5 text-xs leading-relaxed text-sandal-deep/60 dark:text-cream/50">{s.desc}</p>
            {s.chips.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {s.chips.map((c) => <span class="chip bg-sandal/10 !px-2 !py-0.5 text-[9px] text-sandal-deep dark:bg-white/5 dark:text-cream/60">{c}</span>)}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ STATS ═══ -->
  <section class="bg-ink py-10 dark:bg-white/5">
    <div class="container-x grid grid-cols-2 gap-6 px-4 text-center sm:px-6 md:grid-cols-4">
      {[["1,000+", "Creative Designs"], ["500+", "Videos Produced"], ["100+", "Happy Clients"], ["25M+", "Total Views"]].map((s) => (
        <div>
          <p class="font-display text-3xl font-bold text-golden sm:text-4xl">{s[0]}</p>
          <p class="mt-1 text-[10px] uppercase tracking-widest text-cream/50">{s[1]}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ FESTIVAL POSTERS ═══ -->
  <section id="posters" class="section">
    <div class="container-x px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Festival Posters</p>
          <h2 class="mt-2 font-display text-3xl font-bold sm:text-4xl">Posters That Devotees <span class="text-saffron">Frame</span></h2>
          <p class="mt-2 font-dev text-sm text-goldsoft">॥ उत्सव घोषणा ॥</p>
        </div>
        <a href="/ai-services?studio=poster" class="btn btn-primary !py-2 !text-xs">Open Poster Studio →</a>
      </div>
      <div class="no-scrollbar mt-8 flex gap-4 overflow-x-auto pb-2">
        {POSTERS.map((p) => (
          <a href={`/posters?fest=${p.fest}`} class="group relative w-44 shrink-0 overflow-hidden rounded-2xl border border-sandal/10 shadow-soft transition hover:-translate-y-1 hover:shadow-lift dark:border-white/10">
            <img src={p.img} onerror={`this.onerror=null;this.src='${picsum("poster-" + p.fest, 400, 560)}'`} alt={p.title} class="aspect-[5/7] w-full object-cover transition duration-700 group-hover:scale-105" />
            <span class="chip absolute left-2 top-2 bg-ink/60 !px-2 !py-0.5 text-[9px] text-white backdrop-blur">Print Ready</span>
            <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/90 to-transparent px-3 pb-3 pt-8">
              <span class="block text-[10px] text-goldsoft">{p.deity}</span>
              <span class="block font-display text-xs font-bold text-white">{p.title}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ DIVINE GALLERY (real murti art) ═══ -->
  <section class="section !pt-0">
    <div class="container-x px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Divine Gallery</p>
          <h2 class="mt-2 font-display text-3xl font-bold sm:text-4xl">Moments of <span class="text-saffron">Devotion</span></h2>
        </div>
        <a href="/gallery" class="btn btn-glass !py-2 !text-xs">Full Gallery</a>
      </div>
      <div class="mt-8 columns-2 gap-4 md:columns-3 xl:columns-4">
        {GALLERY.map((g) => (
          <a href="/gallery" class="group mb-4 block break-inside-avoid overflow-hidden rounded-2xl border border-sandal/10 shadow-soft dark:border-white/10">
            <img src={g.id ? `/murti/${g.did}/preview/${g.id}.png` : picsum(g.seed, g.w, g.h)}
                 onerror={g.id ? `this.onerror=null;this.src='${picsum(g.seed, g.w, g.h)}'` : undefined}
                 alt={g.title} loading="lazy" class="w-full object-cover transition duration-700 group-hover:scale-105" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ BLOG ═══ -->
  <section class="section !pt-0">
    <div class="container-x px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">From the Blog</p>
          <h2 class="mt-2 font-display text-3xl font-bold sm:text-4xl">Latest <span class="text-saffron">Wisdom</span></h2>
          <p class="mt-2 font-dev text-sm text-goldsoft">॥ ज्ञानदीपः ॥</p>
        </div>
        <a href="/blog" class="btn btn-glass !py-2 !text-xs">All Articles</a>
      </div>
      <div class="mt-8 grid gap-5 lg:grid-cols-2">
        <a href="/blog" class="card group overflow-hidden shadow-soft transition hover:shadow-lift">
          <img src={picsum(BLOGS[0].seed, 800, 420)} alt="" class="aspect-[16/8] w-full object-cover transition duration-700 group-hover:scale-105" />
          <div class="p-5">
            <p class="text-[10px] text-sandal-deep/50 dark:text-cream/40">{BLOGS[0].tag} • {BLOGS[0].read} • {BLOGS[0].date}</p>
            <p class="mt-2 font-display text-lg font-bold group-hover:text-saffron">{BLOGS[0].title}</p>
            <p class="mt-1 text-xs text-sandal-deep/60 dark:text-cream/50">{BLOGS[0].desc}</p>
          </div>
        </a>
        <div class="grid gap-4">
          {BLOGS.slice(1).map((b) => (
            <a href="/blog" class="card flex gap-4 p-4 shadow-soft transition hover:shadow-lift">
              <img src={picsum(b.seed, 200, 200)} alt="" class="size-20 shrink-0 rounded-xl object-cover" />
              <span>
                <span class="chip bg-saffron/10 !px-2 !py-0.5 text-[9px] text-saffron">{b.tag}</span>
                <span class="mt-1.5 block font-display text-sm font-bold hover:text-saffron">{b.title}</span>
                <span class="mt-1 block text-[10px] text-sandal-deep/50 dark:text-cream/40">{b.read} • {b.date}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TESTIMONIALS ═══ -->
  <section class="section !pt-0">
    <div class="container-x px-4 sm:px-6">
      <p class="eyebrow">Testimonials</p>
      <h2 class="mt-2 font-display text-3xl font-bold sm:text-4xl">Voices of <span class="text-saffron">Faith & Trust</span></h2>
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {TESTIMONIALS.map((t) => (
          <div class="card p-5 shadow-soft">
            <p class="text-xs text-golden">★★★★★</p>
            <p class="mt-3 text-sm leading-relaxed text-sandal-deep/70 dark:text-cream/60">"{t.quote}"</p>
            <div class="mt-4 flex items-center gap-3">
              <span class="grid size-10 place-items-center rounded-full bg-gradient-to-br from-saffron to-golden text-xs font-bold text-white">{t.init}</span>
              <span>
                <span class="block text-sm font-bold">{t.name}</span>
                <span class="block text-[10px] text-sandal-deep/50 dark:text-cream/40">{t.role}</span>
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Layout>
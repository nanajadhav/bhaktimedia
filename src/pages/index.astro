    <!-- remaining services strip -->
    <div data-reveal class="mt-8 flex flex-wrap items-center justify-center gap-2 rounded-2xl border border-sandal/10 bg-white/60 px-5 py-4 text-xs dark:border-white/10 dark:bg-white/5">
      <span class="font-semibold text-sandal-deep/60 dark:text-cream/50">Also available:</span>
      {["Temple Branding", "Thumbnail Design", "Social Media", "Website Design"].map((s) => (
        <span class="chip bg-sandal/10 text-sandal-deep dark:bg-white/5 dark:text-cream/60">{s}</span>
      ))}
      <a href="/services" class="font-bold text-saffron underline underline-offset-4">see all →</a>
    </div>
  </div>
</section>

<!-- ══════════ STATS ══════════ -->
<section class="relative overflow-hidden bg-ink py-20 text-cream">
  <div class="hero-rays absolute inset-x-0 top-0 h-72 opacity-50" aria-hidden="true"></div>
  <div class="container-x relative grid grid-cols-2 gap-x-6 gap-y-12 text-center lg:grid-cols-4">
    {[{ v: 1000, s: "+", l: "Creative Designs" }, { v: 500, s: "+", l: "Videos Produced" }, { v: 100, s: "+", l: "Happy Clients" }, { v: 25, s: "M+", l: "Total Views" }].map((st, i) => (
      <div data-reveal style={`--rd:${i * 100}ms`}>
        <p class="font-display text-4xl font-bold text-gradient md:text-5xl" data-count={st.v} data-suffix={st.s}>0</p>
        <p class="mt-2 text-xs uppercase tracking-[0.25em] text-cream/60 md:text-sm">{st.l}</p>
      </div>
    ))}
  </div>
</section>

<!-- ══════════ POSTERS ══════════ -->
<section class="section pattern-sacred bg-cream/60 dark:bg-night-soft/30">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <header data-reveal>
        <p class="eyebrow">Festival Posters</p>
        <h2 class="mt-4 font-display text-3xl font-bold tracking-tight sm:text-4xl">Posters That Devotees <span class="text-gradient">Frame</span></h2>
        <p class="mt-2 font-dev text-sandal dark:text-golden/80">॥ उत्सव घोषणा ॥</p>
        <p class="mt-3 max-w-lg text-sm text-sandal-deep/70 dark:text-cream/60">From Ganesh Utsav to Navratri to Datta Jayanti — festival-ready, print-ready posters designed with the right colors, symbols, and reverence for every occasion.</p>
      </header>
      <a data-reveal href="/ai-services?studio=poster" class="btn btn-primary">Open Poster Studio
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>

---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import CTA from "../components/CTA.astro";
import { site } from "../data/site";

const features = [
  { icon: "🛕", title: "Temple Websites", desc: "Darshan timings, event calendars, trustee info and donation pages — everything a modern temple needs." },
  { icon: "🎨", title: "Creator Portfolios", desc: "For singers, speakers and artists — beautiful portfolios with embedded audio and video." },
  { icon: "⚡", title: "Fast & SEO-Ready", desc: "Modern stacks, quick loads and Google-friendly structure so devotees actually find you." },
  { icon: "🖼️", title: "Gallery & Media", desc: "Photo and video galleries with lightbox viewing and download options for your community." },
  { icon: "💳", title: "Payments & Donations", desc: "UPI and payment integration for seva bookings, donations and event registrations." },
  { icon: "🛠️", title: "Care & Updates", desc: "Monthly maintenance, backups and content updates — your site stays fresh forever." },
];

const steps = [
  { num: "०१", title: "Discover", desc: "One call to understand your mission, your visitors and your goals." },
  { num: "०२", title: "Design & Build", desc: "Drafts for your approval, then a full build with your content and branding." },
  { num: "०३", title: "Launch & Care", desc: "We go live, train your team — and stay on for care and updates." },
];
---
<Layout title="Website Design" description="Fast, SEO-ready temple and creator websites built on modern stacks.">
  <PageHeader eyebrow="Service" title="Website Design" dev="॥ डिजिटल मंदिरम् ॥"
    description="Fast, SEO-ready temple and creator websites built on modern stacks — your digital home, worthy of your seva." />

  <section class="section !pt-2">
    <div class="container-x">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f, i) => (
          <article data-reveal style={`--rd:${i * 80}ms`} class="card p-6 shadow-soft">
            <span class="grid size-11 place-items-center rounded-xl bg-gradient-to-br from-saffron to-golden text-xl text-white">{f.icon}</span>
            <h3 class="mt-4 font-display text-lg font-semibold">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-sandal-deep/75 dark:text-cream/65">{f.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-cream/50 dark:bg-night-soft/30">
    <div class="container-x">
      <h2 class="font-display text-3xl font-bold">How it works</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {steps.map((s, i) => (
          <article data-reveal style={`--rd:${i * 100}ms`} class="card relative p-7">
            <span class="font-dev text-4xl text-golden/70">॥ {s.num} ॥</span>
            <h3 class="mt-4 font-display text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-sandal-deep/75 dark:text-cream/65">{s.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="card flex flex-col items-start justify-between gap-6 p-8 shadow-lift md:flex-row md:items-center">
        <div>
          <h2 class="font-display text-2xl font-bold">Every project is custom — every quote is clear</h2>
          <p class="mt-2 max-w-xl text-sm text-sandal-deep/70 dark:text-cream/60">Share your vision and we'll send a detailed proposal within 24 hours.</p>
        </div>
        <div class="flex shrink-0 gap-3">
          <a href="/contact" class="btn btn-primary">Contact Us</a>
          <a href={site.socials.whatsapp} target="_blank" rel="noopener" class="btn btn-outline">WhatsApp Us</a>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</Layout>
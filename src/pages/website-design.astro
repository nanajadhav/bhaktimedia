---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import CTA from "../components/CTA.astro";
import { site } from "../data/site";

// ── Custom line-icons — real website design & development work, not decorative emoji ──
const icons = {
  layout: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>',
  devices: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>',
  edit: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>',
  zap: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>',
  card: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>',
  server: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2"/><rect width="20" height="8" x="2" y="14" rx="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>',
  compass: '<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>',
  code: '<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
  rocket: '<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>',
  arrowUpRight: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>',
  whatsapp: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>',
};

// Real website design & development scope — not filler copy
const features = [
  { icon: "layout", title: "Custom Design & UX", desc: "No generic templates. Layouts, colors and typography built around your brand and how visitors actually move through the site.", span: "lg" },
  { icon: "devices", title: "Responsive Development", desc: "Pixel-checked on real phones, tablets and desktops — not just a resized browser window." },
  { icon: "edit", title: "Content You Can Manage", desc: "Edit text, images, timings and events yourself after launch — no developer needed for daily updates." },
  { icon: "zap", title: "Performance & SEO", desc: "Fast loads, clean semantic markup and search-ready structure, so devotees and Google both find you easily.", span: "lg" },
  { icon: "card", title: "Payments & Integrations", desc: "UPI, cards, booking forms, WhatsApp and calendar tools wired in, tested end-to-end before launch." },
  { icon: "server", title: "Hosting, Launch & Support", desc: "Domain, hosting, SSL and a monthly care plan — we stay on after the site goes live." },
];

const steps = [
  { num: "01", dev: "०१", icon: "compass", title: "Discover", desc: "One call to understand your mission, your visitors and your goals." },
  { num: "02", dev: "०२", icon: "code", title: "Design & Build", desc: "Drafts for your approval, then a full build with your content and branding." },
  { num: "03", dev: "०३", icon: "rocket", title: "Launch & Care", desc: "We go live, train your team, and stay on for care and updates." },
];
---
<Layout title="Website Design & Development" description="Fast, SEO-ready temple and creator websites — custom design, responsive builds, payments, and ongoing care.">
  <PageHeader eyebrow="Service" title="Website Design & Development" dev="॥ डिजिटल मंदिरम् ॥"
    description="Fast, SEO-ready temple and creator websites built on modern stacks — your digital home, worthy of your seva." />

  <!-- ══════════ WHAT'S INCLUDED (asymmetric bento) ══════════ -->
  <section class="section relative overflow-hidden !pt-2">
    <div class="pointer-events-none absolute -left-40 top-10 h-96 w-96 rounded-full bg-saffron/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-40 bottom-0 h-96 w-96 rounded-full bg-golden/10 blur-3xl"></div>

    <div class="container-x relative">
      <p class="eyebrow" data-reveal>What's Included</p>
      <h2 data-reveal style="--rd:60ms" class="mt-4 max-w-lg font-display text-3xl font-bold tracking-tight sm:text-4xl">
        A Website Built <span class="text-gradient">Like a Temple</span> — With Care
      </h2>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f, i) => (
          <article data-reveal data-spot style={`--rd:${i * 80}ms`}
            class={`group relative overflow-hidden rounded-3xl border border-golden/25 bg-white/80 p-7 shadow-soft backdrop-blur-xl transition-all duration-300 hover:-translate-y-1.5 hover:border-saffron/40 hover:shadow-lift dark:bg-night-soft/80 ${f.span === "lg" ? "sm:col-span-2" : ""}`}>
            <span class="spot pointer-events-none absolute inset-0"></span>
            <span class="pointer-events-none absolute -right-14 -top-14 size-48 rounded-full bg-gradient-to-br from-saffron/25 to-golden/5 opacity-0 blur-2xl transition duration-500 group-hover:opacity-100"></span>

            <div class="relative flex items-start justify-between">
              <span class="icon-float grid size-16 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-saffron to-golden text-white shadow-gold transition duration-300 group-hover:rotate-3 group-hover:scale-110">
                <span set:html={icons[f.icon as keyof typeof icons]} />
              </span>
              <span class="mt-1 size-5 text-sandal/40 opacity-0 transition duration-300 -translate-x-1 translate-y-1 group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100 group-hover:text-saffron dark:text-cream/30">
                <span set:html={icons.arrowUpRight} />
              </span>
            </div>

            <h3 class="relative mt-6 font-display text-xl font-bold">{f.title}</h3>
            <p class="relative mt-2.5 max-w-md text-sm leading-relaxed text-sandal-deep/80 dark:text-cream/70">{f.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════ HOW IT WORKS (connected timeline) ══════════ -->
  <section class="section relative overflow-hidden bg-cream/50 dark:bg-night-soft/30">
    <div class="dots-bg pointer-events-none absolute inset-0"></div>
    <div class="container-x relative">
      <p class="eyebrow" data-reveal>The Process</p>
      <h2 data-reveal style="--rd:60ms" class="mt-4 font-display text-3xl font-bold tracking-tight sm:text-4xl">How It Works</h2>

      <div class="relative mt-14">
        <div class="pointer-events-none absolute left-0 right-0 top-8 hidden h-px bg-gradient-to-r from-transparent via-golden/50 to-transparent sm:block" aria-hidden="true"></div>

        <div class="grid gap-8 sm:grid-cols-3">
          {steps.map((s, i) => (
            <div data-reveal style={`--rd:${i * 110}ms`} class="relative flex flex-col items-start">
              <span class="relative z-10 grid size-16 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-saffron to-golden text-white shadow-gold ring-4 ring-cream dark:ring-night-soft">
                <span set:html={icons[s.icon as keyof typeof icons]} />
              </span>
              <span class="mt-5 flex items-center gap-2">
                <span class="font-display text-sm font-bold text-saffron">{s.num}</span>
                <span class="font-dev text-sm text-golden/70">॥ {s.dev} ॥</span>
              </span>
              <h3 class="mt-2 font-display text-lg font-semibold">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-sandal-deep/80 dark:text-cream/70">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ QUOTE STRIP ══════════ -->
  <section class="section">
    <div class="container-x">
      <div class="relative overflow-hidden rounded-3xl border border-golden/25 bg-white/80 p-8 shadow-lift backdrop-blur-xl dark:bg-night-soft/80 md:p-10">
        <span class="pointer-events-none absolute -left-16 -top-16 size-64 rounded-full bg-saffron/10 blur-3xl"></span>
        <span class="pointer-events-none absolute -right-16 -bottom-16 size-64 rounded-full bg-golden/10 blur-3xl"></span>

        <div class="relative flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
          <div class="flex items-start gap-4">
            <span class="hidden shrink-0 grid size-14 place-items-center rounded-2xl bg-gradient-to-br from-saffron to-golden text-2xl text-white shadow-gold sm:grid">🪔</span>
            <div>
              <h2 class="font-display text-2xl font-bold">Every project is custom — every quote is clear</h2>
              <p class="mt-2 max-w-xl text-sm leading-relaxed text-sandal-deep/80 dark:text-cream/70">Share your vision and we'll send a detailed proposal within 24 hours.</p>
            </div>
          </div>
          <div class="flex shrink-0 gap-3">
            <a href="/contact" class="btn btn-primary">Contact Us</a>
            <a href={site.socials.whatsapp} target="_blank" rel="noopener" class="btn btn-outline inline-flex items-center gap-2">
              <span set:html={icons.whatsapp} /> WhatsApp Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</Layout>

<style>
  .dots-bg {
    background-image: radial-gradient(circle at 1px 1px, rgba(224, 138, 42, 0.16) 1px, transparent 0);
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
  }
  .icon-float { animation: icon-float 6s ease-in-out infinite; }
  @keyframes icon-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .spot {
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 170, 60, 0.14), transparent 60%);
  }
  [data-spot]:hover .spot { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .icon-float { animation: none; }
    .spot { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-spot]').forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import CTA from "../components/CTA.astro";
import { deityGallery } from "../data/gallery";
import { picsum } from "../lib/utils";
---
<Layout title="Divine Gallery" description="Deity-wise devotional gallery — stock-style downloads, ratios, related images aur watermark protection.">
  <PageHeader eyebrow="Divine Gallery" title="Darshan In Every Frame" dev="॥ दर्शन गैलरी ॥"
    description="Deity chuno, ratio dekho, download karo. Guest = 0.6K watermark free • Plan mein 1K clean (0.3⚡) aur Full HD (0.5⚡)." />

  <!-- data for JS -->
  <script type="application/json" id="gallery-data" set:html={JSON.stringify(
    deityGallery.map((d) => ({ id: d.id, name: d.name, dev: d.dev, images: d.images }))
  )} />

  <section class="section !pt-2">
    <div class="container-x">

      <!-- ══════════ CATEGORY BAR ══════════ -->
      <div id="cat-bar" class="no-scrollbar sticky top-24 z-30 -mx-2 flex gap-2 overflow-x-auto rounded-2xl border border-golden/20 bg-temple/85 p-2 backdrop-blur-xl dark:bg-night/85">
        <button data-cat="all" aria-pressed="true" class="filter-btn flex shrink-0 items-center gap-2">
          <span class="grid size-7 place-items-center rounded-full bg-gradient-to-br from-saffron to-golden font-dev text-sm text-white">ॐ</span>
          All Deities
        </button>
        {deityGallery.map((d) => (
          <button data-cat={d.id} aria-pressed="false" class="filter-btn flex shrink-0 items-center gap-2">
            <img src={picsum(d.seed, 64, 64)} alt="" class="size-7 rounded-full object-cover ring-1 ring-golden/50" />
            {d.name}
          </button>
        ))}
      </div>

      <!-- count + plan quota -->
      <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
        <p id="gallery-count" class="text-sm text-sandal/70 dark:text-cream/60"></p>
        <div class="flex items-center gap-2">
          <span id="plan-chip" class="chip bg-ink/10 text-ink dark:bg-white/10 dark:text-cream">🪔 Quota load ho raha hai...</span>
          <a href="/pricing" class="btn btn-gold !px-4 !py-1.5 !text-xs">⭐ Upgrade Plan</a>
        </div>
      </div>

      <!-- ══════════ MASONRY GRID ══════════ -->
      <div id="gallery-grid" class="mt-4 columns-2 gap-4 md:columns-3 xl:columns-4">
        {deityGallery.map((d) =>
          d.images.map((img) => (
            <figure data-deity={d.id} data-seed={img.seed} data-id={img.id || img.seed} data-w={img.w} data-h={img.h}
                    data-ratio={img.ratio} data-title={`${d.name} — ${img.title}`}
                    class="group relative mb-4 block w-full break-inside-avoid overflow-hidden rounded-2xl border border-sandal/10 shadow-soft transition duration-300 hover:shadow-lift dark:border-white/10">
              <button data-lightbox class="block w-full text-left">
                <img src={img.id ? `/murti/${d.id}/preview/${img.id}.png` : picsum(img.seed, img.w, img.h)}
                     onerror={img.id ? `this.onerror=null;this.src='${picsum(img.seed, img.w, img.h)}'` : undefined}
                     alt={img.title} loading="lazy"
                     class="w-full object-cover transition duration-700 group-hover:scale-[1.04]" />
                <span class="chip absolute left-3 top-3 bg-ink/60 text-[10px] text-white backdrop-blur">{img.ratio}</span>
                <span class="absolute inset-x-0 bottom-0 translate-y-2 bg-gradient-to-t from-ink/85 to-transparent px-4 pb-3 pt-10 opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100">
                  <span class="block font-dev text-sm text-goldsoft">{d.dev}</span>
                  <span class="block font-display text-sm font-semibold text-white">{img.title}</span>
                </span>
              </button>
              <button data-download aria-label="Download image"
                class="absolute right-3 top-3 grid size-9 place-items-center rounded-full bg-white/90 text-ink opacity-0 shadow-soft backdrop-blur transition hover:bg-saffron hover:text-white group-hover:opacity-100">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg>
              </button>
            </figure>
          ))
        )}
      </div>
    </div>
  </section>

  <!-- ══════════ LIGHTBOX — STOCK-STYLE DOWNLOAD PANEL ══════════ -->
  <dialog id="lightbox" class="relative m-auto w-[min(94vw,900px)] rounded-3xl border border-golden/30 bg-night/95 p-3 text-cream shadow-lift">
    <form method="dialog" class="absolute right-3 top-3 z-10">
      <button class="grid size-9 place-items-center rounded-full bg-white/10 text-cream transition hover:bg-white/20" aria-label="Band karo">✕</button>
    </form>
    <figure>
      <img id="lb-img" class="max-h-[54vh] w-full rounded-2xl object-contain" alt="" />
      <figcaption class="px-2 py-3">
        <div class="flex flex-wrap items-start justify-between gap-3 pr-10">
          <span>
            <span id="lb-title" class="block font-display text-sm font-semibold"></span>
            <span id="lb-ratio" class="text-xs text-goldsoft"></span>
          </span>
          <span id="lb-status" class="chip bg-white/10 text-cream"></span>
        </div>

        <!-- state-based clear options -->
        <div id="lb-actions" class="mt-3 grid gap-2 sm:grid-cols-2"></div>

        <div class="mt-3">
          <p class="text-[10px] uppercase tracking-widest text-cream/50">Related — same deity</p>
          <div id="lb-related" class="no-scrollbar mt-2 flex gap-2 overflow-x-auto"></div>
        </div>
      </figcaption>
    </figure>
  </dialog>

  <!-- download toast -->
  <p id="dl-status" class="pointer-events-none fixed bottom-6 left-1/2 z-[95] hidden -translate-x-1/2 whitespace-nowrap rounded-full bg-ink/90 px-5 py-2.5 text-sm font-medium text-white shadow-lift backdrop-blur dark:bg-white/90 dark:text-ink"></p>

  <CTA />
</Layout>

<script is:inline>
(() => {
  const $ = (s) => document.querySelector(s);
  const $$ = (s) => document.querySelectorAll(s);
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const DATA = JSON.parse($("#gallery-data").textContent);

  /* ---------- auth token + murti credits ---------- */
  let token = "";
  try {
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (k && k.indexOf("sb-") === 0 && k.indexOf("auth-token") !== -1) { token = JSON.parse(localStorage.getItem(k)).access_token; break; }
    }
  } catch (e) {}
  let quota = null;
  const hasQuota = (cost = 0.5) => !!quota && quota.murtiUsed + cost <= quota.murtiLimit;

  /* ---------- toast ---------- */
  let toastTimer;
  function toast(msg) {
    const el = $("#dl-status");
    el.textContent = msg;
    el.classList.remove("hidden");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => el.classList.add("hidden"), 3500);
  }

  /* ---------- server se murti credits ---------- */
  async function loadQuota() {
    const chip = $("#plan-chip");
    if (!token) { chip.textContent = "🆓 Guest mode — 0.6K watermark free • login karo"; return; }
    try {
      const r = await fetch("/api/credits", { headers: { Authorization: "Bearer " + token } });
      if (r.ok) {
        quota = await r.json();
        const left = quota.murtiLimit - quota.murtiUsed;
        chip.textContent = `🪔 ${String(quota.plan).toUpperCase()} — ${Math.floor(left / 0.3)} × 1K ya ${Math.floor(left / 0.5)} × Full baaki (${left.toFixed(1)}⚡)`;
        chip.className = left >= 0.3 ? "chip bg-golden/20 text-sandal dark:text-golden" : "chip bg-red-500/15 text-red-500";
      }
    } catch (e) {}
  }
  loadQuota();

  /* ---------- category filtering ---------- */
  function setCat(id) {
    $$("#cat-bar [data-cat]").forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.cat === id)));
    let n = 0, name = "";
    $$("[data-deity]").forEach((el) => {
      const show = id === "all" || el.dataset.deity === id;
      el.classList.toggle("hidden", !show);
      if (show) {
        n++;
        if (!reduced) el.animate([{ opacity: 0, transform: "scale(0.97)" }, { opacity: 1, transform: "none" }], { duration: 320, easing: "ease-out" });
      }
    });
    if (id !== "all") name = $(`#cat-bar [data-cat="${id}"]`)?.textContent.trim() || "";
    $("#gallery-count").textContent = id === "all"
      ? `🪔 ${n} divine frames — sab deities, har ratio mein`
      : `🪔 ${n} frames — ${name} darshan`;
  }
  $$("#cat-bar [data-cat]").forEach((c) => c.addEventListener("click", () => setCat(c.dataset.cat)));
  setCat("all");

  /* ---------- url helpers (.png murti files) ---------- */
  function srcFor(item, w) {
    if (item.id && String(item.id) !== String(item.seed)) return `/murti/${item.deityId || item.cat}/preview/${item.id}.png`;
    return `https://picsum.photos/seed/${item.seed}/${w}/${Math.round((w * item.h) / item.w)}`;
  }
  async function fetchBlob(item, w) {
    const primary = srcFor(item, w);
    let res = await fetch(primary).catch(() => null);
    if (!res || !res.ok) res = await fetch(`https://picsum.photos/seed/${item.seed}/${w}/${Math.round((w * item.h) / item.w)}`);
    return res.blob();
  }

  /* ---------- canvas helpers ---------- */
  function drawWatermark(ctx, w, h) {
    ctx.save();
    const size = Math.max(16, Math.floor(w / 20));
    ctx.font = `600 ${size}px Poppins, sans-serif`;
    ctx.fillStyle = "#ffffff";
    ctx.globalAlpha = 0.3;
    ctx.translate(w / 2, h / 2);
    ctx.rotate(-Math.PI / 7);
    const text = "BhaktiMedia.in  ॐ";
    for (let y = -h; y < h; y += size * 6)
      for (let x = -w; x < w; x += size * 10)
        ctx.fillText(text, x, y);
    ctx.restore();
  }
  function drawScaled(i, maxW) {
    let w = i.width, h = i.height;
    if (w > maxW) { const s = maxW / w; w = Math.round(w * s); h = Math.round(h * s); }
    const c = document.createElement("canvas");
    c.width = w; c.height = h;
    c.getContext("2d").drawImage(i, 0, 0, w, h);
    return c;
  }
  function loadImg(blob) {
    return new Promise((res, rej) => {
      const url = URL.createObjectURL(blob);
      const i = new Image();
      i.onload = () => res({ i, url });
      i.onerror = rej;
      i.src = url;
    });
  }

  /* ---------- TIER FREE: 0.6K watermark (guest + credits khatam) ---------- */
  async function watermarkPreview(item) {
    toast("⬇️ Free preview (0.6K watermark) download ho raha hai...");
    try {
      const blob = await fetchBlob(item, 640);
      const { i, url: objUrl } = await loadImg(blob);
      const canvas = drawScaled(i, 640);
      drawWatermark(canvas.getContext("2d"), canvas.width, canvas.height);
      canvas.toBlob((b) => {
        const a = document.createElement("a");
        a.href = URL.createObjectURL(b);
        a.download = `bhaktimedia-${item.id || item.seed}-preview-640px-watermark.jpg`;
        a.click();
        URL.revokeObjectURL(a.href);
        URL.revokeObjectURL(objUrl);
        toast(token ? "✅ Free preview mili — clean versions ke liye upgrade karo ⭐" : "✅ Free preview mili — login karo: 1K clean 0.3⚡ se 🪔");
      }, "image/jpeg", 0.7);
    } catch {
      toast("⚠️ Download failed — dobara try karo");
    }
  }

  /* ---------- TIER 1K CLEAN: 0.3⚡ ---------- */
  async function clean1k(item) {
    toast("⚡ 1K clean download (0.3⚡)...");
    try {
      const r = await fetch("/api/murti-download", {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
        body: JSON.stringify({ id: item.id || item.seed, cat: item.deityId || item.cat || "ganesh", kind: "1k" }),
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || "Fail");
      const res = await fetch(d.url);
      if (!res.ok) throw new Error("File nahi mili");
      const blob = await res.blob();
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `bhaktimedia-${item.id || item.seed}-1k-clean.png`;
      a.click();
      URL.revokeObjectURL(a.href);
      toast(`✅ 1K clean download! ${d.left.toFixed(1)}⚡ baaki`);
      loadQuota();
      renderActions();
    } catch (e) { toast("❌ " + e.message); }
  }

  /* ---------- TIER FULL HD: 0.5⚡ ---------- */
  async function download(item) {
    if (!hasQuota(0.5)) { toast("❌ Credits khatam — pricing par ja rahe hain ⭐"); setTimeout(() => (location.href = "/pricing"), 1200); return; }
    toast("⚡ Full HD clean download (0.5⚡)...");
    try {
      const r = await fetch("/api/murti-download", {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
        body: JSON.stringify({ id: item.id || item.seed, cat: item.deityId || item.cat || "ganesh", kind: "full" }),
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || "Download fail");
      let srcUrl = d.url || "";
      const probe = await fetch(srcUrl, { method: "HEAD" }).catch(() => null);
      if (!probe || !probe.ok) srcUrl = `https://picsum.photos/seed/${item.seed}/1600/${Math.round((1600 * item.h) / item.w)}`;
      const res = await fetch(srcUrl);
      const blob = await res.blob();
      const { i, url: objUrl } = await loadImg(blob);
      const canvas = document.createElement("canvas");
      canvas.width = i.width; canvas.height = i.height;
      canvas.getContext("2d").drawImage(i, 0, 0);
      canvas.toBlob((b) => {
        const a = document.createElement("a");
        a.href = URL.createObjectURL(b);
        a.download = `bhaktimedia-${item.id || item.seed}-fullhd.png`;
        a.click();
        URL.revokeObjectURL(a.href);
        URL.revokeObjectURL(objUrl);
        toast(`✅ Full HD clean download! ${d.left.toFixed(1)}⚡ baaki`);
      }, "image/png");
      loadQuota();
      renderActions();
    } catch (e) { toast("❌ " + e.message); }
  }

  /* ---------- grid download button (smart) ---------- */
  $$("[data-download]").forEach((btn) =>
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const f = btn.closest("figure");
      const item = { id: f.dataset.id, seed: f.dataset.seed, w: f.dataset.w, h: f.dataset.h, deityId: f.dataset.deity };
      if (!token) return watermarkPreview(item);
      if (!hasQuota(0.5)) { toast("❌ Credits khatam — pricing par ja rahe hain ⭐"); setTimeout(() => (location.href = "/pricing"), 1200); return; }
      download(item);
    })
  );

  /* ---------- LIGHTBOX: state-based action panel ---------- */
  let current = null;

  function actionBtn(cls, title, sub, fn) {
    const b = document.createElement("button");
    b.className = cls;
    b.innerHTML = `<span class="block text-xs font-bold">${title}</span><span class="mt-0.5 block text-[10px] font-normal opacity-75">${sub}</span>`;
    b.addEventListener("click", fn);
    return b;
  }

  function renderActions() {
    const box = $("#lb-actions");
    const status = $("#lb-status");
    box.innerHTML = "";
    if (!token) {
      status.textContent = "🔒 Guest mode";
      status.className = "chip bg-white/10 text-cream";
      box.appendChild(actionBtn("btn btn-glass w-full !py-2.5 !text-cream", "⬇ Free Preview", "640px • watermark • 0⚡", () => watermarkPreview(current)));
      box.appendChild(actionBtn("btn btn-primary w-full !py-2.5", "🔑 Login / Signup", "1K clean 0.3⚡ • Full HD 0.5⚡", () => (location.href = "/login")));
    } else if (hasQuota(0.3)) {
      const left = (quota.murtiLimit - quota.murtiUsed).toFixed(1);
      status.textContent = `⚡ ${left} murti credits baaki`;
      status.className = "chip bg-golden/20 text-golden";
      box.appendChild(actionBtn("btn btn-glass w-full !py-2.5 !text-cream", "⬇ 1K Clean — 0.3⚡", "1024px • bina watermark", () => clean1k(current)));
      box.appendChild(actionBtn("btn btn-primary w-full !py-2.5", "⬇ Full HD — 0.5⚡", "original quality • bina watermark", () => download(current)));
    } else {
      status.textContent = "❌ Murti credits khatam";
      status.className = "chip bg-red-500/15 text-red-400";
      box.appendChild(actionBtn("btn btn-glass w-full !py-2.5 !text-cream", "⬇ Free Preview", "640px • watermark • 0⚡", () => watermarkPreview(current)));
      box.appendChild(actionBtn("btn btn-gold w-full !py-2.5", "⭐ Upgrade Plan", "pricing dekho — credits lo", () => (location.href = "/pricing")));
    }
  }

  async function openLightbox(item) {
    current = item;
    $("#lb-title").textContent = item.title;
    $("#lb-ratio").textContent = `Ratio ${item.ratio} • ${item.deityName}`;
    renderActions();
    renderRelated();
    $("#lightbox").showModal();

    // display preview = watermarked comp (chori-proof)
    const lbImg = $("#lb-img");
    lbImg.classList.add("opacity-40");
    const maxW = hasQuota(0.3) ? 1200 : 800;
    try {
      const blob = await fetchBlob(item, maxW);
      const { i, url } = await loadImg(blob);
      const canvas = drawScaled(i, maxW);
      drawWatermark(canvas.getContext("2d"), canvas.width, canvas.height);
      const old = lbImg.src;
      lbImg.src = canvas.toDataURL("image/jpeg", hasQuota(0.3) ? 0.9 : 0.75);
      if (old.startsWith("blob:")) URL.revokeObjectURL(old);
      URL.revokeObjectURL(url);
    } catch {
      lbImg.src = srcFor(item, maxW);
    }
    lbImg.alt = item.title;
    lbImg.classList.remove("opacity-40");
  }

  function renderRelated() {
    const deity = DATA.find((d) => d.id === current.deityId);
    if (!deity) return;
    $("#lb-related").innerHTML = deity.images
      .filter((i) => (i.id || i.seed) !== (current.id || current.seed))
      .map((i) => `
        <button data-rel="${i.id || i.seed}" class="shrink-0 overflow-hidden rounded-xl border border-white/10 opacity-70 transition hover:opacity-100 hover:ring-2 hover:ring-golden">
          <img src="${i.id ? `/murti/${deity.id}/preview/${i.id}.png` : `https://picsum.photos/seed/${i.seed}/120/120`}"
               onerror="this.onerror=null;this.src='https://picsum.photos/seed/${i.seed}/120/120'"
               alt="${i.title}" class="size-16 object-cover" />
        </button>`).join("");
    $$("#lb-related [data-rel]").forEach((b) =>
      b.addEventListener("click", () => {
        const img = deity.images.find((i) => (i.id || i.seed) === b.dataset.rel);
        openLightbox({ ...img, id: img.id || img.seed, deityId: deity.id, deityName: deity.name });
      })
    );
  }

  $$("[data-lightbox]").forEach((btn) =>
    btn.addEventListener("click", () => {
      const f = btn.closest("figure");
      const deity = DATA.find((d) => d.id === f.dataset.deity);
      openLightbox({
        id: f.dataset.id, seed: f.dataset.seed, w: f.dataset.w, h: f.dataset.h,
        ratio: f.dataset.ratio, title: f.dataset.title,
        deityId: deity.id, deityName: deity.name,
      });
    })
  );

  $("#lightbox").addEventListener("click", (e) => { if (e.target === $("#lightbox")) $("#lightbox").close(); });

  /* ---------- right-click protection (SAB users) ---------- */
  ["#gallery-grid", "#lightbox"].forEach((sel) => {
    $(sel).addEventListener("contextmenu", (e) => {
      e.preventDefault();
      toast("🙏 Right-click save disabled — download options neeche buttons mein hain");
    });
  });
})();
</script>
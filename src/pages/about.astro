---
import { Image } from "astro:assets";
import { HeartHandshake, Gem, HandHeart, Sparkles } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import CTA from "../components/CTA.astro";
import { picsum } from "../lib/utils";

const values = [
  { Icon: HeartHandshake, title: "Bhakti First", desc: "Every pixel begins with reverence. If it wouldn't belong on a temple wall, it doesn't ship." },
  { Icon: Gem, title: "Craft & Detail", desc: "Classical composition, precise Devanagari typography, colour rooted in tradition." },
  { Icon: HandHeart, title: "Seva Mindset", desc: "Village mandirs get seva discounts, and every project is treated as an offering." },
  { Icon: Sparkles, title: "Modern Tools", desc: "Astro-speed websites, custom AI models and cinematic pipelines — devotion deserves the best tech." },
];
const timeline = [
  { year: "2021", text: "Started designing festival posters for a local mandir in Akurdi." },
  { year: "2022", text: "First bhakti reel crossed 100K views; temple clients followed." },
  { year: "2023", text: "50+ temples onboarded; YouTube management wing launched." },
  { year: "2024", text: "AI Devotional Studio opened with ethics-first pipelines." },
  { year: "2025", text: "Crossed millions of combined views across client channels." },
  { year: "2026", text: "A full-service digital devotion studio — posters to platforms." },
];
---
<Layout title="About" description="BhaktiMedia is India's devotional media studio — blending temple tradition with modern design, video and ethical AI.">
  <PageHeader eyebrow="Our Story" title="Digital Seva, Rooted in Tradition" dev="? ??????? ??????????? ?"
    description="BhaktiMedia began with one poster for a neighbourhood mandir. Today we are a full devotional media studio serving temples, trusts and creators across India." />

  <section class="section !pt-10">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2">
      <div data-reveal class="relative mx-auto w-full max-w-md">
        <div class="absolute -inset-6 rounded-[3rem] bg-gradient-to-br from-saffron/20 to-golden/10 blur-2xl" aria-hidden="true"></div>
        <figure class="relative overflow-hidden rounded-b-3xl rounded-t-[12rem] border border-golden/40 bg-white p-3 shadow-lift dark:border-golden/25 dark:bg-night-soft">
          <div class="overflow-hidden rounded-b-2xl rounded-t-[11rem]">
            <Image src={picsum("bhaktimedia-studio-desk", 900, 1100)} width={900} height={1100} alt="The BhaktiMedia studio" loading="lazy" class="aspect-[4/5] w-full object-cover" />
          </div>
        </figure>
      </div>
      <div data-reveal style="--rd:150ms">
        <p class="eyebrow">Why we exist</p>
        <h2 class="mt-4 font-display text-3xl font-bold tracking-tight sm:text-4xl">
          Faith deserves <span class="text-gradient">world-class design</span>
        </h2>
        <p class="mt-5 leading-relaxed text-sandal-deep/80 dark:text-cream/70">
          Most spiritual content online is rushed and forgettable. We believe aarti livestreams deserve cinema-grade sound, festival posters deserve gallery-grade composition, and every mandir — big or small — deserves a digital presence that honours its heritage.
        </p>
        <blockquote class="mt-6 rounded-r-2xl border-l-4 border-golden bg-golden/10 p-5 font-dev italic text-sandal dark:text-golden/90">
          “?? ?? ??????, ?? ?? ??????” — where there is devotion, there is strength.
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section !pt-4">
    <div class="container-x">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v, i) => (
          <article data-reveal style={`--rd:${i * 90}ms`} class="card group p-7 transition duration-300 hover:-translate-y-1.5 hover:shadow-glow">
            <span class="grid size-12 place-items-center rounded-xl bg-gradient-to-br from-saffron to-golden text-white shadow-gold transition group-hover:rotate-6">
              <v.Icon class="size-5" />
            </span>
            <h3 class="mt-5 font-display text-lg font-semibold">{v.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-sandal-deep/75 dark:text-cream/65">{v.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section !pt-4">
    <div class="container-x max-w-3xl">
      <h2 class="font-display text-3xl font-bold">The journey so far</h2>
      <ol class="mt-10 space-y-0 border-l-2 border-golden/40 pl-8">
        {timeline.map((t, i) => (
          <li data-reveal style={`--rd:${i * 80}ms`} class="relative pb-10 last:pb-0">
            <span class="absolute -left-[41px] grid size-5 place-items-center rounded-full bg-gradient-to-br from-saffron to-golden ring-4 ring-temple dark:ring-night" aria-hidden="true"></span>
            <p class="font-dev text-lg font-bold text-saffron">{t.year}</p>
            <p class="mt-1 text-sandal-deep/80 dark:text-cream/70">{t.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CTA />
</Layout>

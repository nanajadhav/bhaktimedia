---
import Layout from "../layouts/Layout.astro";
import Diya from "../components/Diya.astro";
---
<Layout title="Page Not Found">
  <section class="grid min-h-svh place-items-center px-6 pt-24 text-center">
    <div class="animate-rise">
      <Diya id="diya-404" class="mx-auto w-28" />
      <p class="mt-6 font-dev text-lg text-sandal dark:text-golden/80">? ? ??????? ??????? ??????? ?</p>
      <h1 class="mt-3 font-display text-5xl font-bold">404</h1>
      <p class="mx-auto mt-3 max-w-sm text-sandal-deep/75 dark:text-cream/65">
        This path leads to stillness. Let's walk back to the temple together.
      </p>
      <a href="/" class="btn btn-primary mt-8">Return Home ??</a>
    </div>
  </section>
</Layout>

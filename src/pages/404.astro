---
import Layout from "../layouts/Layout.astro";
import CTA from "../components/CTA.astro";
import { site } from "../data/site";

const links = [
  { icon: "🏠", title: "Home", desc: "Back to the temple entrance", href: "/" },
  { icon: "⭐", title: "Pricing", desc: "See our plans and packs", href: "/pricing" },
  { icon: "🖼️", title: "Gallery", desc: "Divine frames of every deity", href: "/gallery" },
  { icon: "🎨", title: "Studio", desc: "Create your own AI murti", href: "/studio" },
];
---
<Layout title="Page Not Found" description="The page you seek has taken sannyas — return to the temple path.">
<div class="container-x px-4 pb-20 pt-32 sm:px-6">
  <div class="mx-auto max-w-3xl text-center">
    <p class="eyebrow">404</p>
    <p class="mt-2 font-dev text-8xl text-golden/40 sm:text-9xl">॥ ॐ ॥</p>
    <h1 class="mt-4 font-display text-4xl font-bold tracking-tight sm:text-5xl">The Path Was <span class="text-gradient">Lost</span></h1>
    <p class="mt-3 font-dev text-sm text-golden/80">॥ मार्ग भ्रष्टः ॥</p>
    <p class="mt-4 text-base leading-relaxed text-sandal-deep/75 dark:text-cream/65">
      The page you seek has taken sannyas — it no longer lives here.<br class="hidden sm:block" />
      Let us guide you back to the temple path.
    </p>

    <!-- Search bar -->
    <form action="https://www.google.com/search" method="GET" target="_blank" rel="noopener" class="mx-auto mt-8 flex max-w-md gap-2">
      <input type="hidden" name="q" value={`site:${site.url.replace(/^https?:\/\//, "")}`} />
      <label for="site-search" class="sr-only">Search site</label>
      <input id="site-search" name="q" type="text" required placeholder="Search bhaktimedia.in..."
             class="input flex-1 !rounded-full !border !border-sandal/20 !bg-white/60 focus:!border-saffron dark:!border-white/10 dark:!bg-white/5" />
      <button type="submit" class="btn btn-primary shrink-0 !rounded-full !px-5">Search</button>
    </form>
  </div>

  <!-- Quick links bento -->
  <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {links.map((l, i) => (
      <a href={l.href} data-reveal style={`--rd:${i * 70}ms`}
         class="group relative overflow-hidden rounded-2xl border border-golden/25 bg-white/80 p-6 text-left shadow-soft backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-saffron/40 hover:shadow-lift dark:bg-night-soft/80">
        <span class="grid size-12 place-items-center rounded-xl bg-gradient-to-br from-saffron to-golden text-xl text-white shadow-gold transition group-hover:rotate-3 group-hover:scale-110">{l.icon}</span>
        <h3 class="mt-4 font-display text-lg font-bold">{l.title}</h3>
        <p class="mt-1 text-sm text-sandal-deep/70 dark:text-cream/65">{l.desc}</p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-saffron transition group-hover:gap-2">Visit <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>

  <!-- Quote strip -->
  <div class="mx-auto mt-12 max-w-2xl text-center">
    <p class="font-dev text-lg text-golden/80">॥ सर्वं सुखमयं भवतु ॥</p>
    <p class="mt-2 text-sm italic text-sandal-deep/60 dark:text-cream/50">"May all find happiness" — even lost visitors.</p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="btn btn-primary">Return Home</a>
      <a href="/contact" class="btn btn-outline">Contact Support</a>
    </div>
  </div>
</div>
<CTA />
</Layout>
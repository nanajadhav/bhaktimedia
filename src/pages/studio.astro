---
import Layout from "../layouts/Layout.astro";
---
<Layout title="AI Studio" description="BhaktiMedia AI Studio — image, poster, voice, video.">

<style is:global>
  html, body { overflow: hidden !important; }
</style>

<style>
  .studio-app { position: fixed; inset: 5.5rem 0.75rem 4.25rem 0.75rem; }
  @media (min-width: 1024px) { .studio-app { inset: 5.5rem 1rem 0.75rem 1rem; } }
  .studio-inner { display: flex; gap: 1.25rem; height: 100%; max-width: 1600px; margin: 0 auto; }
  #settings-col { width: 300px; flex-shrink: 0; overflow-y: auto; }
  #content-scroll { flex: 1; overflow-y: auto; min-height: 0; }
  #settings-col::-webkit-scrollbar, #content-scroll::-webkit-scrollbar { width: 6px; }
  #settings-col::-webkit-scrollbar-thumb, #content-scroll::-webkit-scrollbar-thumb { background: rgba(0,0,0,.15); border-radius: 99px; }
  @media (max-width: 1023px) {
    #settings-col { position: fixed; left: 0; right: 0; bottom: 3.5rem; max-height: 70vh; width: 100%;
      transform: translateY(110%); transition: transform .3s ease; z-index: 70;
      border-radius: 1.5rem 1.5rem 0 0; box-shadow: 0 -12px 40px rgba(0,0,0,.25); }
    body.sheet-open #settings-col { transform: translateY(0); }
    #btn-sheet { display: inline-flex; }
  }
  @media (min-width: 1024px) { #btn-sheet { display: none; } }
  #loader-diya { display: inline-block; animation: flicker 1.2s ease-in-out infinite; }
  @keyframes flicker {
    0%, 100% { transform: scale(1) rotate(-2deg); filter: drop-shadow(0 0 6px rgba(255,170,60,.5)); }
    50% { transform: scale(1.12) rotate(2deg); filter: drop-shadow(0 0 22px rgba(255,200,80,.95)); }
  }
</style>

<div class="studio-app">
<div class="studio-inner">

  <!-- ══════════ SETTINGS SIDEBAR ══════════ -->
  <aside id="settings-col" class="border border-sandal/10 bg-white p-4 dark:border-white/10 dark:bg-night">
    <button id="btn-new" class="btn btn-primary w-full justify-center !py-2.5">＋ New</button>

    <nav class="mt-4 hidden space-y-1 lg:block">
      <button data-view="home" class="snav flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-sandal-deep/80 transition hover:bg-saffron/10 dark:text-cream/70">🏠 Home</button>
      <button data-view="image" class="snav flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-sandal-deep/80 transition hover:bg-saffron/10 dark:text-cream/70">🖼️ Image</button>
      <button data-view="poster" class="snav flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-sandal-deep/80 transition hover:bg-saffron/10 dark:text-cream/70">🎨 Poster</button>
      <button data-view="voice" class="snav flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-sandal-deep/80 transition hover:bg-saffron/10 dark:text-cream/70">🎙️ Voice</button>
      <button data-view="video" class="snav flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-sandal-deep/80 transition hover:bg-saffron/10 dark:text-cream/70">🎬 Video</button>
    </nav>

    <!-- IMAGE SETTINGS -->
    <div id="set-image" class="mt-5 hidden">
      <p class="text-[11px] font-bold uppercase tracking-widest text-sandal/50 dark:text-cream/40">General settings</p>
      <label class="mt-3 block text-sm font-semibold">Aspect ratio
        <select id="img-ratio" class="input mt-1.5"><option>Auto</option><option>1:1</option><option>4:5</option><option>16:9</option><option>9:16</option></select>
      </label>
      <label class="mt-3 block text-sm font-semibold">Resolution
        <select id="img-res" class="input mt-1.5"><option>1K</option><option>2K</option></select>
      </label>
      <label class="mt-3 block text-sm font-semibold">Style
        <select id="img-style" class="input mt-1.5"><option>Traditional</option><option>Cinematic</option><option>Cosmic</option><option>Photorealistic</option></select>
      </label>
      <p class="mt-4 text-sm font-semibold">Reference images (<span id="ref-count">0</span>/2)</p>
      <div id="ref-thumbs" class="mt-2 flex gap-2"></div>
      <input id="ref-input" type="file" accept="image/*" class="hidden" />
      <p class="mt-1 text-[11px] text-sandal/50 dark:text-cream/40">Reference = us photo par transformation • bina reference = nayi image</p>
    </div>

    <!-- POSTER SETTINGS -->
    <div id="set-poster" class="mt-5 hidden">
      <p class="text-[11px] font-bold uppercase tracking-widest text-sandal/50 dark:text-cream/40">Poster settings</p>
      <label class="mt-3 block text-sm font-semibold">Design
        <select id="p-tpl" class="input mt-1.5"></select>
      </label>
      <label class="mt-3 block text-sm font-semibold">Aspect ratio
        <select id="p-ratio" class="input mt-1.5"><option>4:5</option><option>1:1</option><option>9:16</option></select>
      </label>
      <p class="mt-4 text-sm font-semibold">User photo (zaroori)</p>
      <div id="p-slot-wrap" class="mt-2"></div>
      <input id="p-photo" type="file" accept="image/*" class="hidden" />
      <label class="mt-4 block text-sm font-semibold">शुभेच्छुक Name
        <input id="p-name" class="input mt-1.5" placeholder="श्री. ..." />
      </label>
      <label class="mt-3 block text-sm font-semibold">Language
        <select id="p-lang" class="input mt-1.5"><option value="mr">मराठी</option><option value="en">English</option></select>
      </label>
      <p class="mt-4 text-sm font-semibold">Custom message (optional)</p>
      <div id="p-sugg" class="mt-2 flex flex-wrap gap-2"></div>
      <textarea id="p-msg" rows="2" class="input mt-2 resize-none" placeholder="Apni wish line likho..."></textarea>
    </div>

    <!-- HISTORY -->
    <div class="mt-6 border-t border-sandal/10 pt-4 dark:border-white/10">
      <div class="flex items-center justify-between">
        <p class="text-[11px] font-bold uppercase tracking-widest text-sandal/50 dark:text-cream/40">History</p>
        <button id="clear-history" class="text-xs text-saffron hover:underline">Clear</button>
      </div>
      <div id="history" class="mt-3 grid grid-cols-4 gap-2"></div>
    </div>
  </aside>

  <!-- ══════════ MAIN ══════════ -->
  <main class="flex min-w-0 flex-1 flex-col">

    <div class="flex items-center justify-between gap-3 py-2">
      <div class="min-w-0">
        <h1 id="view-title" class="truncate font-display text-xl font-bold sm:text-2xl">Recommended for you</h1>
        <p class="truncate text-xs text-sandal/60 dark:text-cream/50">BhaktiMedia AI Engine ⚡ — divine creativity, powered by AI</p>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <span class="chip bg-golden/15 text-golden">⚡ <span id="credits-count">...</span>/<span id="credits-limit">...</span></span>
        <button id="btn-sheet" class="chip">⚙️</button>
      </div>
    </div>

    <div id="content-scroll" class="pr-1">

      <!-- HOME -->
      <section id="view-home" class="pb-4">
        <div class="grid gap-5 sm:grid-cols-2">
          <button data-view="image" class="group relative overflow-hidden rounded-2xl border border-sandal/10 text-left shadow-soft dark:border-white/10">
            <img src="https://picsum.photos/seed/cosmic-mahadev-ai/640/420" alt="" class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-105" />
            <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/85 to-transparent px-4 pb-3 pt-10 font-display text-lg font-bold text-white">🖼️ Generate Image</span>
          </button>
          <button data-view="poster" class="group relative overflow-hidden rounded-2xl border border-sandal/10 text-left shadow-soft dark:border-white/10">
            <img src="https://picsum.photos/seed/ganesh-utsav-poster/640/420" alt="" class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-105" />
            <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/85 to-transparent px-4 pb-3 pt-10 font-display text-lg font-bold text-white">🎨 Generate Poster</span>
          </button>
          <button data-view="voice" class="group relative overflow-hidden rounded-2xl border border-sandal/10 text-left shadow-soft dark:border-white/10">
            <img src="https://picsum.photos/seed/voice-studio-wave/640/420" alt="" class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-105" />
            <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/85 to-transparent px-4 pb-3 pt-10 font-display text-lg font-bold text-white">🎙️ Generate Voice</span>
          </button>
          <button data-view="video" class="group relative overflow-hidden rounded-2xl border border-sandal/10 text-left shadow-soft dark:border-white/10">
            <img src="https://picsum.photos/seed/aarti-cinematic-reel/640/420" alt="" class="aspect-[16/10] w-full object-cover opacity-60 transition duration-500 group-hover:scale-105" />
            <span class="absolute right-3 top-3 rounded-full bg-golden px-3 py-1 text-xs font-bold text-ink">Jald hi</span>
            <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/85 to-transparent px-4 pb-3 pt-10 font-display text-lg font-bold text-white">🎬 Generate Video</span>
          </button>
        </div>
      </section>

      <!-- IMAGE -->
      <section id="view-image" class="hidden pb-4">
        <div id="img-empty" class="flex h-full min-h-[50vh] flex-col items-center justify-center text-center">
          <span class="grid size-20 place-items-center rounded-3xl bg-gradient-to-br from-saffron/20 to-golden/20 text-4xl">🖼️</span>
          <h2 class="mt-5 font-display text-2xl font-bold">Start generating images</h2>
          <p class="mt-2 max-w-sm text-sm text-sandal/60 dark:text-cream/50">Neeche prompt mein apni kalpana likho — BhaktiMedia AI Engine usey saakar karega.</p>
        </div>
        <div id="img-results" class="hidden grid grid-cols-2 gap-4 xl:grid-cols-3"></div>
      </section>

      <!-- POSTER -->
      <section id="view-poster" class="hidden pb-4">
        <div id="p-empty" class="flex h-full min-h-[50vh] flex-col items-center justify-center text-center">
          <span class="grid size-20 place-items-center rounded-3xl bg-gradient-to-br from-saffron/20 to-golden/20 text-4xl">🎨</span>
          <h2 class="mt-5 font-display text-2xl font-bold">Start creating posters</h2>
          <p class="mt-2 max-w-sm text-sm text-sandal/60 dark:text-cream/50">Design chuno, photo lagao, naam likho — festival poster ready!</p>
        </div>
        <div id="p-result" class="hidden text-center">
          <img id="p-img" alt="Poster" class="mx-auto max-h-[58vh] rounded-2xl shadow-lift" />
          <div class="mt-4 flex flex-wrap justify-center gap-3 pb-2">
            <a id="p-download" class="btn btn-primary" download>⬇️ Download</a>
            <button id="share-wa" class="btn btn-ghost">🟢 WhatsApp</button>
            <button id="share-fb" class="btn btn-ghost">🔵 Facebook</button>
            <button id="share-ig" class="btn btn-ghost">📸 Instagram</button>
          </div>
        </div>
      </section>

      <!-- VOICE -->
      <section id="view-voice" class="hidden pb-4">
        <div class="rounded-2xl border border-golden/30 bg-white p-10 text-center shadow-lift dark:bg-night">
          <span class="text-5xl">🎙️</span>
          <h2 class="mt-4 font-display text-xl font-bold">Voice Studio</h2>
          <p class="mt-2 text-sm text-sandal/60 dark:text-cream/60">TTS / STT / Cloning ke liye abhi purana studio use karo:</p>
          <a href="/ai-services?studio=voice" class="btn btn-primary mt-5">Purana Voice Studio Kholo</a>
        </div>
      </section>

      <!-- VIDEO -->
      <section id="view-video" class="hidden pb-4">
        <div class="rounded-2xl border border-golden/30 bg-white p-10 text-center shadow-lift dark:bg-night">
          <span class="text-5xl">🎬</span>
          <h2 class="mt-4 font-display text-xl font-bold">Video Generation — Jald aa raha hai</h2>
          <p class="mt-2 text-sm text-sandal/60 dark:text-cream/60">Divine reels & cinematic videos — Phase-2 mein.</p>
        </div>
      </section>
    </div>

    <!-- PROMPT BAR -->
    <div id="promptbar" class="pt-2 pb-1">
      <div class="rounded-2xl border border-sandal/10 bg-white p-3 shadow-lift dark:border-white/10 dark:bg-night">
        <textarea id="prompt" rows="2" placeholder="Describe the image you want to generate..."
          class="w-full resize-none bg-transparent px-2 py-1 text-base focus:outline-none"></textarea>
        <div class="mt-1 flex items-center justify-between px-1">
          <span class="text-[11px] font-semibold text-sandal/50 dark:text-cream/40">BhaktiMedia AI Engine ⚡</span>
          <button id="btn-send" aria-label="Generate"
            class="grid size-10 place-items-center rounded-full bg-gradient-to-br from-saffron to-golden text-white shadow-glow transition hover:scale-105 disabled:opacity-40">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
          </button>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- ══════════ LOADING OVERLAY ══════════ -->
<div id="loader" class="pointer-events-none absolute inset-0 z-40 hidden items-center justify-center bg-cream/70 backdrop-blur-sm dark:bg-night/70">
  <div class="flex flex-col items-center rounded-3xl border border-golden/40 bg-white/95 px-10 py-8 shadow-lift dark:bg-night/95">
    <span id="loader-diya" class="text-6xl">🪔</span>
    <p id="loader-text" class="mt-4 font-display text-lg font-bold">Generate ho raha hai...</p>
    <p class="mt-1 text-xs text-sandal/60 dark:text-cream/50">BhaktiMedia AI Engine ⚡</p>
    <div class="mt-5 h-2 w-56 overflow-hidden rounded-full bg-sandal/15 dark:bg-white/10">
      <div id="loader-bar" class="h-full w-0 rounded-full bg-gradient-to-r from-saffron to-golden transition-all duration-300"></div>
    </div>
    <p id="loader-pct" class="mt-2 text-sm font-bold text-saffron">0%</p>
  </div>
</div>

<!-- MOBILE BOTTOM NAV -->
<nav id="bottom-nav" class="fixed inset-x-0 bottom-0 z-50 border-t border-sandal/10 bg-white/95 backdrop-blur-xl dark:border-white/10 dark:bg-night/95 lg:hidden">
  <div class="grid grid-cols-5">
    <button data-view="home" class="bnav flex flex-col items-center gap-0.5 py-2.5 text-[10px] font-semibold text-sandal-deep/70 dark:text-cream/60"><span class="text-lg">🏠</span>Home</button>
    <button data-view="image" class="bnav flex flex-col items-center gap-0.5 py-2.5 text-[10px] font-semibold text-sandal-deep/70 dark:text-cream/60"><span class="text-lg">🖼️</span>Image</button>
    <button data-view="poster" class="bnav flex flex-col items-center gap-0.5 py-2.5 text-[10px] font-semibold text-sandal-deep/70 dark:text-cream/60"><span class="text-lg">🎨</span>Poster</button>
    <button data-view="voice" class="bnav flex flex-col items-center gap-0.5 py-2.5 text-[10px] font-semibold text-sandal-deep/70 dark:text-cream/60"><span class="text-lg">🎙️</span>Voice</button>
    <button data-view="video" class="bnav flex flex-col items-center gap-0.5 py-2.5 text-[10px] font-semibold text-sandal-deep/70 dark:text-cream/60"><span class="text-lg">🎬</span>Video</button>
  </div>
</nav>
</div>

<script is:inline>
(() => {
  const $ = (s) => document.querySelector(s);
  const $$ = (s) => document.querySelectorAll(s);
  const isLocal = location.hostname === "localhost" || location.hostname === "127.0.0.1";
  const API = isLocal ? "http://localhost:3002/api/generate-image" : "/api/generate-image";
  const state = { view: "home", refs: [], photo: null };

  /* ---------- session ---------- */
  function getSession() {
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (k && k.indexOf("sb-") === 0 && k.indexOf("auth-token") !== -1) {
        try { return JSON.parse(localStorage.getItem(k)); } catch { return null; }
      }
    }
    return null;
  }
  const sess = getSession();
  const token = sess?.access_token || null;
  if (sess?.user) {
    const nm = sess.user.user_metadata?.name || sess.user.email || "";
    if (nm) $("#p-name").value = nm;
  }

  /* ---------- credits ---------- */
  async function loadCredits() {
    if (isLocal) { $("#credits-count").textContent = "DEV"; $("#credits-limit").textContent = "∞"; return; }
    if (!token) return;
    try {
      const r = await fetch("https://sbzlypodjpqoukhzxhfo.supabase.co/rest/v1/rpc/get_credits", {
        method: "POST",
        headers: { "Content-Type": "application/json", apikey: "sb_publishable_m3drS7J8YIwutJQ9piiGJQ_sFaPj9js", Authorization: `Bearer ${token}` },
      });
      if (r.ok) { const d = await r.json(); $("#credits-count").textContent = d.used; $("#credits-limit").textContent = d.limit; }
    } catch {}
  }
  loadCredits();

  /* ---------- loading progress ---------- */
  let progTimer = null, progVal = 0;
  function startProgress(label) {
    progVal = 0;
    $("#loader-text").textContent = label;
    $("#loader-pct").textContent = "0%";
    $("#loader-bar").style.width = "0%";
    $("#loader").classList.remove("hidden");
    $("#loader").classList.add("flex");
    clearInterval(progTimer);
    progTimer = setInterval(() => {
      if (progVal < 90) {
        progVal += Math.random() * 4 + 1;
        if (progVal > 90) progVal = 90;
        $("#loader-bar").style.width = progVal + "%";
        $("#loader-pct").textContent = Math.floor(progVal) + "%";
      }
    }, 500);
  }
  function stopProgress() {
    clearInterval(progTimer);
    $("#loader-bar").style.width = "100%";
    $("#loader-pct").textContent = "100%";
    setTimeout(() => {
      $("#loader").classList.add("hidden");
      $("#loader").classList.remove("flex");
    }, 600);
  }

  /* ---------- view switching ---------- */
  const TITLES = { home: "Recommended for you", image: "Image Generation", poster: "Poster Generation", voice: "Voice Studio", video: "Video Generation" };
  function setView(v) {
    state.view = v;
    history.replaceState(null, "", v === "home" ? "/studio" : `/studio?view=${v}`);
    $("#view-title").textContent = TITLES[v];
    ["home", "image", "poster", "voice", "video"].forEach((x) => $("#view-" + x).classList.toggle("hidden", x !== v));
    $("#set-image").classList.toggle("hidden", v !== "image");
    $("#set-poster").classList.toggle("hidden", v !== "poster");
    $("#promptbar").style.display = v === "image" || v === "poster" ? "" : "none";
    $("#prompt").placeholder = v === "poster" ? "Custom message (optional)..." : "Describe the image you want to generate...";
    $$("[data-view]").forEach((b) => {
      const on = b.dataset.view === v;
      if (b.classList.contains("snav") || b.classList.contains("bnav")) {
        b.classList.toggle("bg-saffron/10", on);
        b.classList.toggle("text-saffron", on);
      }
    });
    document.body.classList.remove("sheet-open");
  }
  $$("[data-view]").forEach((b) => b.addEventListener("click", () => setView(b.dataset.view)));
  $("#btn-sheet").addEventListener("click", () => document.body.classList.toggle("sheet-open"));
  $("#btn-new").addEventListener("click", () => { $("#prompt").value = ""; setView(state.view === "home" ? "image" : state.view); $("#prompt").focus(); });

  /* ---------- history ---------- */
  const HKEY = "bm-studio-history";
  const loadH = () => { try { return JSON.parse(localStorage.getItem(HKEY) || "[]"); } catch { return []; } };
  const saveH = (h) => { localStorage.setItem(HKEY, JSON.stringify(h.slice(0, 12))); renderH(); };
  function renderH() {
    $("#history").innerHTML = loadH().map((h) =>
      `<img src="${h.thumb}" title="${h.prompt}" data-p="${h.prompt}" class="aspect-square w-full cursor-pointer rounded-lg object-cover ring-1 ring-golden/30">`
    ).join("") || `<p class="col-span-4 text-xs text-sandal/50 dark:text-cream/40">Abhi koi generation nahi</p>`;
    $$("#history img").forEach((im) => im.addEventListener("click", () => { $("#prompt").value = im.dataset.p; }));
  }
  $("#clear-history").addEventListener("click", () => saveH([]));
  renderH();

  /* ---------- IMAGE: 2 reference slots ---------- */
  $("#ref-input").addEventListener("change", (e) => {
    const f = e.target.files[0];
    if (f && state.refs.length < 2) state.refs.push(f);
    e.target.value = "";
    drawRefs();
  });
  function drawRefs() {
    $("#ref-count").textContent = state.refs.length;
    let html = "";
    for (let i = 0; i < 2; i++) {
      if (state.refs[i]) {
        html += `<span class="relative"><img src="${URL.createObjectURL(state.refs[i])}" class="size-16 rounded-xl object-cover ring-2 ring-golden/60">
          <button data-rm="${i}" class="absolute -right-1.5 -top-1.5 grid size-5 place-items-center rounded-full bg-ink text-xs text-white">×</button></span>`;
      } else {
        html += `<label data-add class="grid size-16 cursor-pointer place-items-center rounded-xl border-2 border-dashed border-sandal/25 text-xl hover:border-saffron dark:border-white/20">📤</label>`;
      }
    }
    $("#ref-thumbs").innerHTML = html;
    $$("#ref-thumbs [data-rm]").forEach((b) => b.addEventListener("click", () => { state.refs.splice(+b.dataset.rm, 1); drawRefs(); }));
    $$("#ref-thumbs [data-add]").forEach((l) => l.addEventListener("click", () => $("#ref-input").click()));
  }
  drawRefs();

  /* ---------- POSTER: 1 photo slot ---------- */
  $("#p-photo").addEventListener("change", (e) => {
    const f = e.target.files[0];
    if (!f) return;
    state.photo = f;
    renderPSlot();
  });
  function renderPSlot() {
    const wrap = $("#p-slot-wrap");
    if (!wrap) return;
    if (state.photo) {
      wrap.innerHTML = `<span class="relative inline-block">
        <img src="${URL.createObjectURL(state.photo)}" class="size-16 rounded-xl object-cover ring-2 ring-golden/60">
        <button id="p-remove" class="absolute -right-1.5 -top-1.5 grid size-5 place-items-center rounded-full bg-ink text-xs text-white">×</button></span>`;
      $("#p-remove").addEventListener("click", () => { state.photo = null; renderPSlot(); });
    } else {
      wrap.innerHTML = `<label class="grid size-16 cursor-pointer place-items-center rounded-xl border-2 border-dashed border-sandal/25 text-xl hover:border-saffron dark:border-white/20">📤</label>`;
      wrap.querySelector("label").addEventListener("click", () => $("#p-photo").click());
    }
  }
  renderPSlot();

  /* ---------- POSTER TEMPLATES ---------- */
  const TPL = [
    { id: "ganesh", name: "🐘 Ganesh Utsav",
      scene: "Lord Ganesha seated majestically on an ornate golden throne at LEFT side, carved temple backdrop, hanging brass oil lamps, marigold garlands, modak plate, warm golden glow",
      shloka: "॥ श्री गणेशाय नमः ॥",
      title: { mr: "श्री गणेश जयंती", en: "Ganesh Jayanti" },
      sub: { mr: "निमित्त सर्वांना मंगलमय शुभेच्छा...!", en: "Warm wishes to all...!" },
      para: { mr: "विघ्नांचे नाशक, मंगलमूर्ती, बुद्धीचे दाता श्री गणेशाच्या कृपेने आपल्या जीवनात सुख, शांती, समृद्धी व सचुखी नांदो...", en: "May Lord Ganesha's blessings bring peace, prosperity and success to your life..." },
      bold: { mr: "गणपती बाप्पा मोरया मंगलमूर्ती मोरया..!", en: "Ganpati Bappa Morya!" },
      sugg: { mr: ["सुख, समृद्धी आणि आरोग्य लाभो!", "बाप्पाची कृपा सदैव राहो!"], en: ["May Bappa bless your home!", "Wishing you prosperity!"] } },
    { id: "diwali", name: "🪔 Diwali",
      scene: "rows of glowing clay diyas and golden rangoli on LEFT side, fireworks bokeh in night sky, marigold garlands, warm amber glow, elegant temple courtyard",
      shloka: "॥ शुभ दीपावली ॥",
      title: { mr: "शुभ दीपावली", en: "Happy Diwali" },
      sub: { mr: "प्रकाशाचा सण, आनंदाचा क्षण!", en: "Festival of lights, moment of joy!" },
      para: { mr: "दिव्यांच्या प्रकाशाने तुमचे जीवन उजळून निघो, घरोघरी सुख आणि समृद्धी नांदो.", en: "May the light of diyas brighten your life with joy and prosperity." },
      bold: { mr: "शुभ दीपावली!", en: "Happy Diwali!" },
      sugg: { mr: ["प्रकाश आणि आनंद लाभो!", "दिवाळी शुभेच्छा!"], en: ["Lights and joy to your home!", "Have a sparkling Diwali!"] } },
    { id: "navratri", name: "🌺 Navratri",
      scene: "Goddess Durga idol with garlands on LEFT side, red and gold drapes, dandiya sticks, marigold decoration, festive warm glow",
      shloka: "॥ जय माता दी ॥",
      title: { mr: "नवरात्रि शुभेच्छा", en: "Happy Navratri" },
      sub: { mr: "माईच्या कृपेने मंगलमय वर्ष!", en: "Blessings of Maa Durga!" },
      para: { mr: "नऊ दिवसांची भक्ती, माईचा आशीर्वाद — तुमच्या जीवनात सुख, समृद्धी आणि आरोग्य नांदो.", en: "May Maa Durga's nine nights of devotion bring health, wealth and joy to you." },
      bold: { mr: "जय माता दी!", en: "Jai Mata Di!" },
      sugg: { mr: ["नवरात्री शुभेच्छा!", "माईचा आशीर्वाद लाभो!"], en: ["Happy Navratri!", "Blessings of Maa Durga!"] } },
    { id: "holi", name: "🎨 Holi",
      scene: "colorful gulal powder clouds and water splashes around, temple silhouette, vibrant pink yellow green colors, joyful festive bokeh",
      shloka: "॥ राधे राधे ॥",
      title: { mr: "होळी शुभेच्छा", en: "Happy Holi" },
      sub: { mr: "रंगांचा सण, आनंदाचा क्षण!", en: "Festival of colors and joy!" },
      para: { mr: "रंगांनी तुमचे जीवन भरून जावो, प्रत्येक दिवस आनंदाने उजळून निघो.", en: "May your life be filled with colors and every day shine with joy." },
      bold: { mr: "होली मुबारक!", en: "Happy Holi!" },
      sugg: { mr: ["रंगभर शुभेच्छा!", "होळी शुभेच्छा!"], en: ["Wishing you a colorful Holi!", "Holi greetings!"] } },
    { id: "hanuman", name: "🚩 Hanuman Jayanti",
      scene: "Lord Hanuman with mace and saffron flag on LEFT side, mountain temple backdrop, saffron orange glow, powerful divine aura",
      shloka: "॥ जय हनुमान ॥",
      title: { mr: "हनुमान जयंती", en: "Hanuman Jayanti" },
      sub: { mr: "बळ आणि भक्तीचे प्रतीक!", en: "Symbol of strength and devotion!" },
      para: { mr: "हनुमंताच्या कृपेने तुम्हाला बळ, धैर्य आणि विजय लाभो.", en: "May Hanuman bless you with strength, courage and victory." },
      bold: { mr: "जय श्री राम! जय हनुमान!", en: "Jai Shri Ram! Jai Hanuman!" },
      sugg: { mr: ["बजरंगबली की जय!", "हनुमंत आशीर्वाद!"], en: ["Jai Bajrangbali!", "Hanuman's blessings!"] } },
    { id: "swami", name: "🙏 Swami Samarth",
      scene: "Swami Samarth seated in meditation on LEFT side, akkalkot temple backdrop, soft saffron and cream glow, peaceful divine aura",
      shloka: "॥ श्री स्वामी समर्थ ॥",
      title: { mr: "स्वामी समर्थ", en: "Swami Samarth" },
      sub: { mr: "भक्ती आणि शरणागतीचे प्रतीक!", en: "Faith and surrender!" },
      para: { mr: "स्वामींच्या कृपेने तुमचे जीवन शांत, सुखी आणि समृद्ध होवो.", en: "May Swami's grace keep your life peaceful and prosperous." },
      bold: { mr: "श्री स्वामी समर्थ!", en: "Shri Swami Samarth!" },
      sugg: { mr: ["स्वामी समर्थ!", "भय नको, स्वामी आहेत!"], en: ["Swami Samarth!", "Fear not, Swami is with you!"] } },
    { id: "newyear", name: "🎉 New Year",
      scene: "golden fireworks and confetti in night sky, elegant champagne glasses, clock tower at midnight, warm golden glow",
      shloka: "॥ शुभ नववर्ष ॥",
      title: { mr: "नववर्ष शुभेच्छा", en: "Happy New Year" },
      sub: { mr: "नवे स्वप्न, नवी सुरुवात!", en: "New dreams, new beginnings!" },
      para: { mr: "नवे वर्ष तुम्हाला सुख, समृद्धी आणि यश घेऊन येवो.", en: "May the new year bring you joy, prosperity and success." },
      bold: { mr: "नववर्षाच्या शुभेच्छा!", en: "Happy New Year!" },
      sugg: { mr: ["नववर्ष शुभेच्छा!", "यशस्वी नवे वर्ष!"], en: ["Cheers to the new year!", "Wishing you a great year!"] } },
  ];
  $("#p-tpl").innerHTML = TPL.map((t, i) => `<option value="${i}">${t.name}</option>`).join("");
  function renderSugg() {
    const t = TPL[+$("#p-tpl").value], lang = $("#p-lang").value;
    $("#p-sugg").innerHTML = (t.sugg[lang] || []).map((s) =>
      `<button data-sugg="${s}" class="filter-btn !px-2 !py-1 !text-[11px]">${s}</button>`).join("");
    $$("#p-sugg [data-sugg]").forEach((b) => b.addEventListener("click", () => { $("#p-msg").value = b.dataset.sugg; }));
  }
  $("#p-tpl").addEventListener("change", renderSugg);
  $("#p-lang").addEventListener("change", renderSugg);
  renderSugg();

  /* ---------- helpers ---------- */
  function loadImg(src) { return new Promise((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = rej; i.src = src; }); }
  function fileToB64(f) { return new Promise((res) => { const r = new FileReader(); r.onload = () => res(r.result); r.readAsDataURL(f); }); }
  function needLogin() {
    localStorage.setItem("bm-welcome", "🙏 Pehle login karo — AI Studio ke liye");
    location.href = "/login";
  }

  const SIZES = {
    "1K": { Auto: "1024x1024", "1:1": "1024x1024", "4:5": "1024x1536", "16:9": "1536x1024", "9:16": "1024x1536" },
    "2K": { Auto: "2048x2048", "1:1": "2048x2048", "4:5": "1536x2048", "16:9": "2048x1536", "9:16": "1536x2048" },
  };
  const STYLES = {
    Traditional: "traditional Indian devotional art, ornate details, ",
    Cinematic: "cinematic lighting, photorealistic, dramatic, ",
    Cosmic: "cosmic spiritual, ethereal golden glow, nebula, ",
    Photorealistic: "ultra photorealistic, 8k detail, ",
  };

  $("#btn-send").addEventListener("click", async () => {
    if (!token) return needLogin();
    if (state.view === "image") return genImage();
    if (state.view === "poster") return genPoster();
  });

  async function callAPI(payload) {
    const r = await fetch(API, {
      method: "POST",
      headers: { "Content-Type": "application/json", ...(token ? { Authorization: `Bearer ${token}` } : {}) },
      body: JSON.stringify(payload),
    });
    const d = await r.json();
    if (!r.ok || !d.image) throw new Error(d.error || "Generation fail");
    return d;
  }

  /* ---------- IMAGE ---------- */
  async function genImage() {
    const prompt = $("#prompt").value.trim();
    if (!prompt) { $("#prompt").focus(); return; }
    const btn = $("#btn-send"); btn.disabled = true;
    startProgress("Image generate ho raha hai...");
    try {
      const ratio = $("#img-ratio").value, res = $("#img-res").value, style = $("#img-style").value;
      const size = (SIZES[res] || SIZES["1K"])[ratio] || "1024x1024";
      const payload = { size };
      if (state.refs[0]) {
        payload.photo = await fileToB64(state.refs[0]);
        payload.prompt = `Using the input photo as the base image, apply this transformation while keeping the person's face, identity and key details intact: ${(STYLES[style] || "") + prompt}`;
      } else {
        payload.prompt = (STYLES[style] || "") + prompt;
      }
      const d = await callAPI(payload);
      $("#img-empty").classList.add("hidden");
      $("#img-results").classList.remove("hidden");
      const card = document.createElement("div");
      card.className = "group relative overflow-hidden rounded-2xl shadow-soft";
      card.innerHTML = `<img src="${d.image}" class="w-full object-cover" alt="Generated">
        <div class="absolute inset-0 bg-gradient-to-t from-ink/90 to-transparent opacity-0 transition group-hover:opacity-100">
          <div class="absolute inset-x-0 bottom-0 p-3"><a href="${d.image}" download="bhaktimedia-${Date.now()}.png" class="btn btn-primary w-full justify-center !py-1.5 !text-xs">⬇️ Download</a></div>
        </div>`;
      $("#img-results").prepend(card);
      saveH([{ prompt, thumb: d.image, t: Date.now() }, ...loadH()]);
      if (d.used !== "DEV") { $("#credits-count").textContent = d.used; $("#credits-limit").textContent = d.limit; }
      localStorage.setItem("bm-welcome", `🎨 Image ready! ${d.used}/${d.limit}`);
    } catch (e) {
      localStorage.setItem("bm-welcome", "❌ " + e.message);
    }
    stopProgress();
    btn.disabled = false;
  }

  /* ---------- POSTER (EDITS pipeline) ---------- */
  async function genPoster() {
    if (!state.photo) { localStorage.setItem("bm-welcome", "📷 Pehle user photo upload karo!"); return; }
    const btn = $("#btn-send"); btn.disabled = true;
    startProgress("Poster generate ho raha hai...");
    const t = TPL[+$("#p-tpl").value], lang = $("#p-lang").value;
    const name = $("#p-name").value.trim() || "श्री. भक्त";
    const custom = $("#p-msg").value.trim();
    const ratio = $("#p-ratio").value;
    const aiSize = ratio === "1:1" ? "1024x1024" : "1024x1536";
    const fmt = ratio === "1:1" ? "square 1:1" : ratio === "9:16" ? "tall portrait 9:16" : "portrait 4:5";
    const L = (o) => o[lang];
    try {
      const photo = await fileToB64(state.photo);
      const prompt =
`Create a professional Indian devotional festival greeting poster in ${fmt} format.
SCENE: ${t.scene}.
PERSON: Use the EXACT person from the input photo - identical face, hair and clothing. Remove the photo background completely and place the person naturally inside the scene on the RIGHT side, fully integrated with matching warm lighting and soft shadows.
TEXT - render EXACTLY with perfect spelling in elegant golden Devanagari calligraphy:
Top small line: "${t.shloka}"
Big decorative title: "${L(t.title)}"
Under title small line: "${L(t.sub)}"
Paragraph: "${custom || L(t.para)}"
Bottom decorative panel: "${L(t.bold)}"
Small line near bottom: "शुभेच्छुक : ${name}"
STYLE: photorealistic devotional art, warm golden light, ultra detailed, professional print quality, balanced composition, all text clearly readable.`;
      const d = await callAPI({ prompt, size: aiSize, photo });
      const img = await loadImg(d.image);
      const canvas = document.createElement("canvas");
      canvas.width = img.width; canvas.height = img.height;
      const ctx = canvas.getContext("2d");
      ctx.drawImage(img, 0, 0);
      ctx.fillStyle = "rgba(255,255,255,0.85)";
      ctx.font = `700 ${Math.round(img.height * 0.014)}px sans-serif`;
      ctx.textAlign = "right";
      ctx.fillText("BhaktiMedia.in", img.width - img.width * 0.02, img.height - img.height * 0.015);
      const url = canvas.toDataURL("image/png");
      $("#p-empty").classList.add("hidden");
      $("#p-result").classList.remove("hidden");
      $("#p-img").src = url;
      $("#p-download").href = url;
      $("#p-download").download = `bhaktimedia-${t.id}-poster.png`;
      $("#share-wa").onclick = async () => {
        const blob = await (await fetch(url)).blob();
        const file = new File([blob], "poster.png", { type: "image/png" });
        if (navigator.share && navigator.canShare?.({ files: [file] })) navigator.share({ files: [file], text: L(t.bold) }).catch(() => {});
        else window.open("https://wa.me/?text=" + encodeURIComponent("🪔 " + L(t.bold) + " — BhaktiMedia.in"), "_blank");
      };
      $("#share-fb").onclick = () => window.open("https://www.facebook.com/sharer/sharer.php?u=" + encodeURIComponent("https://bhaktimedia.in"), "_blank");
      $("#share-ig").onclick = () => {
        const a = document.createElement("a"); a.href = url; a.download = "bhaktimedia-poster.png"; a.click();
        localStorage.setItem("bm-welcome", "📸 PNG download ho gayi — Instagram story mein upload karo!");
      };
      saveH([{ prompt: t.name + " — " + name, thumb: url, t: Date.now() }, ...loadH()]);
      localStorage.setItem("bm-welcome", "✅ Poster ready!");
    } catch (e) {
      localStorage.setItem("bm-welcome", "❌ " + e.message);
    }
    stopProgress();
    btn.disabled = false;
  }

  /* ---------- init ---------- */
  const v = new URLSearchParams(location.search).get("view");
  setView(["image", "poster", "voice", "video"].includes(v) ? v : "home");
})();
</script>
</Layout>
---
import Layout from "../layouts/Layout.astro";
import { posters } from "../data/posters";

const FESTS = [
  { id: "ganesh", label: "🐘 Ganesh Utsav" },
  { id: "diwali", label: "🪔 Diwali" },
  { id: "navratri", label: "🌺 Navratri" },
  { id: "holi", label: "🎨 Holi" },
  { id: "hanuman", label: "🚩 Hanuman Jayanti" },
  { id: "swami", label: "🙏 Swami Samarth" },
  { id: "newyear", label: "🎉 New Year" },
];
const preStudio = Astro.url.searchParams.get("studio") || "";
const preTemplate = Astro.url.searchParams.get("template") || "";
---
<Layout title="Divine AI Studio" description="BhaktiMedia AI Studio — images, posters aur bahut kuch, seconds mein.">
<div class="container-x grid gap-6 px-4 pb-20 pt-24 sm:px-6 lg:grid-cols-[260px_1fr]">
  <div id="toast" class="pointer-events-none fixed left-1/2 top-20 z-[90] hidden -translate-x-1/2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-cream shadow-lift dark:bg-white dark:text-ink"></div>

  <!-- ═══ SIDEBAR ═══ -->
  <aside class="h-fit rounded-3xl border border-sandal/10 bg-white/80 p-4 shadow-soft backdrop-blur-xl dark:border-white/10 dark:bg-night/70 lg:sticky lg:top-24">
    <p class="px-2 text-[10px] font-bold uppercase tracking-widest text-sandal-deep/50 dark:text-cream/40">Studio Tools</p>
    <div class="mt-2 grid gap-1">
      <button data-tab="home" class="side-btn flex items-center gap-3 rounded-2xl px-4 py-3 text-left text-sm font-semibold transition">🏠 Home</button>
      <button data-tab="image" class="side-btn flex items-center gap-3 rounded-2xl px-4 py-3 text-left text-sm font-semibold transition">🖼️ Image Generation <span class="ml-auto size-2 rounded-full bg-green-500"></span></button>
      <button data-tab="poster" class="side-btn flex items-center gap-3 rounded-2xl px-4 py-3 text-left text-sm font-semibold transition">🎨 Poster Generation <span class="ml-auto size-2 rounded-full bg-green-500"></span></button>
      <button data-locked class="flex items-center gap-3 rounded-2xl px-4 py-3 text-left text-sm font-semibold opacity-50">🎙️ Voice Studio <span class="ml-auto">🔒</span></button>
      <button data-locked class="flex items-center gap-3 rounded-2xl px-4 py-3 text-left text-sm font-semibold opacity-50">🎬 Video Generation <span class="ml-auto">🔒</span></button>
    </div>
    <div class="mt-4 rounded-2xl bg-gradient-to-br from-saffron to-golden p-4 text-white shadow-gold">
      <p id="cr-line" class="font-display text-sm font-bold">⚡ Credits load ho rahe hain...</p>
      <p class="mt-1 text-[11px] text-white/80">1 creation = 3⚡ • HD = 6⚡</p>
    </div>
    <button id="logout" class="mt-3 w-full rounded-2xl bg-sandal/10 px-4 py-2.5 text-xs font-bold text-sandal-deep transition hover:bg-sandal/20 dark:bg-white/5 dark:text-cream/70">Logout</button>
  </aside>

  <!-- ═══ MAIN ═══ -->
  <main class="grid gap-6">
    <!-- HOME TAB -->
    <section id="tab-home" class="tab-panel grid gap-6">
      <div class="relative overflow-hidden rounded-3xl bg-ink p-10 text-center text-cream shadow-lift dark:bg-night-soft sm:p-16">
        <p class="text-xs font-bold uppercase tracking-[0.3em] text-goldsoft">BhaktiMedia AI Engine ⚡</p>
        <h1 class="mt-3 font-display text-4xl font-bold sm:text-6xl">Divine AI Studio</h1>
        <p class="mt-3 text-sm text-cream/70">Turn devotion into design — posters, images aur bahut kuch, seconds mein.</p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <button data-goto="image" class="btn bg-white/10 !text-cream backdrop-blur hover:bg-white/20">🖼️ Generate Image</button>
          <button data-goto="poster" class="btn bg-white/10 !text-cream backdrop-blur hover:bg-white/20">🎨 Create Poster</button>
        </div>
      </div>

      <div>
        <h2 class="font-display text-2xl font-bold">Get inspired</h2>
        <p class="mt-1 text-sm text-sandal-deep/60 dark:text-cream/50">Pasand ka card click karo — Poster Studio usi template ke saath khulega.</p>
        <div id="chips" class="mt-4 flex flex-wrap gap-2">
          <button data-fest="all" class="chip cursor-pointer bg-gradient-to-r from-saffron to-golden text-white shadow-gold">✨ Trending</button>
          {FESTS.map((f) => (
            <button data-fest={f.id} class="chip cursor-pointer bg-sandal/10 text-sandal-deep dark:bg-white/5 dark:text-cream/70">{f.label}</button>
          ))}
        </div>
        <div id="inspire" class="mt-5 grid grid-cols-2 gap-4 md:grid-cols-4"></div>
      </div>
    </section>

    <!-- IMAGE TAB -->
    <section id="tab-image" class="tab-panel hidden grid gap-6 lg:grid-cols-2">
      <div class="card p-6 shadow-soft">
        <p class="eyebrow">🖼️ Image Generation</p>
        <label class="mt-4 block text-sm font-semibold">Prompt
          <textarea id="im-prompt" rows="4" class="input mt-1.5" placeholder="e.g. Shri Ganesh in sunrise glow, traditional art, temple background..."></textarea>
        </label>
        <div class="mt-4 grid grid-cols-2 gap-3">
          <label class="block text-sm font-semibold">Size / Ratio
            <select id="im-size" class="input mt-1.5">
              <option value="1024x1024">1:1 Square</option>
              <option value="1536x1024">3:2 Landscape</option>
              <option value="1024x1536">2:3 Portrait</option>
              <option value="1024x1792">9:16 Reels / Story</option>
            </select>
          </label>
          <label class="flex items-end gap-2 pb-2 text-sm font-semibold">
            <input id="im-hd" type="checkbox" class="size-5 accent-saffron" /> 🌟 HD (6⚡)
          </label>
        </div>
        <button id="im-go" class="btn btn-primary mt-5 w-full !py-3">✨ Generate (3⚡)</button>
      </div>
      <div class="card grid place-items-center p-6 shadow-soft">
        <div id="im-result" class="grid w-full place-items-center gap-4 text-center">
          <p class="text-4xl">🖼️</p>
          <p class="text-sm text-sandal-deep/60 dark:text-cream/50">Aapki image yahan dikhegi</p>
        </div>
      </div>
    </section>

    <!-- POSTER TAB -->
    <section id="tab-poster" class="tab-panel hidden grid gap-6 lg:grid-cols-2">
      <div class="card p-6 shadow-soft">
        <p class="eyebrow">🎨 Poster Generation</p>
        <div class="mt-4 grid grid-cols-2 gap-3">
          <label class="block text-sm font-semibold">Festival
            <select id="po-fest" class="input mt-1.5">
              {FESTS.map((f) => <option value={f.id}>{f.label}</option>)}
            </select>
          </label>
          <label class="block text-sm font-semibold">Size
            <select id="po-size" class="input mt-1.5">
              <option value="1024x1536">2:3 Print (default)</option>
              <option value="1024x1024">1:1 Square</option>
              <option value="1024x1792">9:16 Reels / Story</option>
            </select>
          </label>
        </div>
        <p class="mt-4 text-sm font-semibold">Template chuno <span id="po-tpl-name" class="ml-1 text-xs font-normal text-sandal-deep/60 dark:text-cream/50"></span></p>
        <div id="po-tpls" class="no-scrollbar mt-2 flex gap-3 overflow-x-auto pb-2"></div>
        <label class="mt-4 block text-sm font-semibold">Aapki Photo (optional)
          <input id="po-photo" type="file" accept="image/*" class="mt-1.5 w-full text-xs file:mr-3 file:rounded-full file:border-0 file:bg-saffron file:px-4 file:py-2 font-bold file:text-white" />
        </label>
        <div class="mt-4 grid grid-cols-2 gap-3">
          <label class="block text-sm font-semibold">Naam
            <input id="po-name" class="input mt-1.5" placeholder="e.g. Darsh Jadhav" maxlength="40" />
          </label>
          <label class="block text-sm font-semibold">Shubhechha Message
            <input id="po-msg" class="input mt-1.5" placeholder="e.g. Ganesh Utsav Shubhechha" maxlength="60" />
          </label>
        </div>
        <label class="mt-4 flex items-center gap-2 text-sm font-semibold">
          <input id="po-hd" type="checkbox" class="size-5 accent-saffron" /> 🌟 HD (6⚡)
        </label>
        <button id="po-go" class="btn btn-primary mt-5 w-full !py-3">🎨 Poster Generate (3⚡)</button>
      </div>
      <div class="card grid place-items-center p-6 shadow-soft">
        <div id="po-result" class="grid w-full place-items-center gap-4 text-center">
          <p class="text-4xl">🎨</p>
          <p class="text-sm text-sandal-deep/60 dark:text-cream/50">Aapka poster yahan dikhega</p>
        </div>
      </div>
    </section>
  </main>
</div>

<script id="posters-data" type="application/json" set:html={JSON.stringify(posters)}></script>
<script id="pre-data" type="application/json" set:html={JSON.stringify({ preStudio, preTemplate })}></script>
<script is:inline>
(() => {
  const $ = (s) => document.querySelector(s);
  const $$ = (s) => [...document.querySelectorAll(s)];
  const POSTERS = JSON.parse($("#posters-data").textContent);
  const PRE = JSON.parse($("#pre-data").textContent);

  function toast(m) { const t = $("#toast"); t.textContent = m; t.classList.remove("hidden"); setTimeout(() => t.classList.add("hidden"), 2800); }

  let token = "";
  try {
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (k && k.indexOf("sb-") === 0 && k.indexOf("auth-token") !== -1) { token = JSON.parse(localStorage.getItem(k)).access_token; break; }
    }
  } catch (e) {}
  if (!token) location.href = "/login";

  /* tabs */
  function showTab(t) {
    $$(".tab-panel").forEach((p) => p.classList.toggle("hidden", p.id !== "tab-" + t));
    $$(".side-btn").forEach((b) => {
      const on = b.dataset.tab === t;
      b.classList.toggle("bg-saffron/10", on);
      b.classList.toggle("text-saffron", on);
    });
  }
  $$(".side-btn").forEach((b) => b.addEventListener("click", () => showTab(b.dataset.tab)));
  $$("[data-goto]").forEach((b) => b.addEventListener("click", () => showTab(b.dataset.goto)));
  $$("[data-locked]").forEach((b) => b.addEventListener("click", () => toast("🔒 Voice/Video studio jald aa raha hai!")));
  $("#logout").addEventListener("click", () => { Object.keys(localStorage).filter((k) => k.startsWith("sb-")).forEach((k) => localStorage.removeItem(k)); location.href = "/"; });

  /* credits */
  async function loadCredits() {
    try {
      const r = await fetch("/api/credits", { headers: { Authorization: "Bearer " + token } });
      if (r.ok) { const c = await r.json(); $("#cr-line").textContent = `⚡ ${c.limit - c.used} / ${c.limit} credits baaki`; }
    } catch (e) {}
  }

  /* get inspired grid */
  let fest = "all";
  function renderInspire() {
    const list = fest === "all" ? POSTERS.slice(0, 8) : POSTERS.filter((p) => p.fest === fest);
    $("#inspire").innerHTML = list.map((p) => `
      <button data-tpl="${p.file}" class="group relative overflow-hidden rounded-2xl border border-sandal/10 shadow-soft transition hover:-translate-y-1 hover:shadow-lift dark:border-white/10">
        <img src="${p.file}" loading="lazy" class="w-full h-auto transition duration-700 group-hover:scale-105" alt="${p.title}" />
        <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/90 to-transparent px-3 pb-2 pt-8 text-left">
          <span class="block text-[10px] text-goldsoft">${p.deity}</span>
          <span class="block text-xs font-bold text-white">${p.title}</span>
        </span>
      </button>`).join("");
    $$("#inspire [data-tpl]").forEach((b) => b.addEventListener("click", () => pickTemplate(b.dataset.tpl, true)));
  }
  $$("#chips [data-fest]").forEach((c) => c.addEventListener("click", () => {
    fest = c.dataset.fest;
    $$("#chips [data-fest]").forEach((x) => { x.className = "chip cursor-pointer bg-sandal/10 text-sandal-deep dark:bg-white/5 dark:text-cream/70"; });
    c.className = "chip cursor-pointer bg-gradient-to-r from-saffron to-golden text-white shadow-gold";
    renderInspire();
  }));

  /* poster template picker */
  let selTpl = "";
  function renderTpls() {
    const f = $("#po-fest").value;
    const list = POSTERS.filter((p) => p.fest === f);
    $("#po-tpls").innerHTML = list.map((p) => `
      <button data-tpl="${p.file}" class="w-24 shrink-0 overflow-hidden rounded-xl border-2 transition ${p.file === selTpl ? "border-saffron shadow-gold" : "border-transparent opacity-70 hover:opacity-100"}">
        <img src="${p.file}" loading="lazy" class="w-full h-auto" alt="${p.title}" />
      </button>`).join("");
    $$("#po-tpls [data-tpl]").forEach((b) => b.addEventListener("click", () => pickTemplate(b.dataset.tpl, false)));
  }
  function pickTemplate(file, jump) {
    selTpl = file;
    const p = POSTERS.find((x) => x.file === file);
    if (p) { $("#po-fest").value = p.fest; $("#po-tpl-name").textContent = "— " + p.title; }
    renderTpls();
    if (jump) {
      showTab("poster");
      document.getElementById("tab-poster").scrollIntoView({ behavior: "smooth", block: "start" });
      toast("🎨 Template load ho gayi — details bharo aur generate karo!");
    }
  }
  $("#po-fest").addEventListener("change", () => { selTpl = ""; renderTpls(); });

  /* photo → base64 */
  let photoB64 = "";
  $("#po-photo").addEventListener("change", (e) => {
    const f = e.target.files[0];
    if (!f) return;
    const rd = new FileReader();
    rd.onload = () => { photoB64 = rd.result; toast("✅ Photo ready!"); };
    rd.readAsDataURL(f);
  });

  /* generate */
  async function gen(body, resultEl, btn, label) {
    btn.disabled = true; btn.textContent = "⏳ " + label + " ban raha hai... (30-60 sec)";
    resultEl.innerHTML = `<p class="text-3xl animate-pulse">🪔</p><p class="text-sm text-sandal-deep/60 dark:text-cream/50">Divine art ban raha hai... 30-60 seconds</p>`;
    try {
      const r = await fetch("/api/generate-image", { method: "POST", headers: { "Content-Type": "application/json", Authorization: "Bearer " + token }, body: JSON.stringify(body) });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || "Generation fail");
      resultEl.innerHTML = `
        <img src="${d.image}" class="max-h-[70vh] w-full rounded-2xl object-contain shadow-lift" alt="Generated" />
        <a href="${d.image}" download="bhaktimedia-${Date.now()}.png" class="btn btn-primary w-full">⬇ Download PNG</a>
        <p class="text-xs text-sandal-deep/60 dark:text-cream/50">⚡ ${d.used}/${d.limit} credits use ho gaye</p>`;
      $("#cr-line").textContent = `⚡ ${d.limit - d.used} / ${d.limit} credits baaki`;
    } catch (e) {
      resultEl.innerHTML = `<p class="text-3xl">❌</p><p class="text-sm font-semibold text-red-500">${e.message}</p>`;
    } finally { btn.disabled = false; btn.textContent = btn.dataset.label; }
  }
  $("#im-go").dataset.label = "✨ Generate (3⚡)";
  $("#im-go").addEventListener("click", () => {
    const prompt = $("#im-prompt").value.trim();
    if (prompt.length < 5) return toast("Prompt thoda detail mein likho");
    gen({ prompt, size: $("#im-size").value, hd: $("#im-hd").checked }, $("#im-result"), $("#im-go"), "Image");
  });
  $("#po-go").dataset.label = "🎨 Poster Generate (3⚡)";
  $("#po-go").addEventListener("click", () => {
    if (!selTpl) return toast("Pehle ek template chuno");
    gen({ template: selTpl, photo: photoB64 || undefined, name: $("#po-name").value.trim(), msg: $("#po-msg").value.trim(), size: $("#po-size").value, hd: $("#po-hd").checked }, $("#po-result"), $("#po-go"), "Poster");
  });

  /* init — URL params support (?studio=poster&template=...) */
  renderInspire();
  if (PRE.preTemplate && POSTERS.some((p) => p.file === PRE.preTemplate)) {
    pickTemplate(PRE.preTemplate, false);
    showTab("poster");
  } else {
    const first = POSTERS.find((p) => p.fest === "ganesh");
    if (first) pickTemplate(first.file, false);
    showTab(PRE.preStudio === "poster" ? "poster" : PRE.preStudio === "image" ? "image" : "home");
  }
  loadCredits();
})();
</script>
</Layout>
---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Signup" description="BhaktiMedia account banao — 3 free credits.">
<div class="container-x flex min-h-screen items-center justify-center px-4 pb-16 pt-28 sm:px-6">
  <div class="w-full max-w-md">
    <div class="card p-8 shadow-lift">
      <div class="text-center">
        <span class="mx-auto grid size-14 place-items-center rounded-2xl bg-gradient-to-br from-saffron to-golden text-2xl text-white shadow-gold">🪔</span>
        <h1 class="mt-4 font-display text-2xl font-bold">Account Banao</h1>
        <p class="mt-1 text-sm text-sandal-deep/60 dark:text-cream/50">3 free credits ke saath shuru karo</p>
      </div>

      <div id="step1" class="mt-6 grid gap-4">
        <label class="block text-sm font-semibold">Naam
          <input id="s-name" class="input mt-1.5" placeholder="Aapka poora naam" />
        </label>
        <label class="block text-sm font-semibold">Email
          <input id="s-email" type="email" class="input mt-1.5" placeholder="aap@email.com" />
        </label>
        <div class="grid grid-cols-2 gap-3">
          <label class="block text-sm font-semibold">Mobile
            <input id="s-phone" class="input mt-1.5" inputmode="numeric" maxlength="10" placeholder="98220 10800" />
          </label>
          <label class="block text-sm font-semibold">Pincode
            <input id="s-pin" class="input mt-1.5" inputmode="numeric" maxlength="6" placeholder="411035" />
          </label>
        </div>
        <label class="block text-sm font-semibold">City
          <input id="s-city" class="input mt-1.5" placeholder="Pune" />
        </label>
        <button id="s-send" class="btn btn-primary w-full">📬 OTP Bhejo</button>
      </div>

      <div id="step2" class="mt-6 hidden gap-4">
        <p class="rounded-xl bg-saffron/10 px-4 py-3 text-center text-sm font-semibold text-saffron">Code bheja gaya: <span id="s-email-echo"></span> • <button id="s-back" class="underline">badlo</button></p>
        <label class="block text-sm font-semibold">6-digit Code
          <input id="s-code" class="input mt-1.5 text-center text-2xl font-bold tracking-[8px]" maxlength="6" inputmode="numeric" placeholder="------" />
        </label>
        <label class="block text-sm font-semibold">Password
          <input id="s-pass" type="password" class="input mt-1.5" placeholder="Kam se kam 6 characters" />
        </label>
        <button id="s-done" class="btn btn-primary w-full">🙏 Signup Karo</button>
        <button id="s-resend" class="text-xs font-semibold text-sandal-deep/60 underline dark:text-cream/50" disabled>Code dobara bhejo (60s)</button>
      </div>

      <p id="s-err" class="mt-4 hidden rounded-xl bg-red-500/10 px-4 py-2.5 text-center text-sm font-semibold text-red-500"></p>
      <p class="mt-6 text-center text-sm text-sandal-deep/60 dark:text-cream/50">Account hai? <a href="/login" class="font-semibold text-saffron underline">Login karo</a></p>
    </div>
  </div>
</div>
<script is:inline>
(function () {
  const $ = (s) => document.querySelector(s);
  let email = "";
  function err(m) { const e = $("#s-err"); if (!m) { e.classList.add("hidden"); return; } e.textContent = m; e.classList.remove("hidden"); }
  async function api(url, body) { const r = await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) }); const d = await r.json().catch(() => ({})); if (!r.ok) throw new Error(d.error || "Kuch galat ho gaya"); return d; }
  let timer = null;
  function startTimer() { let s = 60; const b = $("#s-resend"); b.disabled = true; clearInterval(timer); timer = setInterval(() => { s--; b.textContent = "Code dobara bhejo (" + s + "s)"; if (s <= 0) { clearInterval(timer); b.disabled = false; b.textContent = "Code dobara bhejo"; } }, 1000); }
  $("#s-send").addEventListener("click", async () => {
    err("");
    const name = $("#s-name").value.trim(); email = $("#s-email").value.trim().toLowerCase();
    if (!name) return err("Naam likho");
    if (!/^\S+@\S+\.\S+$/.test(email)) return err("Email sahi nahi hai");
    const b = $("#s-send"); b.disabled = true; b.textContent = "Bhej rahe hain...";
    try { await api("/api/auth/otp", { email, purpose: "signup" }); $("#s-email-echo").textContent = email; $("#step1").classList.add("hidden"); $("#step2").classList.remove("hidden"); $("#step2").classList.add("grid"); startTimer(); }
    catch (e) { err(e.message); }
    finally { b.disabled = false; b.textContent = "📬 OTP Bhejo"; }
  });
  $("#s-back").addEventListener("click", () => { $("#step2").classList.add("hidden"); $("#step2").classList.remove("grid"); $("#step1").classList.remove("hidden"); err(""); });
  $("#s-resend").addEventListener("click", async () => { try { await api("/api/auth/otp", { email, purpose: "signup" }); startTimer(); err(""); } catch (e) { err(e.message); } });
  $("#s-done").addEventListener("click", async () => {
    err("");
    const code = $("#s-code").value.trim(), pass = $("#s-pass").value;
    const phone = $("#s-phone").value.replace(/\D/g, "");
    const pin = $("#s-pin").value.replace(/\D/g, "");
    if (code.length !== 6) return err("6-digit code daalo");
    if (pass.length < 6) return err("Password kam se kam 6 characters");
    if (phone && phone.length !== 10) return err("Mobile 10 digits ka hona chahiye");
    if (pin && pin.length !== 6) return err("Pincode 6 digits ka hona chahiye");
    const b = $("#s-done"); b.disabled = true; b.textContent = "Ban rahe hain...";
    try {
      const d = await api("/api/auth/signup", { name: $("#s-name").value.trim(), email, code, password: pass, phone, city: $("#s-city").value.trim(), pincode: pin });
      localStorage.setItem("sb-bm-auth-token", JSON.stringify({ access_token: d.token, user: { email: d.user.email, user_metadata: { name: d.user.name } } }));
      localStorage.setItem("bm-welcome", "🪔 Swagat hai " + d.user.name + "! 3 free credits mil gaye hain.");
      location.href = "/studio";
    } catch (e) { err(e.message); b.disabled = false; b.textContent = "🙏 Signup Karo"; }
  });
})();
</script>
</Layout>
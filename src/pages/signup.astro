---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Signup" description="BhaktiMedia par naya account banao.">
<div class="container-x px-4 pt-32 pb-20 sm:px-6">
  <div class="mx-auto max-w-md">
    <div class="card p-8 shadow-lift">
      <h1 class="font-display text-2xl font-bold">🙏 Naya Account</h1>
      <p class="mt-1 text-sm text-sandal-deep/60 dark:text-cream/50">Join karo — 3 free AI credits har mahine!</p>
      <form id="signup-form" class="mt-6 grid gap-4">
        <label class="block text-sm font-semibold">Naam
          <input id="name" type="text" required class="input mt-1.5" placeholder="Aapka naam" />
        </label>
        <label class="block text-sm font-semibold">Email
          <input id="email" type="email" required class="input mt-1.5" placeholder="you@example.com" />
        </label>
        <label class="block text-sm font-semibold">Password
          <input id="password" type="password" required minlength="6" class="input mt-1.5" placeholder="Kam se kam 6 characters" />
        </label>
        <p id="err" class="hidden rounded-xl bg-red-500/10 px-4 py-2 text-sm font-semibold text-red-600"></p>
        <button class="btn btn-primary w-full justify-center" type="submit">Account Banao →</button>
      </form>
      <p class="mt-4 text-center text-sm">Pehle se account? <a href="/login" class="font-semibold text-saffron hover:underline">Login karo</a></p>
    </div>
  </div>
</div>
<script is:inline>
document.getElementById("signup-form").addEventListener("submit", async (e) => {
  e.preventDefault();
  const err = document.getElementById("err");
  err.classList.add("hidden");
  const btn = e.target.querySelector("button[type=submit]");
  btn.disabled = true; btn.textContent = "Account ban raha hai...";
  try {
    const r = await fetch("/api/auth/signup", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        name: document.getElementById("name").value,
        email: document.getElementById("email").value,
        password: document.getElementById("password").value,
      }),
    });
    const d = await r.json();
    if (!r.ok || !d.token) throw new Error(d.error || "Signup fail");
    localStorage.setItem("sb-bm-auth-token", JSON.stringify({
      access_token: d.token,
      user: { id: d.user.id, email: d.user.email, user_metadata: { name: d.user.name } },
    }));
    localStorage.setItem("bm-welcome", "🎉 Swagat hai, " + d.user.name + "! Aapke 3 free credits ready hain.");
    location.href = "/studio";
  } catch (ex) {
    err.textContent = ex.message; err.classList.remove("hidden");
    btn.disabled = false; btn.textContent = "Account Banao →";
  }
});
</script>
</Layout>
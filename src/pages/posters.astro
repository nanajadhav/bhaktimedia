---
import Layout from "../layouts/Layout.astro";
import { posters } from "../data/posters";
import { existsSync } from "node:fs";

/* icon file hai to wahi, warna emoji fallback */
const GANESH_ICON = existsSync("public/icons/ganesh.png") ? "/icons/ganesh.png" : "";

const FESTS = [
  { id: "ganesh", name: "Ganesh Utsav", icon: "🐘", img: GANESH_ICON },
  { id: "diwali", name: "Diwali", icon: "🪔", img: "" },
  { id: "navratri", name: "Navratri", icon: "🌺", img: "" },
  { id: "holi", name: "Holi", icon: "🎨", img: "" },
  { id: "hanuman", name: "Hanuman Jayanti", icon: "🚩", img: "" },
  { id: "swami", name: "Swami Samarth", icon: "🙏", img: "" },
  { id: "newyear", name: "New Year", icon: "🎉", img: "" },
];

const NICE: Record<string, string> = {
  "ganesh-1": "Golden Throne", "ganesh-2": "Palkhi Utsav", "ganesh-3": "Modak Blessing",
  "diwali-1": "Diya Rows", "diwali-2": "Laxmi Pujan", "diwali-3": "Fireworks Night",
  "navratri-1": "Durga Idol", "navratri-2": "Garba Night", "navratri-3": "Nine Colors",
  "holi-1": "Gulal Clouds", "holi-2": "Radha Krishna", "holi-3": "Water Splash",
  "hanuman-1": "Saffron Flag", "hanuman-2": "Chalisa Pose", "hanuman-3": "Gada Power",
  "swami-1": "Meditation", "swami-2": "Akkalkot Darbar", "swami-3": "Blessing Hand",
  "newyear-1": "Fireworks", "newyear-2": "Midnight Clock", "newyear-3": "Sunrise Garlands",
};

const fest = Astro.url.searchParams.get("fest") || "";
const meta = FESTS.find((f) => f.id === fest);

const designs = posters
  .filter((p) => (fest ? p.fest === fest : true))
  .map((p) => {
    const id = p.file.split("/").pop().replace(/\.[^.]+$/, "");
    const num = id.match(/\d+$/)?.[0] || "";
    return { id, fest: p.fest, name: NICE[id] || `Design ${num}`, file: p.file };
  });
---
<Layout title={meta ? `${meta.name} Designs` : "Festival Posters"} description="Festival-ready, print-ready devotional poster designs.">
<div class="container-x px-4 pb-20 pt-28 sm:px-6">

  {meta ? (
    <!-- ═══ FESTIVAL DESIGNS VIEW ═══ -->
    <div>
      <div class="text-center">
        <h1 class="flex items-center justify-center gap-3 font-display text-4xl font-bold sm:text-5xl">
          {meta.img ? (
            <img src={meta.img} alt="" class="size-14 object-contain mix-blend-multiply dark:mix-blend-normal dark:rounded-2xl dark:bg-cream dark:p-1.5" />
          ) : (
            <span>{meta.icon}</span>
          )}
          <span>{meta.name} Designs</span>
        </h1>
        <p class="mt-3 text-sm text-sandal-deep/60 dark:text-cream/50">Pasand ka design chuno — Studio usi design ke saath khulega.</p>
      </div>

      <a href="/posters" class="mt-8 inline-flex items-center gap-1.5 text-sm font-bold text-saffron hover:underline">← Sab Festivals</a>

      {designs.length === 0 ? (
        <div class="mt-16 text-center">
          <p class="text-4xl">🪔</p>
          <p class="mt-3 font-display text-lg font-bold">Is festival ke designs jald aa rahe hain</p>
          <a href="/studio?view=poster" class="btn btn-primary mt-5">Studio mein banaiye →</a>
        </div>
      ) : (
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {designs.map((d) => {
            const f = FESTS.find((x) => x.id === d.fest);
            return (
              <a href={`/studio?view=poster&tpl=${d.id}`} class="group relative overflow-hidden rounded-3xl border border-sandal/10 shadow-soft transition hover:-translate-y-1 hover:shadow-lift dark:border-white/10">
                <img src={d.file} onerror={`this.onerror=null;this.src='https://picsum.photos/seed/${d.id}/480/672'`} alt={d.name} loading="lazy" class="aspect-[3/4] w-full object-cover transition duration-700 group-hover:scale-105" />
                <span class="chip absolute left-3 top-3 bg-ink/50 !px-2.5 !py-1 text-[10px] text-white backdrop-blur">
                  {f?.img ? <img src={f.img} alt="" class="inline-block size-3.5 object-contain mix-blend-screen" /> : f?.icon} {f?.name}
                </span>
                <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/90 to-transparent px-4 pb-4 pt-12">
                  <span class="block font-display text-lg font-bold text-white">{d.name}</span>
                </span>
                <span class="absolute bottom-4 right-4 grid size-9 place-items-center rounded-full bg-gradient-to-br from-saffron to-golden text-white opacity-0 shadow-gold transition group-hover:opacity-100">→</span>
              </a>
            );
          })}
        </div>
      )}
    </div>
  ) : (
    <!-- ═══ ALL FESTIVALS VIEW ═══ -->
    <div>
      <div class="text-center">
        <p class="eyebrow justify-center">Festival Posters</p>
        <h1 class="mt-3 font-display text-4xl font-bold sm:text-5xl">Posters That Devotees <span class="bg-gradient-to-r from-saffron to-golden bg-clip-text text-transparent">Frame</span></h1>
        <p class="mt-2 font-dev text-sm text-goldsoft">॥ उत्सव घोषणा ॥</p>
        <p class="mx-auto mt-3 max-w-xl text-sm text-sandal-deep/60 dark:text-cream/50">Festival chuniye — saare designs dekhiye, pasand ka click karte hi Studio usi design ke saath khulega.</p>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {FESTS.map((f) => {
          const count = posters.filter((p) => p.fest === f.id).length;
          return (
            <a href={`/posters?fest=${f.id}`} class="group card p-6 text-center shadow-soft transition hover:-translate-y-1 hover:shadow-lift">
              {f.img ? (
                <img src={f.img} alt="" class="mx-auto size-16 object-contain mix-blend-multiply transition group-hover:scale-110 dark:mix-blend-normal dark:rounded-2xl dark:bg-cream dark:p-2" />
              ) : (
                <span class="block text-5xl transition group-hover:scale-110">{f.icon}</span>
              )}
              <p class="mt-3 font-display text-lg font-bold">{f.name}</p>
              <p class="mt-1 text-xs text-sandal-deep/60 dark:text-cream/50">{count} designs</p>
            </a>
          );
        })}
      </div>
    </div>
  )}
</div>
</Layout>
---
import Layout from "../layouts/Layout.astro";
import { posters } from "../data/posters";
import { readdirSync } from "node:fs";

/* icon auto-detect: public/icons, public/images ya public mein kahin bhi "ganesh" naam ki file */
let GANESH_ICON = "";
for (const dir of ["public/icons", "public/images", "public"]) {
  try {
    const f = readdirSync(dir).find((x) => /ganesh/i.test(x) && /\.(png|jpe?g|webp|svg)$/i.test(x));
    if (f) { GANESH_ICON = "/" + dir.replace("public/", "") + "/" + f; break; }
  } catch {}
}

const FESTS = [
  { id: "ganesh", name: "Ganesh Utsav", icon: "🐘", img: GANESH_ICON },
  { id: "diwali", name: "Diwali", icon: "🪔", img: "" },
  { id: "navratri", name: "Navratri", icon: "🌺", img: "" },
  { id: "holi", name: "Holi", icon: "🎨", img: "" },
  { id: "hanuman", name: "Hanuman Jayanti", icon: "🚩", img: "" },
  { id: "swami", name: "Swami Samarth", icon: "🙏", img: "" },
  { id: "newyear", name: "New Year", icon: "🎉", img: "" },
];

const NICE: Record<string, string> = {
  "ganesh-1": "Golden Throne", "ganesh-2": "Palkhi Utsav", "ganesh-3": "Modak Blessing",
  "diwali-1": "Diya Rows", "diwali-2": "Laxmi Pujan", "diwali-3": "Fireworks Night",
  "navratri-1": "Durga Idol", "navratri-2": "Garba Night", "navratri-3": "Nine Colors",
  "holi-1": "Gulal Clouds", "holi-2": "Radha Krishna", "holi-3": "Water Splash",
  "hanuman-1": "Saffron Flag", "hanuman-2": "Chalisa Pose", "hanuman-3": "Gada Power",
  "swami-1": "Meditation", "swami-2": "Akkalkot Darbar", "swami-3": "Blessing Hand",
  "newyear-1": "Fireworks", "newyear-2": "Midnight Clock", "newyear-3": "Sunrise Garlands",
};

const fest = Astro.url.searchParams.get("fest") || "";
const meta = FESTS.find((f) => f.id === fest);

const designs = posters
  .filter((p) => (fest ? p.fest === fest : true))
  .map((p) => {
    const id = p.file.split("/").pop().replace(/\.[^.]+$/, "");
    const num = id.match(/\d+$/)?.[0] || "";
    return { id, fest: p.fest, name: NICE[id] || `Design ${num}`, file: p.file };
  });
---
<Layout title={meta ? `${meta.name} Designs` : "Festival Posters"} description="Festival-ready, print-ready devotional poster designs — pasand ka design chuno, Studio usi ke saath khulega.">
<div class="relative overflow-hidden">
  <div class="pointer-events-none absolute -left-32 top-24 h-96 w-96 rounded-full bg-saffron/10 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-32 top-1/2 h-96 w-96 rounded-full bg-golden/10 blur-3xl"></div>
  <span class="pointer-events-none absolute right-8 top-28 select-none font-dev text-[140px] text-saffron/5">ॐ</span>

  <div class="container-x relative px-4 pb-20 pt-28 sm:px-6">
    {meta ? (
      <div>
        <!-- ═══ FESTIVAL DESIGNS HEADER ═══ -->
        <div class="text-center">
          <div class="mx-auto grid size-24 place-items-center rounded-3xl border border-golden/30 bg-white/80 shadow-lift backdrop-blur-xl dark:bg-night/70">
            {meta.img ? (
              <img src={meta.img} alt="" class="size-16 object-contain" />
            ) : (
              <span class="text-5xl">{meta.icon}</span>
            )}
          </div>
          <p class="eyebrow justify-center mt-5">Festival Posters</p>
          <h1 class="mt-2 font-display text-4xl font-bold tracking-tight sm:text-5xl">{meta.name} <span class="bg-gradient-to-r from-saffron to-golden bg-clip-text text-transparent">Designs</span></h1>
          <p class="mt-2 font-dev text-sm text-goldsoft">॥ उत्सव घोषणा ॥</p>
          <p class="mx-auto mt-3 max-w-xl text-sm text-sandal-deep/60 dark:text-cream/50">Pasand ka design chuno — Studio usi design ke saath khulega. <b class="text-sandal-deep/80 dark:text-cream/70">{designs.length} designs</b> available.</p>
        </div>

        <div class="mt-8 flex justify-center">
          <a href="/posters" class="chip cursor-pointer bg-white/80 text-saffron shadow-soft backdrop-blur transition hover:-translate-y-0.5 hover:shadow-lift dark:bg-night/70">← Sab Festivals</a>
        </div>

        {designs.length === 0 ? (
          <div class="mt-16 text-center">
            <p class="text-5xl">🪔</p>
            <p class="mt-4 font-display text-xl font-bold">Is festival ke designs jald aa rahe hain</p>
            <p class="mt-1 text-sm text-sandal-deep/60 dark:text-cream/50">Tab tak dusre festivals dekhiye ya studio mein khud banaiye.</p>
            <a href="/studio?view=poster" class="btn btn-primary mt-6">Studio mein banaiye →</a>
          </div>
        ) : (
          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {designs.map((d) => {
              const f = FESTS.find((x) => x.id === d.fest);
              return (
                <a href={`/studio?view=poster&tpl=${d.id}`} class="group relative overflow-hidden rounded-3xl border border-golden/25 bg-white/80 shadow-soft backdrop-blur-xl transition duration-300 hover:-translate-y-1.5 hover:shadow-lift dark:border-golden/15 dark:bg-night/70">
                  <div class="overflow-hidden">
                    <img src={d.file} onerror={`this.onerror=null;this.src='https://picsum.photos/seed/${d.id}/480/672'`} alt={d.name} loading="lazy" class="aspect-[3/4] w-full object-cover transition duration-700 group-hover:scale-[1.06]" />
                  </div>
                  <span class="chip absolute left-3 top-3 bg-ink/50 !px-2.5 !py-1 text-[10px] text-white backdrop-blur">
                    {f?.img ? <img src={f.img} alt="" class="inline-block size-3.5 object-contain" /> : f?.icon} {f?.name}
                  </span>
                  <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/95 via-ink/40 to-transparent px-5 pb-4 pt-14">
                    <span class="block font-display text-lg font-bold text-white">{d.name}</span>
                    <span class="mt-0.5 block text-[11px] font-semibold text-goldsoft opacity-0 transition group-hover:opacity-100">Studio mein kholo →</span>
                  </span>
                  <span class="absolute right-4 top-4 grid size-9 place-items-center rounded-full bg-gradient-to-br from-saffron to-golden text-sm text-white opacity-0 shadow-gold transition duration-300 group-hover:opacity-100">→</span>
                </a>
              );
            })}
          </div>
        )}
      </div>
    ) : (
      <div>
        <!-- ═══ ALL FESTIVALS HEADER ═══ -->
        <div class="text-center">
          <p class="eyebrow justify-center">Festival Posters</p>
          <h1 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">Posters That Devotees <span class="bg-gradient-to-r from-saffron to-golden bg-clip-text text-transparent">Frame</span></h1>
          <p class="mt-2 font-dev text-sm text-goldsoft">॥ उत्सव घोषणा ॥</p>
          <p class="mx-auto mt-3 max-w-xl text-sm text-sandal-deep/60 dark:text-cream/50">From Ganesh Utsav to Navratri to Datta Jayanti — festival-ready, print-ready posters designed with the right colors, symbols, and reverence for every occasion.</p>
        </div>

        <!-- ═══ FESTIVAL CARDS ═══ -->
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {FESTS.map((f) => {
            const count = posters.filter((p) => p.fest === f.id).length;
            return (
              <a href={`/posters?fest=${f.id}`} class="group relative overflow-hidden rounded-3xl border border-golden/25 bg-white/80 p-6 text-center shadow-soft backdrop-blur-xl transition duration-300 hover:-translate-y-1.5 hover:shadow-lift dark:border-golden/15 dark:bg-night/70">
                <span class="pointer-events-none absolute -right-8 -top-8 h-28 w-28 rounded-full bg-saffron/10 blur-2xl transition duration-500 group-hover:bg-saffron/20"></span>
                {f.img ? (
                  <span class="relative mx-auto grid size-20 place-items-center rounded-3xl border border-golden/30 bg-white shadow-soft transition duration-500 group-hover:scale-110 group-hover:shadow-gold">
                    <img src={f.img} alt="" class="size-14 object-contain" />
                  </span>
                ) : (
                  <span class="relative mx-auto grid size-20 place-items-center rounded-3xl bg-gradient-to-br from-saffron to-golden text-4xl text-white shadow-gold transition duration-500 group-hover:scale-110">{f.icon}</span>
                )}
                <p class="mt-4 font-display text-lg font-bold">{f.name}</p>
                <span class="chip mt-2 bg-saffron/10 !px-2.5 !py-0.5 text-[10px] font-bold text-saffron">{count} designs</span>
                <p class="mt-3 text-[11px] font-semibold text-sandal-deep/50 opacity-0 transition group-hover:opacity-100 dark:text-cream/40">Designs dekho →</p>
              </a>
            );
          })}
        </div>

        <!-- ═══ CTA STRIP ═══ -->
        <div class="mt-12 rounded-3xl bg-gradient-to-br from-ink to-[#3a2410] p-8 text-center text-cream shadow-lift dark:from-night-soft dark:to-black">
          <p class="font-display text-xl font-bold sm:text-2xl">Apna khud ka poster chahiye? </p>
          <p class="mx-auto mt-2 max-w-md text-sm text-cream/70">Photo lagao, naam likho — 60 second mein festival poster taiyar, bilkul temple-print quality.</p>
          <a href="/studio?view=poster" class="btn btn-primary mt-5">Open Poster Studio →</a>
        </div>
      </div>
    )}
  </div>
</div>
</Layout>
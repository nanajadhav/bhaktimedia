---
import Layout from "../layouts/Layout.astro";
import { posters, isRecent } from "../data/posters";

const fest = Astro.url.searchParams.get("fest") || "all";
const FESTS = [
  { id: "all", label: "🪔 Sab Dekho" },
  { id: "ganesh", label: "Shri Ganesh" },
  { id: "swami", label: "Swami Samarth" },
  { id: "navratri", label: "Navratri" },
  { id: "diwali", label: "Deepotsav" },
  { id: "hanuman", label: "Hanuman" },
  { id: "holi", label: "Holi" },
  { id: "newyear", label: "Nava Varsh" },
];
const shown = fest === "all" ? posters : posters.filter((p) => p.fest === fest);
---
<Layout title="Festival Posters" description="Festival-ready, print-ready devotional posters — Ganesh Utsav, Navratri, Deepotsav, Hanuman Chalisa and more.">
<div class="container-x px-4 pb-20 pt-28 sm:px-6">
  <div class="text-center">
    <p class="eyebrow justify-center">Festival Posters</p>
    <h1 class="mt-3 font-display text-4xl font-bold sm:text-5xl">Posters That Devotees <span class="bg-gradient-to-r from-saffron to-golden bg-clip-text text-transparent">Frame</span></h1>
    <p class="mt-2 font-dev text-sm text-goldsoft">॥ उत्सव घोषणा ॥</p>
    <p class="mx-auto mt-3 max-w-xl text-sm text-sandal-deep/60 dark:text-cream/50">
      From Ganesh Utsav to Navratri to Datta Jayanti — festival-ready, print-ready posters designed with the right colors, symbols, and reverence for every occasion.
      <b class="text-sandal-deep/80 dark:text-cream/70">{shown.length} designs</b> available.
    </p>
  </div>

  <!-- festival tabs -->
  <div class="mt-8 flex flex-wrap justify-center gap-2">
    {FESTS.map((f) => (
      <a
        href={f.id === "all" ? "/posters" : `/posters?fest=${f.id}`}
        class={`chip cursor-pointer transition ${fest === f.id ? "bg-gradient-to-r from-saffron to-golden text-white shadow-gold" : "bg-sandal/10 text-sandal-deep hover:bg-sandal/20 dark:bg-white/5 dark:text-cream/70"}`}
      >
        {f.label}
      </a>
    ))}
  </div>

  <!-- poster masonry (natural ratios — koi cropping nahi) -->
  {shown.length === 0 ? (
    <div class="mt-16 text-center">
      <p class="text-4xl">🪔</p>
      <p class="mt-3 font-display text-lg font-bold">Is festival ke posters jald aa rahe hain</p>
      <p class="mt-1 text-sm text-sandal-deep/60 dark:text-cream/50">Tab tak dusre festivals dekhiye ya studio mein khud banaiye.</p>
      <a href="/ai-services?studio=poster" class="btn btn-primary mt-5">Open Poster Studio →</a>
    </div>
  ) : (
    <div class="mt-10 columns-2 gap-5 md:columns-3 xl:columns-4">
      {shown.map((p) => (
        <div class="group relative mb-5 break-inside-avoid overflow-hidden rounded-2xl border border-sandal/10 shadow-soft transition hover:-translate-y-1 hover:shadow-lift dark:border-white/10">
          <img
            src={p.file}
            onerror={`this.onerror=null;this.src='https://picsum.photos/seed/${p.id}/480/672'`}
            alt={p.title}
            loading="lazy"
            class="w-full h-auto transition duration-700 group-hover:scale-105"
          />
          <span class="chip absolute left-3 top-3 bg-ink/60 text-[10px] text-white backdrop-blur">Print Ready</span>
          {isRecent(p) && (
            <span class="chip absolute right-3 top-3 bg-green-500 !px-2 !py-0.5 text-[9px] font-bold text-white shadow-soft">🆕 NEW</span>
          )}
          <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/95 via-ink/50 to-transparent px-4 pb-4 pt-14">
            <span class="block font-dev text-xs text-goldsoft">{p.deity}</span>
            <span class="block font-display text-sm font-bold text-white">{p.title}</span>
            <span class="mt-3 flex flex-wrap gap-2">
              <a href={`/ai-services?studio=poster&template=${encodeURIComponent(p.file)}`} class="btn btn-primary !px-3 !py-1.5 !text-[10px]">Studio mein kholo</a>
              <a href={p.file} download class="btn btn-glass !px-3 !py-1.5 !text-[10px] !text-white">PNG ↓</a>
            </span>
          </span>
        </div>
      ))}
    </div>
  )}
</div>
</Layout>
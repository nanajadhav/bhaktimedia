---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Login" description="BhaktiMedia account mein login karo.">
<div class="container-x px-4 pt-32 pb-20 sm:px-6">
  <div class="mx-auto max-w-md">
    <div class="card p-8 shadow-lift">
      <h1 class="font-display text-2xl font-bold">🪔 Login</h1>
      <p class="mt-1 text-sm text-sandal-deep/60 dark:text-cream/50">Wapas swagat hai! Apne account mein jao.</p>
      <form id="login-form" class="mt-6 grid gap-4">
        <label class="block text-sm font-semibold">Email
          <input id="email" type="email" required class="input mt-1.5" placeholder="you@example.com" />
        </label>
        <label class="block text-sm font-semibold">Password
          <input id="password" type="password" required class="input mt-1.5" placeholder="••••••••" />
        </label>
        <p id="err" class="hidden rounded-xl bg-red-500/10 px-4 py-2 text-sm font-semibold text-red-600"></p>
        <button class="btn btn-primary w-full justify-center" type="submit">Login →</button>
      </form>
      <p class="mt-4 text-center text-sm">Naya account? <a href="/signup" class="font-semibold text-saffron hover:underline">Signup karo</a></p>
    </div>
  </div>
</div>
<script is:inline>
document.getElementById("login-form").addEventListener("submit", async (e) => {
  e.preventDefault();
  const err = document.getElementById("err");
  err.classList.add("hidden");
  const btn = e.target.querySelector("button[type=submit]");
  btn.disabled = true; btn.textContent = "Login ho raha hai...";
  try {
    const r = await fetch("/api/auth/login", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: document.getElementById("email").value, password: document.getElementById("password").value }),
    });
    const d = await r.json();
    if (!r.ok || !d.token) throw new Error(d.error || "Login fail");
    localStorage.setItem("sb-bm-auth-token", JSON.stringify({
      access_token: d.token,
      user: { id: d.user.id, email: d.user.email, user_metadata: { name: d.user.name } },
    }));
    localStorage.setItem("bm-welcome", "🪔 Wapas swagat hai, " + d.user.name + "!");
    location.href = "/studio";
  } catch (ex) {
    err.textContent = ex.message; err.classList.remove("hidden");
    btn.disabled = false; btn.textContent = "Login →";
  }
});
</script>
</Layout>
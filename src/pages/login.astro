---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Login" description="BhaktiMedia account mein login karo.">
  <section class="section">
    <div class="container-x max-w-md">
      <div class="card p-8">
        <div class="text-center">
          <span class="text-4xl">🪔</span>
          <h1 class="mt-3 font-display text-2xl font-bold">Wapas Swagat Hai</h1>
          <p class="mt-2 text-sm text-sandal-deep/70 dark:text-cream/60">Login karo — apni seva jaari rakho</p>
        </div>

        <form id="login-form" class="mt-6 space-y-4">
          <div>
            <label class="mb-1 block text-xs font-semibold" for="email">Email</label>
            <input id="email" type="email" required placeholder="aap@email.com"
              class="w-full rounded-xl border border-golden/30 bg-white/70 px-4 py-3 text-sm outline-none transition focus:border-saffron dark:bg-ink/60 dark:text-cream" />
          </div>
          <div>
            <label class="mb-1 block text-xs font-semibold" for="password">Password</label>
            <input id="password" type="password" required placeholder="Password"
              class="w-full rounded-xl border border-golden/30 bg-white/70 px-4 py-3 text-sm outline-none transition focus:border-saffron dark:bg-ink/60 dark:text-cream" />
          </div>
          <button type="submit" class="btn btn-primary w-full justify-center">Login </button>
          <p id="msg" class="text-center text-sm text-red-500"></p>
        </form>

        <p class="mt-4 text-center text-sm">
          Naya account? <a href="/signup" class="font-semibold text-saffron hover:underline">Sign up karo</a>
        </p>
      </div>
    </div>
  </section>

  <script>
    import { supabase } from "../lib/supabase";

    const form = document.getElementById("login-form") as HTMLFormElement;
    const msg = document.getElementById("msg") as HTMLParagraphElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      msg.textContent = "";

      const email = (document.getElementById("email") as HTMLInputElement).value.trim();
      const password = (document.getElementById("password") as HTMLInputElement).value;

      const { error } = await supabase.auth.signInWithPassword({ email, password });

      if (error) {
        msg.textContent = "Email ya password galat hai";
        return;
      }

      window.location.href = "/";
    });
  </script>
</Layout>
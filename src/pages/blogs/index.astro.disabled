---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Blog" description="Blog coming soon">
  <section class="section">
    <div class="container-x max-w-2xl text-center">
      <span class="text-6xl">📝</span>
      <h1 class="mt-6 font-display text-3xl font-bold">Blog Launching Soon</h1>
      <p class="mt-4 text-sandal-deep/75 dark:text-cream/65">
        Devotional design, temple tech aur AI creativity par articles jald aa rahe hain.
      </p>
      <a href="/" class="btn btn-primary mt-8 inline-flex">← Back to Home</a>
    </div>
  </section>
</Layout>
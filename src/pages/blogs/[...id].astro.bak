---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title } = post.data;
---

<Layout title={title} description="Blog coming soon">
  <section class="section">
    <div class="container-x max-w-2xl text-center">
      <span class="text-6xl">🪔</span>
      <h1 class="mt-6 font-display text-3xl font-bold">Blog Coming Soon</h1>
      <p class="mt-4 text-sandal-deep/75 dark:text-cream/65">
        Hum abhi articles polish kar rahe hain. Jaldi hi divine wisdom yahan aayegi!
      </p>
      <a href="/" class="btn btn-primary mt-8 inline-flex">← Back to Home</a>
    </div>
  </section>
</Layout>
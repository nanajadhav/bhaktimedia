---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection } from "astro:content";
import { picsum } from "../../lib/utils";

const posts = (await getCollection("blog")).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const [featured, ...rest] = posts;

const readTime = (body) => Math.ceil(body.split(/\s+/).length / 200);
const fmtDate = (d) => d.toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" });
---
<Layout title="Blog" description="Wisdom, tutorials and devotional insights from BhaktiMedia.">
  <PageHeader eyebrow="Blog" title="Wisdom & Insights" dev="॥ ज्ञानदीपः ॥"
    description="Devotional design, temple tech aur AI creativity par articles." />

  <section class="section !pt-4">
    <div class="container-x">
      <!-- featured -->
      {featured && (
        <a href={`/blogs/${featured.id}`} class="card group grid overflow-hidden md:grid-cols-2">
          <img src={featured.data.image || picsum(`blog-${featured.id}`, 800, 600)} alt="" class="aspect-video w-full object-cover transition duration-700 group-hover:scale-105 md:aspect-auto" />
          <div class="p-8">
            <span class="chip bg-saffron/10 font-semibold text-saffron">⭐ Featured</span>
            <span class="ml-2 chip bg-golden/15">{featured.data.category}</span>
            <h2 class="mt-4 font-display text-2xl font-bold leading-tight transition group-hover:text-saffron md:text-3xl">{featured.data.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-sandal-deep/75 dark:text-cream/65">{featured.data.description}</p>
            <p class="mt-4 text-xs text-sandal/60">{fmtDate(featured.data.pubDate)} • {readTime(featured.body)} min read</p>
          </div>
        </a>
      )}

      <!-- grid -->
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((p, i) => (
          <a data-reveal style={`--rd:${(i % 3) * 100}ms`} href={`/blogs/${p.id}`} class="card group overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-lift">
            <img src={p.data.image || picsum(`blog-${p.id}`, 640, 360)} alt="" loading="lazy" class="aspect-video w-full object-cover transition duration-700 group-hover:scale-105" />
            <div class="p-5">
              <span class="chip bg-golden/15 text-[11px]">{p.data.category}</span>
              <h3 class="mt-2 font-display font-semibold leading-snug transition group-hover:text-saffron">{p.data.title}</h3>
              <p class="mt-2 line-clamp-2 text-sm text-sandal-deep/75 dark:text-cream/65">{p.data.description}</p>
              <p class="mt-3 text-xs text-sandal/60">{fmtDate(p.data.pubDate)} • {readTime(p.body)} min</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const els = document.querySelectorAll("[data-reveal]");
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } }), { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
      els.forEach((el) => io.observe(el));
    })();
  </script>
</Layout>
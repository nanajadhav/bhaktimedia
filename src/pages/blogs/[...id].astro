---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { picsum } from "../../lib/utils";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((p) => ({ params: { id: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, pubDate, image, author, category } = post.data;
const related = (await getCollection("blog"))
  .filter((p) => p.id !== post.id && p.data.category === category)
  .slice(0, 3);

const readTime = Math.ceil(post.body.split(/\s+/).length / 200);

const icons = {
  calendar: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>',
  clock: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
  arrowLeft: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>',
  share: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>',
};

const fmtDate = (d) => d.toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" });
---
<Layout title={title} description={description}>
  <article class="section !pt-8">
    <div class="container-x max-w-4xl">
      <a href="/blogs" class="inline-flex items-center gap-2 text-sm font-semibold text-saffron hover:gap-3 transition-all">
        <span set:html={icons.arrowLeft} /> All Articles
      </a>

      <img src={image || picsum(`blog-${post.id}`, 1200, 600)} alt={title} class="mt-6 aspect-video w-full rounded-3xl object-cover shadow-lift" />

      <div class="mt-8 flex flex-wrap items-center gap-3 text-sm text-sandal/70 dark:text-cream/60">
        <span class="chip bg-saffron/10 font-semibold text-saffron">{category}</span>
        <span class="flex items-center gap-1"><span set:html={icons.calendar} /> {fmtDate(pubDate)}</span>
        <span class="flex items-center gap-1"><span set:html={icons.clock} /> {readTime} min read</span>
        {author && <span class="text-sandal/60">• {author}</span>}
      </div>

      <h1 class="mt-4 font-display text-3xl font-bold leading-tight tracking-tight sm:text-5xl">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-sandal-deep/80 dark:text-cream/70">{description}</p>

      <div class="prose prose-lg mt-10 max-w-none dark:prose-invert prose-headings:font-display prose-headings:font-bold prose-a:text-saffron prose-a:no-underline hover:prose-a:underline">
        <Content />
      </div>

      <div class="mt-12 flex items-center justify-between border-y border-golden/20 py-5">
        <p class="font-display text-sm font-semibold">Share this article</p>
        <button onclick="navigator.share({title, url: location.href}).catch(()=>navigator.clipboard.writeText(location.href))" class="btn btn-ghost !py-2 !text-xs">
          <span set:html={icons.share} /> Share / Copy Link
        </button>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section">
      <div class="container-x">
        <h2 class="font-display text-2xl font-bold">Read More</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {related.map((r) => (
            <a href={`/blogs/${r.id}`} class="card group overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-lift">
              <img src={r.data.image || picsum(`blog-${r.id}`, 640, 360)} alt="" loading="lazy" class="aspect-video w-full object-cover transition duration-700 group-hover:scale-105" />
              <div class="p-5">
                <span class="chip bg-golden/15 text-[11px]">{r.data.category}</span>
                <h3 class="mt-2 font-display font-semibold leading-snug transition group-hover:text-saffron">{r.data.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
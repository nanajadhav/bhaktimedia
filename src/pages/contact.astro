---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
---
<Layout title="Contact" description="BhaktiMedia se sampark karo — support, billing, template requests.">
  <PageHeader eyebrow="Contact" title="Sampark Karo" dev="॥ संपर्क ॥"
    description="Sawaal, sujhav ya madad — hum 24 ghante mein jawab dete hain." />

  <section class="section !pt-4">
    <div class="container-x grid gap-6 lg:grid-cols-[1fr,360px]">
      <!-- ═══ FORM ═══ -->
      <div class="card p-6 shadow-soft sm:p-8">
        <p class="eyebrow">📬 Message Bhejo</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <label class="block text-sm font-semibold">Naam
            <input id="ct-name" class="input mt-1.5" placeholder="Aapka naam" />
          </label>
          <label class="block text-sm font-semibold">Email
            <input id="ct-email" type="email" class="input mt-1.5" placeholder="aap@email.com" />
          </label>
        </div>
        <label class="mt-4 block text-sm font-semibold">Topic
          <select id="ct-topic" class="input mt-1.5">
            <option>General</option>
            <option>Support</option>
            <option>Billing / Payment</option>
            <option>Template Request</option>
            <option>Murti Collection</option>
          </select>
        </label>
        <label class="mt-4 block text-sm font-semibold">Message
          <textarea id="ct-msg" rows="5" class="input mt-1.5 resize-y" placeholder="Aapka sawaal ya sujhav..."></textarea>
        </label>
        <p id="ct-err" class="mt-3 hidden rounded-xl bg-red-500/10 px-4 py-2.5 text-sm font-semibold text-red-500"></p>
        <p id="ct-ok" class="mt-3 hidden rounded-xl bg-green-500/10 px-4 py-2.5 text-sm font-semibold text-green-600">✅ Message bhej diya! 24 ghante mein jawab milega — confirmation email bhi aaya hai 📧</p>
        <button id="ct-go" class="btn btn-primary mt-5 w-full !py-3">📨 Message Bhejo</button>
      </div>

      <!-- ═══ INFO ═══ -->
      <div class="grid gap-5 content-start">
        <div class="card p-6 shadow-soft">
          <p class="eyebrow">📧 Email</p>
          <a href="mailto:support@bhaktimedia.in" class="mt-2 block font-semibold text-saffron underline">support@bhaktimedia.in</a>
          <p class="mt-1 text-xs text-sandal-deep/60 dark:text-cream/50">Billing: billing@bhaktimedia.in</p>
        </div>
        <div class="card p-6 shadow-soft">
          <p class="eyebrow">📱 WhatsApp</p>
          <a id="ct-wa" href="#" target="_blank" class="mt-2 block font-semibold text-saffron underline">WhatsApp par baat karo</a>
          <p class="mt-1 text-xs text-sandal-deep/60 dark:text-cream/50">Growth/Scale members ke liye priority support</p>
        </div>
        <div class="card p-6 shadow-soft">
          <p class="eyebrow">⏰ Response Time</p>
          <p class="mt-2 text-sm text-sandal-deep/70 dark:text-cream/60">General: 24 ghante • Billing: 12 ghante • Scale plan: 2 ghante</p>
        </div>
      </div>
    </div>
  </section>

<script is:inline>
(function () {
  const $ = (s) => document.querySelector(s);
  const WA = "919822010800"; // ← apna WhatsApp number yahan
  $("#ct-wa").href = "https://wa.me/" + WA + "?text=" + encodeURIComponent("Namaste! Mujhe BhaktiMedia ke baare mein madad chahiye.");
  function show(id, m) {
    const e = $(id);
    if (!m) { e.classList.add("hidden"); return; }
    e.textContent = m; e.classList.remove("hidden");
  }
  $("#ct-go").addEventListener("click", async () => {
    show("#ct-err", ""); show("#ct-ok", "");
    const name = $("#ct-name").value.trim();
    const email = $("#ct-email").value.trim();
    const message = $("#ct-msg").value.trim();
    if (name.length < 2) return show("#ct-err", "Naam sahi bharo");
    if (!/^\S+@\S+\.\S+$/.test(email)) return show("#ct-err", "Email sahi nahi hai");
    if (message.length < 10) return show("#ct-err", "Message thoda detail mein likho (kam se kam 10 characters)");
    const b = $("#ct-go");
    b.disabled = true; b.textContent = "⏳ Bhej rahe hain...";
    try {
      const r = await fetch("/api/contact", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name, email, topic: $("#ct-topic").value, message }) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error || "Fail");
      show("#ct-ok", "x"); $("#ct-ok").classList.remove("hidden");
      $("#ct-name").value = ""; $("#ct-email").value = ""; $("#ct-msg").value = "";
    } catch (e) { show("#ct-err", "❌ " + e.message); }
    finally { b.disabled = false; b.textContent = "📨 Message Bhejo"; }
  });
})();
</script>
</Layout>
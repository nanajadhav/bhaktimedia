---
import Layout from "../layouts/Layout.astro";
const FESTS = [
  { id: "ganesh", name: "Ganesh Utsav", icon: "🐘" },
  { id: "diwali", name: "Diwali", icon: "🪔" },
  { id: "navratri", name: "Navratri", icon: "🌺" },
  { id: "holi", name: "Holi", icon: "🎨" },
  { id: "hanuman", name: "Hanuman Jayanti", icon: "🚩" },
  { id: "swami", name: "Swami Samarth", icon: "🙏" },
  { id: "newyear", name: "New Year", icon: "🎉" },
];
const DESIGNS = [
  { id: "ganesh-1", fest: "ganesh", name: "Golden Throne", seed: "ganesh-golden-throne" },
  { id: "ganesh-2", fest: "ganesh", name: "Palkhi Utsav", seed: "ganesh-palkhi-procession" },
  { id: "ganesh-3", fest: "ganesh", name: "Modak Blessing", seed: "ganesh-modak-soft" },
  { id: "diwali-1", fest: "diwali", name: "Diya Rows", seed: "diwali-diya-rows" },
  { id: "diwali-2", fest: "diwali", name: "Laxmi Pujan", seed: "diwali-laxmi-altar" },
  { id: "diwali-3", fest: "diwali", name: "Fireworks Night", seed: "diwali-fireworks-kandil" },
  { id: "navratri-1", fest: "navratri", name: "Durga Idol", seed: "navratri-durga-idol" },
  { id: "navratri-2", fest: "navratri", name: "Garba Night", seed: "navratri-garba-dandiya" },
  { id: "navratri-3", fest: "navratri", name: "Nine Colors", seed: "navratri-nine-colors" },
  { id: "holi-1", fest: "holi", name: "Gulal Clouds", seed: "holi-gulal-clouds" },
  { id: "holi-2", fest: "holi", name: "Radha Krishna", seed: "holi-radha-krishna" },
  { id: "holi-3", fest: "holi", name: "Water Splash", seed: "holi-water-splash" },
  { id: "hanuman-1", fest: "hanuman", name: "Saffron Flag", seed: "hanuman-saffron-flag" },
  { id: "hanuman-2", fest: "hanuman", name: "Chalisa Pose", seed: "hanuman-chalisa-pose" },
  { id: "hanuman-3", fest: "hanuman", name: "Gada Power", seed: "hanuman-gada-power" },
  { id: "swami-1", fest: "swami", name: "Meditation", seed: "swami-meditation-peace" },
  { id: "swami-2", fest: "swami", name: "Akkalkot Darbar", seed: "swami-akkalkot-darbar" },
  { id: "swami-3", fest: "swami", name: "Blessing Hand", seed: "swami-blessing-hand" },
  { id: "newyear-1", fest: "newyear", name: "Fireworks", seed: "newyear-fireworks-gold" },
  { id: "newyear-2", fest: "newyear", name: "Midnight Clock", seed: "newyear-midnight-clock" },
  { id: "newyear-3", fest: "newyear", name: "Sunrise Garlands", seed: "newyear-sunrise-garland" },
];
const tools = [
  { icon: "🖼️", label: "Image Generation", href: "/studio?view=image", live: true },
  { icon: "🎨", label: "Poster Generation", href: "/studio?view=poster", live: true },
  { icon: "🎙️", label: "Voice Studio", href: "", live: false },
  { icon: "🎬", label: "Video Generation", href: "", live: false },
];
---
<Layout title="AI Services" description="BhaktiMedia Studio — images, posters, voice, video.">
<div class="mx-auto flex max-w-[1400px] gap-6 px-4 pt-24 sm:px-6">

  <!-- ══ FIREFLY-STYLE SIDEBAR (desktop) ══ -->
  <aside class="sticky top-24 hidden w-60 shrink-0 self-start lg:block">
    <nav class="card p-3 shadow-soft">
      <p class="px-3 pb-2 pt-1 text-[11px] font-bold uppercase tracking-wider text-sandal-deep/50 dark:text-cream/40">Studio Tools</p>
      <a href="/ai-services" class="flex items-center gap-3 rounded-xl bg-saffron/10 px-3 py-2.5 text-sm font-semibold text-saffron">
        <span class="text-lg">🏠</span> Home
      </a>
      {tools.map((t) =>
        t.live ? (
          <a href={t.href} class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-sandal-deep/80 transition hover:bg-saffron/10 hover:text-saffron dark:text-cream/70">
            <span class="text-lg">{t.icon}</span> {t.label}
            <span class="ml-auto size-2 rounded-full bg-green-500" title="Live"></span>
          </a>
        ) : (
          <span class="flex cursor-not-allowed items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-sandal-deep/40 dark:text-cream/30" title="Jald aa raha hai">
            <span class="text-lg opacity-60">{t.icon}</span> {t.label}
            <span class="ml-auto text-xs">🔒</span>
          </span>
        )
      )}
      <div class="mt-3 rounded-2xl bg-gradient-to-br from-saffron to-golden p-4 text-white shadow-gold">
        <p class="text-sm font-bold">🪔 3 Free Credits</p>
        <p class="mt-1 text-xs leading-snug text-white/85">Sign up and start generating now!</p>
        <a href="/signup" class="mt-3 block rounded-full bg-white/20 px-3 py-1.5 text-center text-xs font-bold backdrop-blur transition hover:bg-white/30">Get Started →</a>
      </div>
    </nav>
  </aside>

  <!-- ══ MAIN ══ -->
  <main class="min-w-0 flex-1 pb-16">
    <!-- mobile chips -->
    <div class="mb-5 flex gap-2 overflow-x-auto pb-1 lg:hidden">
      <a href="/ai-services" class="chip shrink-0 !bg-saffron !text-white">🏠 Home</a>
      {tools.map((t) =>
        t.live ? (
          <a href={t.href} class="chip shrink-0">{t.icon} {t.label}</a>
        ) : (
          <span class="chip shrink-0 opacity-50">{t.icon} {t.label} 🔒</span>
        )
      )}
    </div>

    <!-- hero -->
    <div class="relative overflow-hidden rounded-[2.5rem] shadow-lift">
      <img src="https://picsum.photos/seed/temple-golden-sunrise/1600/700" alt="" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/95 via-ink/45 to-ink/15"></div>
      <div class="relative flex min-h-[380px] flex-col items-center justify-center px-6 py-14 text-center sm:min-h-[440px]">
        <p class="eyebrow !text-golden">BhaktiMedia Engine ⚡</p>
        <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-6xl">Divine Studio</h1>
        <p class="mt-4 max-w-xl text-white/85">Turn devotion into design — create posters, images, and more in seconds.</p>
        <div class="mt-8 grid w-full max-w-lg gap-3 sm:grid-cols-2">
          <a href="/studio?view=image" class="flex items-center justify-center gap-3 rounded-2xl border border-white/25 bg-white/15 px-6 py-4 font-semibold text-white backdrop-blur-md transition hover:bg-white/25">
            <span class="text-xl">🖼️</span> Generate Image
          </a>
          <a href="/posters" class="flex items-center justify-center gap-3 rounded-2xl border border-white/25 bg-white/15 px-6 py-4 font-semibold text-white backdrop-blur-md transition hover:bg-white/25">
            <span class="text-xl">🎨</span> Create Poster
          </a>
        </div>
      </div>
    </div>

    <!-- get inspired -->
    <div class="pt-14">
      <h2 class="font-display text-3xl font-bold">Get inspired</h2>
      <p class="mt-2 text-sandal-deep/60 dark:text-cream/50">Curated templates by the BhaktiMedia team — click your favorite card, and Studio will open with that design.</p>
      <div id="insp-chips" class="mt-6 flex flex-wrap gap-2">
        <button data-f="all" class="filter-btn !bg-saffron !text-white">✨ Trending</button>
        {FESTS.map((f) => (
          <button data-f={f.id} class="filter-btn">{f.icon} {f.name}</button>
        ))}
      </div>
      <div id="insp-grid" class="mt-8 grid gap-5 sm:grid-cols-3 xl:grid-cols-4">
        {DESIGNS.map((d) => (
          <a href={`/studio?view=poster&tpl=${d.id}`} data-f={d.fest} class="insp-card group relative overflow-hidden rounded-2xl shadow-soft transition duration-500 hover:-translate-y-1 hover:shadow-lift">
            <img src={`/templates/${d.fest}/${d.id}.png`} onerror={`this.onerror=null;this.src='https://picsum.photos/seed/${d.seed}/480/600'`} alt={d.name} class="aspect-[4/5] w-full object-cover transition duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-transparent to-transparent opacity-0 transition duration-300 group-hover:opacity-100"></div>
            <span class="absolute bottom-3 left-3 translate-y-2 text-sm font-semibold text-white opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100">{d.name} →</span>
          </a>
        ))}
      </div>
    </div>
  </main>
</div>
<script is:inline>
(function () {
  document.querySelectorAll("#insp-chips [data-f]").forEach((b) => {
    b.addEventListener("click", () => {
      document.querySelectorAll("#insp-chips [data-f]").forEach((x) => x.classList.remove("!bg-saffron", "!text-white"));
      b.classList.add("!bg-saffron", "!text-white");
      const f = b.dataset.f;
      document.querySelectorAll("#insp-grid .insp-card").forEach((c) => {
        c.style.display = f === "all" || c.dataset.f === f ? "" : "none";
      });
    });
  });
})();
</script>
</Layout>
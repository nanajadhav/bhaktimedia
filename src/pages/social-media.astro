---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { picsum } from "../lib/utils";

const industries = [
  { icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>', t: "Temples & Spiritual", d: "Hamari jadein — aarti streams, utsav campaigns, devotee community." },
  { icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>', t: "Restaurants & Cafés", d: "Food reels, menu drops, GBP optimization aur footfall campaigns." },
  { icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>', t: "Retail & Local Shops", d: "Festival offers, WhatsApp broadcasts aur local-targeted ads." },
  { icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>', t: "Startups & SaaS", d: "LinkedIn thought-leadership, launch campaigns aur demo shorts." },
  { icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>', t: "Personal Brands", d: "Coaches, doctors, creators — authority content aur audience growth." },
  { icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>', t: "Events & Weddings", d: "Pre-event hype, live coverage aur aftermovies jo share hote rahein." },
];

const platforms = [
  { icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>', t: "Instagram", d: "Reels, carousels, stories" },
  { icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>', t: "YouTube", d: "Shorts, live, SEO" },
  { icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>', t: "Facebook", d: "Community, local ads" },
  { icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>', t: "WhatsApp", d: "Broadcast, catalogs" },
  { icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>', t: "LinkedIn", d: "B2B authority" },
  { icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>', t: "Google Business", d: "Reviews, local SEO" },
];

const doList = [
  { icon: "📅", t: "Content Calendars", d: "30-din ka planned calendar — festival aur trend hooks ke saath." },
  { icon: "🎬", t: "Reels & Shorts Production", d: "Hook → story → CTA, retention-engineered vertical videos." },
  { icon: "📢", t: "Meta & Google Ads", d: "Local targeting, retargeting aur lead campaigns — ROI focus." },
  { icon: "🤝", t: "Community Management", d: "Comments, DMs aur reviews — 24 hrs ke andar response SOP." },
  { icon: "📊", t: "Monthly Analytics", d: "Kya chala, kya nahi — clear Hindi/English growth report." },
  { icon: "✨", t: "Branding & Creatives", d: "Templates, highlights covers aur ad creatives — on-brand." },
];

const weeks = [
  { t: "Audit & Strategy", d: "Accounts audit, competitor scan, audience research aur 3 content pillars lock." },
  { t: "Content Engine", d: "Batch shooting, design templates, caption bank aur 30-din ka calendar ready." },
  { t: "Launch + Amplify", d: "Daily posting shuru, ads live, WhatsApp funnel aur community SOP active." },
  { t: "Optimize + Report", d: "Hooks A/B test, retargeting, best performers scale — full growth report." },
];

const cases = [
  { seed: "case-temple-channel", tag: "🛕 Temple Channel", metric: "8K → 240K", sub: "subscribers in 14 months", d: "Aarti shorts strategy + consistent live schedule ne channel ko regional trend list mein pahunchaya." },
  { seed: "case-cafe-reels", tag: "☕ Café • Pune", metric: "2.1M views", sub: "single reel, 40x reach", d: "UGC-style food reels + Google Business optimization — weekend queue ab normal hai." },
  { seed: "case-boutique-ads", tag: "👗 Boutique", metric: "3x walk-ins", sub: "via Meta ads in 60 days", d: "Festival collection campaigns + retargeting — ad spend har mahine 4.2x wapas laya." },
];

const packs = [
  { name: "Starter", price: "7,999", feats: ["12 posts + 4 reels / month", "1 platform management", "Caption + hashtag bank", "Monthly report", "WhatsApp support"] },
  { name: "Growth", price: "14,999", featured: true, feats: ["20 posts + 8 reels / month", "3 platforms management", "Ad management (₹10K spend tak)", "Community management", "Bi-weekly reports"] },
  { name: "Scale", price: "29,999", feats: ["5 platforms + GBP", "Unlimited creatives*", "Influencer collabs", "Dedicated manager", "Weekly strategy calls"] },
];
---
<Layout title="Social Media Marketing" description="From temples to brands — social media management, ads aur growth.">
  <PageHeader eyebrow="Social Media Marketing" title="From Temples to Brands — Content That Connects" dev="॥ प्रचारः सेवायाम् ॥"
    description="Devotional audiences duniya ki sabse loyal communities hain. Wahi trust-building, wahi storytelling — ab aapke business ke liye." />

  <!-- why us -->
  <section class="section !pt-6">
    <div class="container-x grid gap-5 md:grid-cols-3">
      {[{ i: "🪔", t: "Daily Content Discipline", d: "Roz ki aarti = roz ka content. Hum consistency ko system se chalate hain." },
        { i: "🎉", t: "Festival = Campaign Thinking", d: "Diwali jaisa utsav plan karna hi product launch plan karna seekhata hai." },
        { i: "🤲", t: "Community Ka Bharosa", d: "Devotee comments handle karna sikhaya: tone, respect aur speed." }].map((x, i) => (
        <div data-reveal style={`--rd:${i * 100}ms`} class="card p-7 text-center">
          <span class="text-3xl">{x.i}</span>
          <h3 class="mt-3 font-display text-lg font-bold">{x.t}</h3>
          <p class="mt-2 text-sm text-sandal-deep/75 dark:text-cream/65">{x.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- industries -->
  <section class="section bg-cream/60 dark:bg-night-soft/30">
    <div class="container-x">
      <header data-reveal class="mx-auto max-w-2xl text-center">
        <p class="eyebrow justify-center">Industries We Serve</p>
        <h2 class="mt-4 font-display text-3xl font-bold tracking-tight sm:text-4xl">Har Business, <span class="text-gradient">Ek Hi Standard</span></h2>
      </header>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {industries.map((x, i) => (
          <div data-reveal style={`--rd:${(i % 3) * 90}ms`} class="card group p-6 transition duration-300 hover:-translate-y-1 hover:border-saffron/40 hover:shadow-glow">
            <span class="grid size-11 place-items-center rounded-xl bg-gradient-to-br from-saffron to-golden text-white shadow-gold transition group-hover:scale-110"><span set:html={x.icon} /></span>
            <h3 class="mt-4 font-display text-lg font-bold">{x.t}</h3>
            <p class="mt-2 text-sm text-sandal-deep/75 dark:text-cream/65">{x.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- platforms + services -->
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div data-reveal>
        <p class="eyebrow">Platforms</p>
        <h2 class="mt-4 font-display text-3xl font-bold">Jahan Aapki Audience Hai</h2>
        <div class="mt-8 grid grid-cols-2 gap-4">
          {platforms.map((p) => (
            <div class="card flex items-center gap-3 p-4">
              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-saffron/10 text-saffron"><span set:html={p.icon} /></span>
              <span><span class="block text-sm font-bold">{p.t}</span><span class="block text-xs text-sandal/70 dark:text-cream/50">{p.d}</span></span>
            </div>
          ))}
        </div>
      </div>
      <div data-reveal style="--rd:150ms">
        <p class="eyebrow">What We Do</p>
        <h2 class="mt-4 font-display text-3xl font-bold">Full-Funnel Management</h2>
        <ul class="mt-8 space-y-4">
          {doList.map((x) => (
            <li class="card flex gap-4 p-5">
              <span class="text-2xl">{x.icon}</span>
              <span><span class="block font-display font-bold">{x.t}</span><span class="mt-1 block text-sm text-sandal-deep/75 dark:text-cream/65">{x.d}</span></span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 30-day sprint -->
  <section class="section bg-ink text-cream">
    <div class="container-x">
      <header data-reveal class="max-w-2xl">
        <p class="eyebrow">The 30-Day Growth Sprint</p>
        <h2 class="mt-4 font-display text-3xl font-bold sm:text-4xl">Pehla Mahina, <span class="text-gradient">System Se</span></h2>
      </header>
      <ol class="relative mt-14 space-y-12 border-l-2 border-golden/30 pl-10">
        {weeks.map((w, i) => (
          <li data-reveal style={`--rd:${i * 110}ms`} class="relative">
            <span class="absolute -left-[51px] grid size-6 place-items-center rounded-full bg-gradient-to-br from-saffron to-golden text-[10px] font-bold text-white ring-4 ring-ink">{i + 1}</span>
            <p class="text-xs uppercase tracking-[0.25em] text-goldsoft/80">Week {i + 1}</p>
            <h3 class="mt-1 font-display text-xl font-bold">{w.t}</h3>
            <p class="mt-2 max-w-2xl text-sm text-cream/70">{w.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- case studies -->
  <section class="section">
    <div class="container-x">
      <header data-reveal class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">Results</p>
          <h2 class="mt-4 font-display text-3xl font-bold sm:text-4xl">Numbers Jo <span class="text-gradient">Bolte Hain</span></h2>
        </div>
        <p class="text-xs text-sandal/60 dark:text-cream/40">* Sample case studies — aapka result next yahan hoga 🙏</p>
      </header>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {cases.map((c, i) => (
          <article data-reveal style={`--rd:${i * 110}ms`} class="card group overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-lift">
            <div class="relative overflow-hidden">
              <img src={picsum(c.seed, 640, 360)} alt="" loading="lazy" class="aspect-video w-full object-cover transition duration-700 group-hover:scale-105" />
              <span class="chip absolute left-3 top-3 bg-ink/70 text-white backdrop-blur">{c.tag}</span>
            </div>
            <div class="p-6">
              <p class="font-display text-3xl font-bold text-gradient">{c.metric}</p>
              <p class="text-xs uppercase tracking-widest text-sandal/60 dark:text-cream/50">{c.sub}</p>
              <p class="mt-3 text-sm text-sandal-deep/75 dark:text-cream/65">{c.d}</p>
            </div>
          </article>
        ))}
      </div>

      <!-- stats -->
      <div class="mt-16 grid grid-cols-2 gap-8 rounded-3xl border border-golden/20 bg-cream/60 p-10 text-center dark:bg-night-soft/40 lg:grid-cols-4">
        {[{ v: 40, s: "+", l: "Accounts Managed" }, { v: 120, s: "M+", l: "Impressions Delivered" }, { v: 3, s: "x", l: "Avg. Engagement Lift" }, { v: 2, s: "Cr+", p: "₹", l: "Ad Spend Managed" }].map((st, i) => (
          <div data-reveal style={`--rd:${i * 90}ms`}>
            <p class="font-display text-4xl font-bold text-gradient"><span>{st.p || ""}</span><span data-count={st.v} data-suffix={st.s}>0</span></p>
            <p class="mt-2 text-xs uppercase tracking-[0.2em] text-sandal/60 dark:text-cream/50">{st.l}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- pricing -->
  <section class="section bg-cream/50 dark:bg-night-soft/30">
    <div class="container-x">
      <header data-reveal class="mx-auto max-w-2xl text-center">
        <p class="eyebrow justify-center">Monthly Packs</p>
        <h2 class="mt-4 font-display text-3xl font-bold sm:text-4xl">Chuniye Apna <span class="text-gradient">Growth Pack</span></h2>
      </header>
      <div class="mt-14 grid items-stretch gap-8 lg:grid-cols-3">
        {packs.map((p, i) => (
          <article data-reveal style={`--rd:${i * 120}ms`} class:list={["relative flex flex-col", p.featured ? "bg-gradient-to-b from-saffron to-golden p-[2px] shadow-glow lg:-translate-y-4" : "card"]}>
            <div class:list={["flex h-full flex-col p-8", p.featured && "rounded-[calc(1.5rem-2px)] bg-temple dark:bg-night"]}>
              {p.featured && <span class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-gradient-to-r from-saffron to-golden px-4 py-1.5 text-xs font-bold text-white shadow-gold">Most Popular 🚀</span>}
              <h3 class="font-display text-2xl font-bold">{p.name}</h3>
              <p class="mt-4 font-display"><span class="text-4xl font-bold">₹{p.price}</span><span class="text-sm text-sandal/70 dark:text-cream/50"> /month</span></p>
              <ul class="mt-6 grid flex-1 gap-2.5 text-sm">
                {p.feats.map((f) => <li class="flex items-start gap-2 text-sandal-deep/85 dark:text-cream/75">✦ {f}</li>)}
              </ul>
              <a href="/contact" class:list={["btn mt-7 w-full", p.featured ? "btn-primary" : "btn-ghost"]}>Start {p.name}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section !pt-4">
    <div class="container-x">
      <div data-reveal class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-saffron via-saffron-deep to-sandal px-6 py-14 text-center text-white shadow-lift md:py-18">
        <h2 class="relative font-display text-3xl font-bold md:text-5xl">Free Social Audit Book Karo</h2>
        <p class="relative mx-auto mt-4 max-w-xl text-white/85">15-minute call mein hum aapke accounts ka audit + 3 quick wins denge — bilkul free.</p>
        <div class="relative mt-8 flex flex-wrap justify-center gap-3">
          <a href="/contact" class="btn bg-white text-saffron-deep shadow-lift hover:-translate-y-0.5">Book Free Audit</a>
          <a href="/website-design" class="btn border border-white/40 bg-white/10 text-white backdrop-blur hover:bg-white/20">Website Design →</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const els = document.querySelectorAll("[data-reveal]");
      if (reduced || !("IntersectionObserver" in window)) els.forEach((el) => el.classList.add("is-in"));
      else {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } }), { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
        els.forEach((el) => io.observe(el));
      }
      const fmt = (n) => n.toLocaleString("en-IN");
      const cio = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target, target = +el.dataset.count, suffix = el.dataset.suffix || "";
        cio.unobserve(el);
        if (reduced) { el.textContent = fmt(target) + suffix; return; }
        const t0 = performance.now();
        const step = (t) => { const p = Math.min(1, (t - t0) / 1800); el.textContent = fmt(Math.round(target * (1 - Math.pow(1 - p, 3)))) + suffix; if (p < 1) requestAnimationFrame(step); };
        requestAnimationFrame(step);
      }), { threshold: 0.4 });
      document.querySelectorAll("[data-count]").forEach((el) => cio.observe(el));
    })();
  </script>
</Layout>
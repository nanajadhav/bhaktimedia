---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import CTA from "../components/CTA.astro";
import { site } from "../data/site";

const features = [
  { icon: "📅", title: "Festival Content Calendar", desc: "A year planned ahead — every utsav, ekadashi and special day scheduled before it arrives." },
  { icon: "✍️", title: "Captions & Copy", desc: "Devotional captions in Marathi, Hindi and English — written with the right tone and context." },
  { icon: "🗓️", title: "Scheduled Posting", desc: "Consistent posts at the best times for your audience — no gaps, no last-minute rush." },
  { icon: "💬", title: "Community Management", desc: "Comments and DMs answered warmly and moderated with respect — your devotees feel heard." },
  { icon: "📈", title: "Monthly Analytics", desc: "A simple report every month: reach, follower growth and your best-performing posts." },
  { icon: "🚀", title: "Growth Campaigns", desc: "Boosted posts and creator collaborations timed for your biggest utsavs." },
];

const steps = [
  { num: "०१", title: "Audit & Strategy", desc: "We study your current pages, audience and temple calendar — then build a 90-day plan." },
  { num: "०२", title: "Content Engine", desc: "Our studio produces posts, reels and stories from your events, archives and festivals." },
  { num: "०३", title: "Manage & Grow", desc: "We publish, reply and report every month — you stay focused on the seva." },
];
---
<Layout title="Social Media Management" description="Festival calendars, captions, community management and growth for temples and creators.">
  <PageHeader eyebrow="Service" title="Social Media Management" dev="॥ संवाद सेवा ॥"
    description="Calendars, captions and community management for temples and creators — your seva, told beautifully every day." />

  <section class="section !pt-2">
    <div class="container-x">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f, i) => (
          <article data-reveal style={`--rd:${i * 80}ms`} class="card p-6 shadow-soft">
            <span class="grid size-11 place-items-center rounded-xl bg-gradient-to-br from-saffron to-golden text-xl text-white">{f.icon}</span>
            <h3 class="mt-4 font-display text-lg font-semibold">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-sandal-deep/75 dark:text-cream/65">{f.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-cream/50 dark:bg-night-soft/30">
    <div class="container-x">
      <h2 class="font-display text-3xl font-bold">How it works</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {steps.map((s, i) => (
          <article data-reveal style={`--rd:${i * 100}ms`} class="card relative p-7">
            <span class="font-dev text-4xl text-golden/70">॥ {s.num} ॥</span>
            <h3 class="mt-4 font-display text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-sandal-deep/75 dark:text-cream/65">{s.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="card flex flex-col items-start justify-between gap-6 p-8 shadow-lift md:flex-row md:items-center">
        <div>
          <h2 class="font-display text-2xl font-bold">Every temple is different — so is every quote</h2>
          <p class="mt-2 max-w-xl text-sm text-sandal-deep/70 dark:text-cream/60">Tell us about your pages and goals — we'll send a clear, custom quote within 24 hours.</p>
        </div>
        <div class="flex shrink-0 gap-3">
          <a href="/contact" class="btn btn-primary">Contact Us</a>
          <a href={site.socials.whatsapp} target="_blank" rel="noopener" class="btn btn-outline">WhatsApp Us</a>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</Layout>
---
import Layout from "../layouts/Layout.astro";
import { Check, Sparkle } from "@lucide/astro";
import SectionHeading from "../components/SectionHeading.astro";
import { plans, site } from "../data/site";

const inr = (n: number) => n.toLocaleString("en-IN");
const selfPlans = [
  { id: "trial", name: "Free", desc: "Try the studio — no credit card needed.", price: 0, featured: false, features: ["3 AI creations / month", "3 murti photos / month", "Standard (1K) quality", "Community support"] },
  { id: "starter", name: "Starter", desc: "For creators beginning their digital seva.", price: 199, featured: false, features: ["60 ⚡ = 20 AI creations / month", "HD (2K) quality option", "50 × 1K murti photos (or 30 Full)", "Email support"] },
  { id: "growth", name: "Growth", desc: "For serious channels & growing temples.", price: 599, featured: true, features: ["225 ⚡ = 75 AI creations / month", "HD (2K) quality option", "100 × 1K murti photos (or 60 Full)", "WhatsApp support"] },
  { id: "scale", name: "Scale", desc: "Complete digital temple & enterprise care.", price: 1199, featured: false, features: ["540 ⚡ = 180 AI creations / month", "HD (2K) quality option", "200 × 1K murti photos (or 120 Full)", "Phone support + custom template"] },
];

const packs = [
  { id: "pack-30", price: 30, credits: 9, creations: 3, tag: "Try It" },
  { id: "pack-99", price: 99, credits: 24, creations: 8, tag: "Starter" },
  { id: "pack-299", price: 299, credits: 90, creations: 30, tag: "Best Pack", featured: true },
  { id: "pack-899", price: 899, credits: 300, creations: 100, tag: "Bulk" },
];
---
<Layout title="Pricing" description="BhaktiMedia pricing — simple plans and one-time packs.">
<section id="pricing" class="section bg-cream/50 dark:bg-night-soft/30">
  <div class="container-x">
    <SectionHeading align="center" eyebrow="Pricing"
      description="Simple monthly plans for creators, channels and temple trusts. Pause anytime — no lock-ins.">
      <Fragment slot="title">Choose Your <span class="text-gradient">Seva Plan</span></Fragment>
    </SectionHeading>

    <div class="mt-16 grid items-stretch gap-6 lg:grid-cols-4">
      {selfPlans.map((p, i) => (
         <article data-reveal data-plan={p.id} style={`--rd:${i * 120}ms`}
                 class:list={[
                   "relative flex flex-col",
                   p.featured
                     ? "bg-gradient-to-b from-saffron to-golden p-[2px] shadow-glow lg:-translate-y-4"
                     : "card",
                 ]}>
          <div class:list={["flex h-full flex-col p-8", p.featured && "rounded-[calc(1.5rem-2px)] bg-temple dark:bg-night"]}>
            {p.featured && (
              <span class="absolute -top-4 left-1/2 flex -translate-x-1/2 items-center gap-1.5 rounded-full bg-gradient-to-r from-saffron to-golden px-4 py-1.5 text-xs font-bold text-white shadow-gold">
                <Sparkle class="size-3.5" /> Most Loved
              </span>
            )}
            <h3 class="font-display text-2xl font-bold">{p.name}</h3>
            <p class="mt-2 text-sm text-sandal-deep/70 dark:text-cream/60">{p.desc}</p>
            <p class="mt-6 font-display">
              <span class="text-5xl font-bold">{p.price === 0 ? "Free" : `₹${inr(p.price)}`}</span>
              {p.price > 0 && <span class="text-sm text-sandal/70 dark:text-cream/50"> /month</span>}
            </p>
            <ul class="mt-7 grid flex-1 gap-3 text-sm">
              {p.features.map((f) => (
                <li class="flex items-start gap-2.5">
                  <Check class="mt-0.5 size-4 shrink-0 text-saffron" />
                  <span class="text-sandal-deep/85 dark:text-cream/75">{f}</span>
                </li>
              ))}
            </ul>
            <a href={p.id === "trial" ? "/signup" : `/checkout?plan=${p.id}`} class:list={["plan-btn btn mt-8 w-full", p.featured ? "btn-primary" : "btn-ghost"]}>
              {p.id === "trial" ? "Start Free" : `Begin with ${p.name}`}
            </a>
          </div>
        </article>
      ))}
    </div>

    <p data-reveal class="mt-10 text-center text-sm text-sandal-deep/70 dark:text-cream/60">
      🙏 Temple trusts & NGOs receive a <strong class="font-semibold text-saffron">20% seva discount</strong> on every plan.
      Custom needs? <a href="/contact" class="font-semibold text-saffron underline underline-offset-4">Talk to us</a> — {site.email}
    </p>

    <!-- ═══ ONE-TIME PACKS ═══ -->
    <div class="mt-20 text-center">
      <p class="eyebrow justify-center">🪔 One-Time Packs</p>
      <h2 class="mt-2 font-display text-3xl font-bold">Prefer Not to Subscribe? Buy a Pack!</h2>
      <p class="mt-2 text-sm text-sandal-deep/60 dark:text-cream/50">Pay once, use anytime — <b>credits never expire.</b></p>
    </div>

    <div class="mt-10 grid items-stretch gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {packs.map((pk, i) => (
        <article data-reveal style={`--rd:${i * 80}ms`}
                 class:list={[
                   "card relative flex flex-col p-5 text-center shadow-soft",
                   pk.featured && "border-2 border-golden shadow-gold",
                 ]}>
          {pk.featured && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-golden px-3 py-1 text-[10px] font-bold text-white">BEST PACK</span>
          )}
          <p class="font-display text-3xl font-bold">₹{inr(pk.price)}</p>
          <p class="mt-2 text-sm font-bold text-saffron">{pk.credits} ⚡</p>
          <p class="text-xs text-sandal-deep/50 dark:text-cream/40">{pk.creations} creations</p>
          <span class="mt-2 text-[10px] font-semibold uppercase tracking-wider text-sandal-deep/60 dark:text-cream/50">{pk.tag}</span>
          <a href={`/checkout?pack=${pk.id}`} class:list={["btn mt-4 w-full !py-2 !text-sm", pk.featured ? "btn-primary" : "btn-outline"]}>
            Buy Pack
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var token = "";
  try {
    for (var i = 0; i < localStorage.length; i++) {
      var k = localStorage.key(i);
      if (k && k.indexOf("sb-") === 0 && k.indexOf("auth-token") !== -1) { token = JSON.parse(localStorage.getItem(k)).access_token; break; }
    }
  } catch (e) {}
  if (!token) return;
  fetch("/api/credits", { headers: { Authorization: "Bearer " + token } })
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (d) {
      if (!d || !d.plan) return;
      var card = document.querySelector('[data-plan="' + d.plan + '"]');
      if (!card) return;
      var badge = document.createElement("span");
      badge.className = "absolute right-3 top-3 z-10 rounded-full bg-green-600 px-3 py-1 text-[10px] font-bold text-white shadow-soft";
      badge.textContent = "✓ CURRENT PLAN — ACTIVE";
      card.appendChild(badge);
      var btn = card.querySelector(".plan-btn");
      if (btn) { btn.textContent = "Current Plan ✓"; btn.classList.add("opacity-60", "pointer-events-none"); }
    })
    .catch(function () {});
})();
</script>
</Layout>
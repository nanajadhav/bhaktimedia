---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Pricing" description="BhaktiMedia pricing — seedhi pricing, koi jhol nahi. Credits, plans aur packs.">
<div class="container-x px-4 pb-20 pt-28 sm:px-6">
  <div id="toast" class="pointer-events-none fixed left-1/2 top-20 z-[90] hidden -translate-x-1/2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-cream shadow-lift dark:bg-white dark:text-ink"></div>

  <div class="text-center">
    <p class="eyebrow justify-center">💰 Pricing</p>
    <h1 class="mt-3 font-display text-4xl font-bold sm:text-5xl">Seedhi Pricing, <span class="bg-gradient-to-r from-saffron to-golden bg-clip-text text-transparent">Koi Jhol Nahi</span></h1>
    <p class="mx-auto mt-4 max-w-xl text-sm text-sandal-deep/60 dark:text-cream/50">Credits kharido, creations banao. Na chhupe kharche, na lock-in. Festival posters, AI images, murti photos — sab ek hi balance se.</p>
    <p id="cur-plan-line" class="mx-auto mt-4 hidden max-w-md rounded-full bg-green-500/10 px-5 py-2 text-sm font-bold text-green-600 dark:text-green-400"></p>
  </div>

  <div class="mx-auto mt-6 flex max-w-2xl flex-wrap justify-center gap-2">
    <span class="chip bg-saffron/10 text-saffron">🖼️ 1 Creation = 3 ⚡</span>
    <span class="chip bg-golden/15 text-golden">🌟 HD Creation = 6 ⚡</span>
    <span class="chip bg-sandal/10 text-sandal-deep dark:bg-white/5 dark:text-cream/70">📅 Plan credits har mahine reset</span>
    <span class="chip bg-green-500/10 text-green-600 dark:text-green-400">♾️ Packs kabhi expire nahi</span>
  </div>

  <!-- ═══ MONTHLY PLANS ═══ -->
  <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
    <div class="card relative flex flex-col p-6 shadow-soft">
      <span id="badge-trial" class="absolute -top-3 left-1/2 hidden -translate-x-1/2 rounded-full bg-green-500 px-4 py-1 text-xs font-bold text-white shadow-soft">🪔 AAPKA PLAN</span>
      <p class="eyebrow">🪔 Trial</p>
      <p class="mt-3 font-display text-4xl font-bold">₹0</p>
      <p class="text-xs text-sandal-deep/50 dark:text-cream/40">hamesha free</p>
      <p class="mt-4 rounded-xl bg-sandal/10 px-3 py-2 text-center text-sm font-bold dark:bg-white/5">3 ⚡ = 1 creation</p>
      <ul class="mt-4 grid gap-2 text-sm text-sandal-deep/70 dark:text-cream/60">
        <li>✅ 1 AI image ya poster</li>
        <li>✅ Saare festival templates</li>
        <li>🪔 10 × 1K murti photos FREE/mahina</li>
        <li>✅ Watermark-free download</li>
        <li>❌ HD (2K) quality</li>
      </ul>
      <button id="btn-trial" class="btn btn-outline mt-6 w-full">Free Shuru Karo</button>
    </div>

    <div class="card relative flex flex-col p-6 shadow-soft">
      <span id="badge-starter" class="absolute -top-3 left-1/2 hidden -translate-x-1/2 rounded-full bg-green-500 px-4 py-1 text-xs font-bold text-white shadow-soft">🪔 AAPKA PLAN</span>
      <p class="eyebrow">🎨 Starter</p>
      <p class="mt-3 font-display text-4xl font-bold">₹1<span class="text-sm font-normal text-sandal-deep/50 dark:text-cream/40">/mahina (TEST)</span></p>
      <p class="text-xs text-sandal-deep/50 dark:text-cream/40">Testing price — launch ke baad ₹199</p>
      <p class="mt-4 rounded-xl bg-saffron/10 px-3 py-2 text-center text-sm font-bold text-saffron">60 ⚡ = 20 creations</p>
      <ul class="mt-4 grid gap-2 text-sm text-sandal-deep/70 dark:text-cream/60">
        <li>✅ 20 images/posters monthly</li>
        <li>✅ HD (2K) option (6⚡)</li>
        <li>✅ Saare festival templates</li>
        <li>🪔 50 × 1K (ya 30 Full) murti photos</li>
        <li>✅ Email support</li>
      </ul>
      <button id="btn-starter" class="btn btn-primary mt-6 w-full">Switch Plan →</button>
    </div>

    <div class="card relative flex flex-col border-2 border-saffron p-6 shadow-gold">
      <span id="badge-growth" class="absolute -top-3 left-1/2 hidden -translate-x-1/2 rounded-full bg-green-500 px-4 py-1 text-xs font-bold text-white shadow-soft">🪔 AAPKA PLAN</span>
      <span id="bv-growth" class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-gradient-to-r from-saffron to-golden px-4 py-1 text-xs font-bold text-white shadow-gold">⭐ BEST VALUE</span>
      <p class="eyebrow">🚀 Growth</p>
      <p class="mt-3 font-display text-4xl font-bold">₹599<span class="text-sm font-normal text-sandal-deep/50 dark:text-cream/40">/mahina</span></p>
      <p class="text-xs text-sandal-deep/50 dark:text-cream/40">₹8 per creation</p>
      <p class="mt-4 rounded-xl bg-saffron/10 px-3 py-2 text-center text-sm font-bold text-saffron">225 ⚡ = 75 creations</p>
      <ul class="mt-4 grid gap-2 text-sm text-sandal-deep/70 dark:text-cream/60">
        <li>✅ 75 images/posters monthly</li>
        <li>✅ HD (2K) option (6⚡)</li>
        <li>✅ Festival packs eligibility</li>
        <li>🪔 100 × 1K (ya 60 Full) murti photos</li>
        <li>✅ WhatsApp support</li>
      </ul>
      <button id="btn-growth" class="btn btn-primary mt-6 w-full">Switch Plan →</button>
    </div>

    <div class="card relative flex flex-col p-6 shadow-soft">
      <span id="badge-scale" class="absolute -top-3 left-1/2 hidden -translate-x-1/2 rounded-full bg-green-500 px-4 py-1 text-xs font-bold text-white shadow-soft">🪔 AAPKA PLAN</span>
      <p class="eyebrow">🏛️ Scale</p>
      <p class="mt-3 font-display text-4xl font-bold">₹1199<span class="text-sm font-normal text-sandal-deep/50 dark:text-cream/40">/mahina</span></p>
      <p class="text-xs text-sandal-deep/50 dark:text-cream/40">₹6.7 per creation</p>
      <p class="mt-4 rounded-xl bg-sandal/10 px-3 py-2 text-center text-sm font-bold dark:bg-white/5">540 ⚡ = 180 creations</p>
      <ul class="mt-4 grid gap-2 text-sm text-sandal-deep/70 dark:text-cream/60">
        <li>✅ 180 images/posters monthly</li>
        <li>✅ HD (2K) option (6⚡)</li>
        <li>✅ Monthly custom template request</li>
        <li>🪔 200 × 1K (ya 120 Full) murti photos</li>
        <li>✅ Phone support</li>
      </ul>
      <button id="btn-scale" class="btn btn-primary mt-6 w-full">Switch Plan →</button>
    </div>
  </div>

  <!-- ═══ ONE-TIME PACKS ═══ -->
  <div class="mt-16 text-center">
    <p class="eyebrow justify-center">♾️ One-Time Packs</p>
    <h2 class="mt-2 font-display text-3xl font-bold">Subscription Nahi Chahiye? Packs Lo!</h2>
    <p class="mt-2 text-sm text-sandal-deep/60 dark:text-cream/50">Ek baar kharido, jab chahiye use karo — <b>kabhi expire nahi hote.</b></p>
  </div>
  <div class="mx-auto mt-8 grid max-w-3xl gap-5 sm:grid-cols-3">
    <div class="card p-5 text-center shadow-soft">
      <p class="font-display text-3xl font-bold">₹99</p>
      <p class="mt-2 text-sm font-bold text-saffron">24 ⚡</p>
      <p class="text-xs text-sandal-deep/50 dark:text-cream/40">8 creations</p>
      <button data-soon class="btn btn-outline mt-4 w-full !py-2 !text-sm">Pack Lo</button>
    </div>
    <div class="card relative border-2 border-golden p-5 text-center shadow-gold">
      <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-golden px-3 py-1 text-[10px] font-bold text-white">BEST PACK</span>
      <p class="font-display text-3xl font-bold">₹299</p>
      <p class="mt-2 text-sm font-bold text-saffron">90 ⚡</p>
      <p class="text-xs text-sandal-deep/50 dark:text-cream/40">30 creations</p>
      <button data-soon class="btn btn-primary mt-4 w-full !py-2 !text-sm">Pack Lo</button>
    </div>
    <div class="card p-5 text-center shadow-soft">
      <p class="font-display text-3xl font-bold">₹899</p>
      <p class="mt-2 text-sm font-bold text-saffron">300 ⚡</p>
      <p class="text-xs text-sandal-deep/50 dark:text-cream/40">100 creations</p>
      <button data-soon class="btn btn-outline mt-4 w-full !py-2 !text-sm">Pack Lo</button>
    </div>
  </div>

  <!-- ═══ FAQ ═══ -->
  <div class="mx-auto mt-16 max-w-2xl">
    <p class="eyebrow text-center">❓ Sawaal-Jawaab</p>
    <div class="mt-6 grid gap-3">
      <details class="card group p-4 shadow-soft">
        <summary class="cursor-pointer text-sm font-bold">Credit kya hota hai?</summary>
        <p class="mt-2 text-sm text-sandal-deep/60 dark:text-cream/50">Har AI creation (image ya poster) ke liye 3 ⚡ lagte hain. HD (2K) quality ke liye 6 ⚡. Generation fail ho to credit wapas — katta hi nahi!</p>
      </details>
      <details class="card group p-4 shadow-soft">
        <summary class="cursor-pointer text-sm font-bold">Murti photos ka system kya hai?</summary>
        <p class="mt-2 text-sm text-sandal-deep/60 dark:text-cream/50">Har plan mein murti credits milte hain: 1K clean download = 0.3⚡, Full HD = 0.5⚡. Free plan mein 10 × 1K photos har mahine FREE. Watermark preview hamesha free.</p>
      </details>
      <details class="card group p-4 shadow-soft">
        <summary class="cursor-pointer text-sm font-bold">Payment kaise hoti hai?</summary>
        <p class="mt-2 text-sm text-sandal-deep/60 dark:text-cream/50">"Switch Plan" dabao → UPI QR scan karo (GPay/PhonePe/Paytm) → payment hote hi plan TURANT active + invoice email par. Razorpay secure checkout — zero waiting, zero manual steps!</p>
      </details>
      <details class="card group p-4 shadow-soft">
        <summary class="cursor-pointer text-sm font-bold">Packs expire hote hain kya?</summary>
        <p class="mt-2 text-sm text-sandal-deep/60 dark:text-cream/50">Nahi! Packs one-time hain — jab tak khatam na karo, tab tak aapke hain. Plan credits har mahine reset hote hain, packs nahi.</p>
      </details>
    </div>
  </div>

  <div class="mt-16 rounded-3xl bg-gradient-to-r from-saffron to-golden p-10 text-center shadow-gold">
    <h2 class="font-display text-3xl font-bold text-white">Pehli Creation Free Hai! 🪔</h2>
    <p class="mt-2 text-sm text-white/80">Trial mein 3 ⚡ + 10 × 1K murti photos — watermark-free.</p>
    <a href="/signup" class="btn mt-6 bg-white !text-saffron hover:bg-cream">🙏 Abhi Shuru Karo</a>
  </div>
</div>

<!-- ═══ SWITCH PLAN MODAL — SIRF RAZORPAY UPI QR ═══ -->
<dialog id="switch-modal" class="relative m-auto w-[min(94vw,440px)] rounded-3xl border border-golden/30 bg-temple p-6 shadow-lift dark:bg-night">
  <form method="dialog" class="absolute right-3 top-3">
    <button class="grid size-9 place-items-center rounded-full bg-sandal/10 transition hover:bg-sandal/20 dark:bg-white/10" aria-label="Band karo">✕</button>
  </form>
  <p class="eyebrow">🔄 Plan Switch — UPI Payment</p>
  <h3 id="sw-title" class="mt-2 font-display text-2xl font-bold"></h3>
  <p id="sw-price" class="mt-1 text-sm text-sandal-deep/60 dark:text-cream/50"></p>

  <button id="sw-rzp" class="btn btn-primary mt-4 w-full !py-3">📱 UPI QR se Pay Karo — auto confirm ⚡</button>
  <p id="sw-msg" class="mt-2 hidden rounded-xl bg-red-500/10 px-3 py-2 text-center text-xs font-semibold text-red-500"></p>
  <p class="mt-3 text-center text-[11px] text-sandal-deep/50 dark:text-cream/40">Payment mein problem? Support se sampark karo — 24 ghante mein solve 🙏</p>
</dialog>

<script is:inline>
(function () {
  const $ = (s) => document.querySelector(s);
  function toast(msg) { const t = $("#toast"); t.textContent = msg; t.classList.remove("hidden"); setTimeout(() => t.classList.add("hidden"), 2800); }
  function msg(m, ok) {
    const e = $("#sw-msg");
    if (!e) return;
    if (!m) { e.classList.add("hidden"); return; }
    e.textContent = m;
    e.className = "mt-2 rounded-xl px-3 py-2 text-center text-xs font-semibold " + (ok ? "bg-green-500/10 text-green-600" : "bg-red-500/10 text-red-500");
  }

  const PLANS = {
    trial: { name: "Trial", price: "₹0 /mahina", amount: 0 },
    starter: { name: "Starter", price: "₹199 /mahina", amount: 199 },
    growth: { name: "Growth", price: "₹599 /mahina", amount: 599 },
    scale: { name: "Scale", price: "₹1199 /mahina", amount: 1199 },
  };

  let token = "";
  try {
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (k && k.indexOf("sb-") === 0 && k.indexOf("auth-token") !== -1) { token = JSON.parse(localStorage.getItem(k)).access_token; break; }
    }
  } catch (e) {}
  let curPlan = null;

  async function loadPlan() {
    if (!token) return;
    try {
      const r = await fetch("/api/credits", { headers: { Authorization: "Bearer " + token } });
      if (r.ok) curPlan = (await r.json()).plan || null;
    } catch (e) {}
  }

  function renderButtons() {
    Object.keys(PLANS).forEach((pid) => {
      const b = document.getElementById("btn-" + pid);
      const badge = document.getElementById("badge-" + pid);
      if (!b) return;
      if (pid === "growth") { const bv = $("#bv-growth"); if (bv) bv.classList.toggle("hidden", curPlan === "growth"); }
      if (curPlan && pid === curPlan) {
        if (badge) badge.classList.remove("hidden");
        b.textContent = "✅ Aapka Active Plan";
        b.disabled = true;
        b.className = "mt-6 w-full cursor-not-allowed rounded-full bg-green-500/15 px-5 py-2.5 text-sm font-bold text-green-600 dark:text-green-400";
      } else if (!curPlan) {
        if (pid === "trial") { b.textContent = "Free Shuru Karo"; b.onclick = () => (location.href = "/signup"); }
        else { b.textContent = "🔑 Login Karo Pehle"; b.onclick = () => (location.href = "/login"); }
      } else {
        b.textContent = pid === "trial" ? "⬇ Downgrade — Trial" : "Switch Plan →";
        b.onclick = () => (location.href = "/checkout?plan=" + pid);
      }
    });
    const line = $("#cur-plan-line");
    if (curPlan && line) { line.textContent = `🪔 Aapka current plan: ${PLANS[curPlan].name} — neeche se switch kar sakte ho`; line.classList.remove("hidden"); }
  }

  let swPlan = null;
  function openSwitch(pid) {
    swPlan = pid;
    const p = PLANS[pid];
    $("#sw-title").textContent = p.name + " Plan";
    $("#sw-price").textContent = p.price + " — UPI se payment karo";
    msg("");
    $("#switch-modal").showModal();
  }

  function loadCheckout() {
    return new Promise((res, rej) => {
      if (window.Razorpay) return res();
      const s = document.createElement("script");
      s.src = "https://checkout.razorpay.com/v1/checkout.js";
      s.onload = res;
      s.onerror = () => rej(new Error("Checkout script load nahi hua — adblocker/internet check karo"));
      document.head.appendChild(s);
    });
  }
  async function waitActivation(plan) {
    for (let i = 0; i < 14; i++) {
      await new Promise((r) => setTimeout(r, 2500));
      try {
        const r = await fetch("/api/credits", { headers: { Authorization: "Bearer " + token } });
        if (r.ok) { const c = await r.json(); if (c.plan === plan) { toast("🎉 Plan active ho gaya! Invoice email par 📧"); curPlan = plan; renderButtons(); return; } }
      } catch (e) {}
    }
    toast("✅ Payment mila — activation 1-2 min mein, page refresh karte raho");
  }

  /* BULLETPROOF: delegated click — kabhi bhi attach fail nahi hoga */
  document.addEventListener("click", async (ev) => {
    const b = ev.target.closest("#sw-rzp");
    if (!b) return;
    const label = "📱 UPI QR se Pay Karo — auto confirm ⚡";
    msg("");
    try {
      if (!token) throw new Error("Pehle login karo");
      b.disabled = true; b.textContent = "⏳ Order ban raha hai...";
      const r = await fetch("/api/razorpay-order", {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
        body: JSON.stringify({ plan: swPlan }),
      });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error || ("Server error " + r.status + " — redeploy karo"));
      await loadCheckout();
      if (!window.Razorpay) throw new Error("Razorpay checkout ready nahi hua");
      const rzp = new window.Razorpay({
        key: d.key,
        amount: d.amount,
        currency: "INR",
        name: "BhaktiMedia.in",
        description: PLANS[swPlan].name + " plan — monthly",
        order_id: d.orderId,
        theme: { color: "#f97316" },
        method: { upi: { flow: "qr_code" }, card: false, netbanking: false, wallet: false },
        handler: () => { $("#switch-modal").close(); waitActivation(swPlan); },
        modal: { ondismiss: () => { b.disabled = false; b.textContent = label; } },
      });
      rzp.on("payment.failed", (e) => msg("❌ Payment fail: " + ((e.error && e.error.description) || "dobara try karo")));
      rzp.open();
      b.disabled = false; b.textContent = label;
    } catch (e) {
      msg("❌ " + e.message);
      b.disabled = false; b.textContent = label;
    }
  });

  document.querySelectorAll("[data-soon]").forEach((b) => b.addEventListener("click", () => toast("🚧 Packs ka payment gateway jald aa raha hai!")));

  loadPlan().then(renderButtons);
})();
</script>
</Layout>
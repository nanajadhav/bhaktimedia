---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ArrowRight, Clock, Calendar } from "@lucide/astro";
import SectionHeading from "./SectionHeading.astro";
import { readTime, fmtDate } from "../lib/utils";

const posts = (await getCollection("blog")).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured).slice(0, 3);
---
<section id="blog" class="section">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading eyebrow="From the Blog" dev="? ????????? ?"
        description="Insights on devotional design, temple growth and ethical AI — written with care.">
        <Fragment slot="title">Latest <span class="text-gradient">Wisdom</span></Fragment>
      </SectionHeading>
      <a data-reveal href="/blog" class="btn btn-ghost">All articles <ArrowRight class="size-4" /></a>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <!-- featured -->
      <a data-reveal href={`/blog/${featured.id}`} class="card group overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-lift">
        <div class="overflow-hidden">
          <Image src={featured.data.image} width={1200} height={675} alt={featured.data.title} loading="lazy"
                 class="aspect-video w-full object-cover transition duration-700 group-hover:scale-[1.04]" />
        </div>
        <div class="p-7">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="chip bg-saffron/10 font-semibold text-saffron">{featured.data.category}</span>
            <span class="flex items-center gap-1 text-sandal/70 dark:text-cream/50"><Clock class="size-3.5" /> {readTime(featured.body)} min read</span>
            <span class="flex items-center gap-1 text-sandal/70 dark:text-cream/50"><Calendar class="size-3.5" /> {fmtDate(featured.data.pubDate)}</span>
          </div>
          <h3 class="mt-4 font-display text-2xl font-bold leading-snug transition group-hover:text-saffron">{featured.data.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-sandal-deep/75 dark:text-cream/65">{featured.data.description}</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-saffron">
            Read article <ArrowRight class="size-4 transition group-hover:translate-x-1" />
          </span>
        </div>
      </a>

      <!-- list -->
      <div class="flex flex-col gap-6">
        {rest.map((p, i) => (
          <a data-reveal style={`--rd:${i * 100}ms`} href={`/blog/${p.id}`}
             class="card group flex gap-5 p-4 transition duration-300 hover:-translate-y-1 hover:shadow-lift">
            <div class="w-32 shrink-0 overflow-hidden rounded-xl sm:w-40">
              <Image src={p.data.image} width={320} height={240} alt="" loading="lazy"
                     class="aspect-[4/3] h-full w-full object-cover transition duration-700 group-hover:scale-105" />
            </div>
            <div class="py-1">
              <span class="chip bg-golden/15 text-[11px] font-semibold text-sandal dark:text-golden">{p.data.category}</span>
              <h3 class="mt-2 font-display font-semibold leading-snug transition group-hover:text-saffron sm:text-lg">{p.data.title}</h3>
              <p class="mt-2 flex items-center gap-3 text-xs text-sandal/70 dark:text-cream/50">
                <span class="flex items-center gap-1"><Clock class="size-3.5" /> {readTime(p.body)} min</span>
                <span>{fmtDate(p.data.pubDate)}</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

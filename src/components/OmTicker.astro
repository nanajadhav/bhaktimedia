---
import { marqueeItems } from "../data/site";
---
<div class="relative overflow-hidden border-y border-golden/20 bg-ink py-4 dark:bg-black" aria-label="Sacred chant ticker">
  <div class="group flex w-max animate-marquee gap-8 whitespace-nowrap">
    {[0, 1].map((dup) => (
      <ul class="flex items-center gap-8" aria-hidden={dup === 1}>
        {marqueeItems.map((t) => (
          <li class="flex items-center gap-8 font-dev text-lg text-goldsoft/90">
            <span>{t}</span>
            <span class="text-saffron">?</span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
<style>
  .group:hover div { animation-play-state: paused; }
</style>

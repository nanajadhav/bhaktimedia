---
import { site, services } from "../data/site";

const quick = [
  { label: "Home", href: "/" }, { label: "About", href: "/about" },
  { label: "Services", href: "/services" }, { label: "Gallery", href: "/gallery" },
  { label: "Blog", href: "/blog" }, { label: "Pricing", href: "/pricing" },
  { label: "AI Services", href: "/ai-services" }, { label: "Contact", href: "/contact" },
];

// Inline SVG icons as HTML strings
const icons = {
  instagram: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>',
  youtube: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>',
  facebook: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>',
  whatsapp: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>',
  send: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>',
};

const socials = [
  { label: "Instagram", href: site.socials.instagram, icon: icons.instagram },
  { label: "YouTube", href: site.socials.youtube, icon: icons.youtube },
  { label: "Facebook", href: site.socials.facebook, icon: icons.facebook },
  { label: "WhatsApp", href: site.socials.whatsapp, icon: icons.whatsapp },
];
---
<footer class="relative mt-8 text-cream">
  <!-- temple skyline rising from the page -->
  <svg viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true"
       class="block h-24 w-full text-night sm:h-32 dark:text-night-soft">
    <g fill="currentColor">
      <rect x="0" y="140" width="1440" height="20" />
      <rect x="0" y="128" width="1440" height="8" opacity="0.6" />
      <path d="M720 16C700 44 688 68 688 96v44h64V96c0-28-12-52-32-80z" />
      <circle cx="720" cy="12" r="5" />
      <path d="M724 2l30 8-30 8z" />
      <rect x="656" y="112" width="128" height="28" rx="4" />
      <path d="M320 56c-13 19-20 36-20 54v30h40v-30c0-18-7-35-20-54z" />
      <circle cx="320" cy="52" r="4" /><rect x="288" y="122" width="64" height="18" rx="3" />
      <path d="M1120 56c-13 19-20 36-20 54v30h40v-30c0-18-7-35-20-54z" />
      <circle cx="1120" cy="52" r="4" /><rect x="1088" y="122" width="64" height="18" rx="3" />
      <path d="M96 140a28 28 0 0 1 56 0z" /><path d="M1288 140a28 28 0 0 1 56 0z" />
    </g>
  </svg>

  <div class="relative overflow-hidden bg-night">
    <span aria-hidden="true" class="pointer-events-none absolute -right-16 top-6 select-none font-dev text-[18rem] leading-none text-white/[0.03]">ॐ</span>

    <div class="container-x relative grid gap-12 py-14 md:grid-cols-2 lg:grid-cols-[1.3fr_0.7fr_0.9fr_1.2fr]">
      <div>
        <a href="/" class="flex items-center gap-2.5">
          <span class="grid size-10 place-items-center rounded-xl bg-gradient-to-br from-saffron to-golden font-dev text-xl font-bold text-white">ॐ</span>
          <span class="font-display text-lg font-bold">Bhakti<span class="text-gradient">Media</span><span class="text-saffron">.in</span></span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-cream/60">{site.description}</p>
        <p class="mt-3 font-dev text-sm text-golden/80">डिजिटल भक्ती, प्रत्येक हृदयासाठी 🪔</p>
        <ul class="mt-6 flex gap-3">
          {socials.map(({ label, href, icon }) => (
            <li>
              <a href={href} target="_blank" rel="noopener" aria-label={label}
                 class="grid size-10 place-items-center rounded-full border border-white/15 text-cream/70 transition hover:-translate-y-1 hover:border-golden hover:text-golden">
                <span set:html={icon} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <nav aria-label="Quick links">
        <h3 class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-golden">Quick Links</h3>
        <ul class="mt-5 grid gap-2.5 text-sm">
          {quick.map((l) => (
            <li><a href={l.href} class="text-cream/60 transition hover:translate-x-1 hover:text-golden inline-block">{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Services">
        <h3 class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-golden">Services</h3>
        <ul class="mt-5 grid gap-2.5 text-sm">
          {services.slice(0, 6).map((s) => (
            <li><a href="/services" class="text-cream/60 transition hover:translate-x-1 hover:text-golden inline-block">{s.title}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-golden">Join the Bhakti Newsletter</h3>
        <p class="mt-5 text-sm text-cream/60">Monthly blessings, festival design packs and behind-the-scenes seva. Zero spam.</p>
        <form data-demo-form class="mt-4 flex gap-2">
          <label for="nl-email" class="sr-only">Email address</label>
          <input id="nl-email" type="email" required placeholder="you@example.com"
                 class="input !rounded-full !bg-white/5 !text-cream placeholder:!text-cream/30" />
          <button type="submit" class="btn btn-gold shrink-0 !px-4" aria-label="Subscribe">
            <span set:html={icons.send} />
          </button>
        </form>
        <p class="mt-3 text-xs text-cream/40">🙏 One email a month — unsubscribe anytime.</p>
      </div>
    </div>

    <div class="border-t border-white/10">
      <div class="container-x flex flex-col items-center justify-between gap-3 py-6 text-xs text-cream/45 sm:flex-row">
        <p>© 2026 {site.name} — {site.tagline}</p>
        <p class="flex items-center gap-4">
          <a href="/rss.xml" class="hover:text-golden">RSS</a>
          <a href="/sitemap-index.xml" class="hover:text-golden">Sitemap</a>
          <span>Made with 🪔 in Bharat</span>
        </p>
      </div>
    </div>
  </div>
</footer>
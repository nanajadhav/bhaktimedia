---
import { site, services } from "../data/site";

// Inline SVG icons as HTML strings
const icons = {
  phone: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  mail: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>',
  mapPin: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>',
  instagram: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>',
  youtube: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>',
  facebook: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>',
  whatsapp: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>',
  send: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>',
  navigation: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>',
};

const socials = [
  { label: "Instagram", href: site.socials.instagram, icon: icons.instagram },
  { label: "YouTube", href: site.socials.youtube, icon: icons.youtube },
  { label: "Facebook", href: site.socials.facebook, icon: icons.facebook },
  { label: "WhatsApp", href: site.socials.whatsapp, icon: icons.whatsapp },
];
---
<section id="contact" class="section">
  <div class="container-x grid gap-12 lg:grid-cols-[1fr_0.85fr]">
    <!-- form -->
    <div data-reveal class="card p-8 md:p-10">
      <header class="max-w-2xl">
        <p class="eyebrow">
          <span class="h-px w-8 bg-gradient-to-r from-saffron to-transparent" aria-hidden="true"></span>
          Contact
        </p>
        <h2 class="mt-4 font-display text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
          Send Us a <span class="text-gradient">Message</span>
        </h2>
        <p class="mt-2 font-dev text-base text-sandal dark:text-golden/80">॥ संवादः भक्त्या ॥</p>
      </header>
      
      <form data-demo-form action="#" method="POST" class="mt-8 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="cf-name" class="mb-1.5 block text-sm font-medium">Full name</label>
          <input id="cf-name" name="name" required placeholder="Shri Ramesh Kulkarni" class="input" />
        </div>
        <div>
          <label for="cf-email" class="mb-1.5 block text-sm font-medium">Email</label>
          <input id="cf-email" name="email" type="email" required placeholder="you@mandir.org" class="input" />
        </div>
        <div>
          <label for="cf-phone" class="mb-1.5 block text-sm font-medium">Phone / WhatsApp</label>
          <input id="cf-phone" name="phone" type="tel" placeholder="+91 98XXX XXXXX" class="input" />
        </div>
        <div>
          <label for="cf-service" class="mb-1.5 block text-sm font-medium">Service needed</label>
          <select id="cf-service" name="service" class="input">
            {services.map((s) => <option>{s.title}</option>)}
            <option>Something else 🙏</option>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="cf-msg" class="mb-1.5 block text-sm font-medium">Tell us about your seva</label>
          <textarea id="cf-msg" name="message" rows="4" required
                    placeholder="Our Ganesh Utsav is in September and we need posters, reels and a livestream…" class="input resize-none"></textarea>
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="btn btn-primary w-full">
            Send Message <span set:html={icons.send} />
          </button>
          <p class="mt-3 text-center text-xs text-sandal/70 dark:text-cream/50">We reply within 24 hours — usually much faster 🙏</p>
        </div>
      </form>
    </div>

    <!-- info column -->
    <div class="flex flex-col gap-6">
      <div data-reveal style="--rd:100ms" class="card space-y-5 p-8">
        <a href={`tel:${site.phone.replace(/\s/g, "")}`} class="group flex items-center gap-4">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-saffron to-golden text-white shadow-gold">
            <span set:html={icons.phone} />
          </span>
          <span>
            <span class="block text-xs uppercase tracking-widest text-sandal/70 dark:text-cream/50">Call / WhatsApp</span>
            <span class="block font-medium transition group-hover:text-saffron">{site.phone}</span>
          </span>
        </a>
        <a href={`mailto:${site.email}`} class="group flex items-center gap-4">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-saffron to-golden text-white shadow-gold">
            <span set:html={icons.mail} />
          </span>
          <span>
            <span class="block text-xs uppercase tracking-widest text-sandal/70 dark:text-cream/50">Email</span>
            <span class="block font-medium transition group-hover:text-saffron">{site.email}</span>
          </span>
        </a>
        <div class="group flex items-center gap-4">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-saffron to-golden text-white shadow-gold">
            <span set:html={icons.mapPin} />
          </span>
          <span>
            <span class="block text-xs uppercase tracking-widest text-sandal/70 dark:text-cream/50">Studio</span>
            <span class="block font-medium">{site.address}</span>
          </span>
        </div>
        
        <div class="flex gap-3 border-t border-sandal/10 pt-5 dark:border-white/10">
          {socials.map(({ label, href, icon }) => (
            <a href={href} target="_blank" rel="noopener" aria-label={label}
               class="grid size-10 place-items-center rounded-full bg-gradient-to-br from-saffron/10 to-golden/10 text-saffron transition hover:-translate-y-1 hover:from-saffron hover:to-golden hover:text-white">
              <span set:html={icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- map placeholder -->
      <div data-reveal style="--rd:200ms" class="pattern-sacred relative h-64 overflow-hidden rounded-2xl border border-golden/30 bg-cream dark:bg-night-soft">
        <div class="absolute inset-0 bg-gradient-to-br from-golden/20 via-transparent to-saffron/20" aria-hidden="true"></div>
        <div class="absolute inset-0 grid place-items-center">
          <div class="text-center">
            <span class="mx-auto grid size-12 animate-pulse-dot place-items-center rounded-full bg-gradient-to-br from-saffron to-golden text-white shadow-glow">
              <span set:html={icons.mapPin} />
            </span>
            <p class="mt-3 font-display font-semibold">Akurdi, Pune</p>
            <p class="text-sm text-sandal/80 dark:text-cream/60">Maharashtra, India</p>
          </div>
        </div>
        <a href="https://maps.google.com/?q=Akurdi,Pune" target="_blank" rel="noopener"
           class="btn btn-ghost absolute bottom-4 left-1/2 -translate-x-1/2 !py-2 !text-xs">
          <span set:html={icons.navigation} /> Open in Google Maps
        </a>
      </div>
    </div>
  </div>
</section>
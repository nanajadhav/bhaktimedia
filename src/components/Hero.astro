---
import { Image } from "astro:assets";
import { ArrowRight, Play, Sparkles, Star, Bell } from "@lucide/astro";
import Diya from "./Diya.astro";
import Mandala from "./Mandala.astro";
import { site } from "../data/site";
import { picsum } from "../lib/utils";

const avatars = ["devotee-one", "devotee-two", "devotee-three", "devotee-four"];
---
<section id="home" class="relative flex min-h-svh items-center overflow-hidden pb-24 pt-32">
  <!-- atmosphere layers -->
  <div class="absolute inset-0 bg-gradient-to-b from-cream via-temple to-temple dark:from-[#2a1708] dark:via-night dark:to-night" aria-hidden="true"></div>
  <div class="hero-rays absolute -top-24 left-1/2 h-[75vh] w-[160%] -translate-x-1/2 animate-rays" aria-hidden="true"></div>
  <Mandala class="absolute -right-44 -top-44 size-[560px] animate-spin-slower text-golden/25 dark:text-golden/15" />
  <Mandala class="absolute -bottom-56 -left-56 size-[480px] text-saffron/10" />
  <canvas id="dust" class="absolute inset-0 z-[1] h-full w-full" aria-hidden="true"></canvas>
  <div id="hero-glow" aria-hidden="true"></div>

  <Diya id="bg-diya" class="absolute bottom-8 left-8 z-[1] hidden w-24 opacity-80 xl:block" />

  <div class="container-x relative z-10 grid items-center gap-16 lg:grid-cols-[1.05fr_0.95fr]">
    <!-- copy -->
    <div>
      <span class="chip animate-rise border border-golden/40 bg-white/60 font-dev text-sandal-deep backdrop-blur dark:bg-white/5 dark:text-goldsoft">
        <span class="size-2 animate-pulse-dot rounded-full bg-saffron"></span>
        ?? {site.tagline}
      </span>

      <h1 data-reveal="group" class="mt-6 font-display text-[2.6rem] font-bold leading-[1.05] tracking-tight sm:text-6xl xl:text-7xl">
        <span class="mask-line"><span style="--rd:100ms">Experience <span class="text-gradient">Divine</span></span></span>
        <span class="mask-line"><span style="--rd:220ms">Creativity Through</span></span>
        <span class="mask-line"><span style="--rd:340ms">Digital Media<span class="text-saffron">.</span></span></span>
      </h1>

      <p data-reveal style="--rd:440ms" class="mt-6 max-w-xl text-base leading-relaxed text-sandal-deep/85 dark:text-cream/70 sm:text-lg">
        BhaktiMedia creates devotional videos, AI images, reels, posters, YouTube content, social media branding and spiritual digital experiences.
      </p>

      <div data-reveal style="--rd:540ms" class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/services" class="btn btn-primary">Explore <ArrowRight class="size-4" /></a>
        <button data-open-dialog="demo-modal" class="btn btn-glass">
          <span class="grid size-8 place-items-center rounded-full bg-gradient-to-br from-saffron to-golden text-white shadow-gold">
            <Play class="size-3.5 fill-current" />
          </span>
          Watch Demo
        </button>
        <a href="/contact" class="btn btn-ghost">Contact Us</a>
      </div>

      <div data-reveal style="--rd:660ms" class="mt-10 flex flex-wrap items-center gap-4">
        <div class="flex -space-x-3">
          {avatars.map((a) => (
            <Image src={picsum(`avatar-${a}`, 80, 80)} width={40} height={40} alt=""
                   class="size-10 rounded-full object-cover ring-2 ring-temple dark:ring-night" loading="lazy" />
          ))}
        </div>
        <div>
          <div class="flex gap-0.5 text-golden" aria-label="5 star rating">
            {Array.from({ length: 5 }).map(() => <Star class="size-3.5 fill-current" />)}
          </div>
          <p class="text-sm text-sandal-deep/75 dark:text-cream/60">
            Trusted by <strong class="font-semibold">100+ temples & creators</strong> across India
          </p>
        </div>
      </div>
    </div>

    <!-- arched feature -->
    <div data-reveal style="--rd:300ms" class="relative mx-auto w-full max-w-md lg:max-w-none">
      <div class="absolute -inset-8 rounded-[3rem] bg-gradient-to-br from-saffron/25 via-golden/20 to-transparent blur-2xl" aria-hidden="true"></div>

      <figure data-tilt class="relative rounded-b-3xl rounded-t-[14rem] border border-golden/40 bg-white p-3 shadow-lift dark:border-golden/25 dark:bg-night-soft">
        <div class="overflow-hidden rounded-b-2xl rounded-t-[13rem]">
          <Image src={picsum("temple-aarti-divine-glow", 880, 1100)} width={880} height={1100}
                 alt="Divine aarti glow at a temple — poster artwork by BhaktiMedia"
                 fetchpriority="high" class="aspect-[4/5] w-full animate-kenburns object-cover" />
        </div>
        <figcaption class="flex items-center justify-between px-2 pb-1 pt-3 text-xs">
          <span class="font-dev text-sandal dark:text-golden">? ???? ?????? ????? ?</span>
          <span class="chip bg-saffron/10 text-saffron">Poster Series</span>
        </figcaption>
        <Bell class="absolute right-8 top-4 size-6 origin-top text-golden animate-swing" aria-hidden="true" />
      </figure>

      <div class="absolute -left-6 top-12 flex animate-float items-center gap-2 rounded-2xl border border-white/60 bg-white/70 px-4 py-3 text-sm font-semibold shadow-soft backdrop-blur-xl dark:border-white/10 dark:bg-night/80">
        <Sparkles class="size-4 text-saffron" /> AI Generated Art
      </div>
      <div class="absolute -right-4 bottom-20 flex animate-float-slow items-center gap-3 rounded-2xl border border-white/60 bg-white/70 px-4 py-3 shadow-soft backdrop-blur-xl dark:border-white/10 dark:bg-night/80">
        <span class="grid size-9 place-items-center rounded-full bg-gradient-to-br from-saffron to-golden text-white">
          <Play class="size-3.5 fill-current" />
        </span>
        <span class="text-left">
          <span class="block font-display text-sm font-bold">2.4M views</span>
          <span class="block text-xs text-sandal-deep/70 dark:text-cream/60">Bhakti Reel · Ganesh Utsav</span>
        </span>
      </div>
      <Diya id="hero-diya" class="absolute -bottom-10 -left-10 w-24 animate-float-slow" />
    </div>
  </div>

  <a href="#services" aria-label="Scroll to services"
     class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-[10px] uppercase tracking-[0.3em] text-sandal/70 dark:text-cream/40 md:flex">
    Scroll
    <span class="h-10 w-px animate-pulse bg-gradient-to-b from-saffron to-transparent"></span>
  </a>
</section>

<!-- demo modal -->
<dialog id="demo-modal" class="m-auto w-[min(92vw,880px)]">
  <div class="relative overflow-hidden rounded-3xl border border-golden/30 bg-night shadow-lift">
    <Image src={picsum("bhaktimedia-showreel", 1280, 720)} width={1280} height={720}
           alt="BhaktiMedia showreel preview" loading="lazy"
           class="aspect-video w-full object-cover opacity-90" />
    <span class="absolute inset-0 grid place-items-center">
      <span class="grid size-20 animate-pulse-dot place-items-center rounded-full bg-gradient-to-br from-saffron to-golden text-white shadow-glow">
        <Play class="size-8 fill-current" />
      </span>
    </span>
    <p class="absolute bottom-4 left-5 font-dev text-sm text-goldsoft">? BhaktiMedia Showreel 2026 ?</p>
  </div>
  <form method="dialog" class="mt-4 text-right">
    <button class="btn btn-glass">Close</button>
  </form>
</dialog>

---
import { site, services } from "../data/site";

const pages = [
  { label: "Home", href: "/" }, { label: "About", href: "/about" },
  { label: "Blog", href: "/blog" }, { label: "Pricing", href: "/pricing" },
  { label: "Contact", href: "/contact" },
];
const media = [
  { label: "Gallery", href: "/gallery" }, { label: "Reels", href: "/reels" },
  { label: "YouTube", href: "/youtube" }, { label: "AI Services", href: "/ai-services" },
];

// SVG icons as HTML strings - works everywhere!
const icons = {
  menu: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>',
  x: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>',
  sun: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>',
  moon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>',
  chevronDown: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>',
  sparkles: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>',
  palette: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>',
  landmark: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>',
  youtube: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>',
  clapperboard: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.2 6 3 11l-.9-2.4c-.3-.8.2-1.7 1-1.9L20.2 3"/><path d="M6.2 13.2 21 9"/><path d="M21 13H3v6a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2z"/></svg>',
  film: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>',
  mic: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>',
  image: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>',
  megaphone: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>',
  globe: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>',
};
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50">
  <div class="container-x">
    <div id="nav-shell" class="flex items-center justify-between gap-4 rounded-2xl px-3 py-2.5 sm:px-4">
      <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={`${site.name} home`}>
        <span class="grid size-10 place-items-center rounded-xl bg-gradient-to-br from-saffron to-golden font-dev text-xl font-bold text-white shadow-gold">ॐ</span>
        <span class="font-display text-lg font-bold tracking-tight">
          Bhakti<span class="text-gradient">Media</span><span class="text-saffron">.in</span>
        </span>
      </a>

      <nav class="hidden lg:block" aria-label="Primary">
        <ul class="flex items-center gap-0.5">
          <li><a class="nav-link" href="/">Home</a></li>
          <li><a class="nav-link" href="/about">About</a></li>

          <li class="group relative">
            <button class="nav-link" aria-haspopup="true">
              Services <span set:html={icons.chevronDown} class="inline-block align-middle" />
            </button>
            <div class="invisible absolute left-1/2 top-full z-50 w-[580px] -translate-x-1/2 pt-4 opacity-0 transition-all duration-300 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <div class="card overflow-hidden p-3 shadow-lift">
                <div class="grid grid-cols-2 gap-1">
                  {services.map((s) => (
                    <a href="/services" class="flex items-start gap-3 rounded-xl p-3 transition hover:bg-cream dark:hover:bg-white/5">
                      <span class="mt-0.5 grid size-9 shrink-0 place-items-center rounded-lg bg-gradient-to-br from-saffron to-golden text-white">
                        <span set:html={icons[s.icon as keyof typeof icons]} />
                      </span>
                      <span>
                        <span class="block text-sm font-semibold">{s.title}</span>
                        <span class="mt-0.5 block text-xs leading-snug text-sandal-deep/60 dark:text-cream/50">{s.desc.slice(0, 52)}…</span>
                      </span>
                    </a>
                  ))}
                </div>
                <a href="/ai-services" class="mt-2 flex items-center justify-between rounded-xl bg-gradient-to-r from-saffron/10 to-golden/10 px-4 py-3 text-sm font-semibold text-saffron">
                  <span class="flex items-center gap-2"><span set:html={icons.sparkles} /> New: AI Devotional Studio</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </li>

          <li class="group relative">
            <button class="nav-link" aria-haspopup="true">
              Media <span set:html={icons.chevronDown} class="inline-block align-middle" />
            </button>
            <div class="invisible absolute left-1/2 top-full z-50 w-52 -translate-x-1/2 pt-4 opacity-0 transition-all duration-300 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <ul class="card p-2 shadow-lift">
                {media.map((m) => (
                  <li><a class="nav-link w-full" href={m.href}>{m.label}</a></li>
                ))}
              </ul>
            </div>
          </li>

          <li><a class="nav-link" href="/blog">Blog</a></li>
          <li><a class="nav-link" href="/pricing">Pricing</a></li>
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <button data-theme-toggle class="icon-btn" aria-label="Toggle dark mode">
          <span class="hidden dark:block"><span set:html={icons.sun} /></span>
          <span class="dark:hidden"><span set:html={icons.moon} /></span>
        </button>
        <a href="/contact" class="btn btn-primary hidden !px-5 !py-2.5 md:inline-flex">Start a Project</a>
        <button id="drawer-open" class="icon-btn lg:hidden" aria-label="Open menu" aria-controls="drawer">
          <span set:html={icons.menu} />
        </button>
      </div>
    </div>
  </div>
</header>

<!-- mobile drawer -->
<div id="drawer-backdrop" class="pointer-events-none fixed inset-0 z-[80] bg-ink/60 opacity-0 backdrop-blur-sm transition-opacity duration-300 [&.open]:pointer-events-auto [&.open]:opacity-100"></div>
<aside id="drawer" aria-label="Mobile menu"
       class="fixed inset-y-0 right-0 z-[90] flex w-[88%] max-w-sm translate-x-full flex-col overflow-y-auto bg-temple p-6 shadow-lift transition-transform duration-500 dark:bg-night [&.open]:translate-x-0">
  <div class="flex items-center justify-between">
    <span class="flex items-center gap-2.5">
      <span class="grid size-9 place-items-center rounded-xl bg-gradient-to-br from-saffron to-golden font-dev text-lg font-bold text-white">ॐ</span>
      <span class="font-display font-bold">Bhakti<span class="text-gradient">Media</span><span class="text-saffron">.in</span></span>
    </span>
    <button data-drawer-close class="icon-btn" aria-label="Close menu"><span set:html={icons.x} /></button>
  </div>

  <nav class="mt-8" aria-label="Mobile">
    <ul class="grid gap-1 font-display text-lg font-semibold">
      {[...pages.slice(0, 2), ...media, ...pages.slice(2)].map((p) => (
        <li><a class="nav-link w-full !py-3 !text-base" href={p.href}>{p.label}</a></li>
      ))}
    </ul>
    <p class="eyebrow mt-8">Services</p>
    <ul class="mt-3 grid grid-cols-2 gap-1 text-sm">
      {services.map((s) => (
        <li>
          <a href="/services" class="flex items-center gap-2 rounded-lg px-3 py-2 text-sandal-deep/80 transition hover:bg-saffron/10 hover:text-saffron dark:text-cream/70">
            <span class="text-saffron"><span set:html={icons[s.icon as keyof typeof icons]} /></span> {s.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mt-auto space-y-4 pt-10">
    <a href="/contact" class="btn btn-primary w-full">Start a Project</a>
    <p class="text-center font-dev text-sm text-sandal dark:text-golden/70">{site.tagline} · डिजिटल भक्ती, प्रत्येक हृदयासाठी</p>
  </div>
</aside>
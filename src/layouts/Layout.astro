---
import "../styles/global.css";
import "@fontsource/poppins/300.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "@fontsource/inter";
import "@fontsource/noto-serif-devanagari";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const isStudio = Astro.url.pathname.startsWith("/studio");
---
<!doctype html>
<html lang="en">
    <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    
    <!-- Open Graph (Facebook, LinkedIn, WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={new URL("/og-default.png", Astro.site).href} />
    <meta property="og:locale" content="en_IN" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og-default.png", Astro.site).href} />
    
    <!-- SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content={site.name} />
  </head>
  <body class="relative">
    <Navbar />
    <main><slot /></main>

    {!isStudio && <Footer />}

    {!isStudio && (
      <a href={site.socials.whatsapp} target="_blank" rel="noopener" aria-label="Chat on WhatsApp"
         class="fixed bottom-5 right-5 z-40 grid size-12 place-items-center rounded-full bg-gradient-to-br from-saffron to-golden text-white shadow-lg transition hover:scale-105">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/>
        </svg>
      </a>
    )}

    <script>import "../scripts/effects.ts";</script>
    <script is:inline>
(function () {
  var raw = null;
  try {
    for (var i = 0; i < localStorage.length; i++) {
      var k = localStorage.key(i);
      if (k && k.indexOf("sb-") === 0 && k.indexOf("auth-token") !== -1) { raw = localStorage.getItem(k); break; }
    }
  } catch (e) {}
  if (!raw) return;

  var name = "Dashboard";
  try {
    var s = JSON.parse(raw);
    if (s && s.user) name = (s.user.user_metadata && s.user.user_metadata.name) || s.user.email || "Dashboard";
  } catch (e) {}

  document.querySelectorAll('a[href="/login"]').forEach(function (a) {
    a.href = "/dashboard";
    a.innerHTML = "🪔 " + name;
    a.classList.remove("hidden");
  });

  document.querySelectorAll('a[href="/signup"]').forEach(function (a) {
    a.removeAttribute("href");
    a.style.cursor = "pointer";
    a.textContent = "Logout";
    a.addEventListener("click", function (e) {
      e.preventDefault();
      try {
        var rm = [];
        for (var j = 0; j < localStorage.length; j++) {
          var key = localStorage.key(j);
          if (key && key.indexOf("sb-") === 0) rm.push(key);
        }
        rm.forEach(function (key) { localStorage.removeItem(key); });
      } catch (e2) {}
      localStorage.setItem("bm-welcome", "👋 Logout ho gaya. Phir milenge!");
      window.location.href = "/";
    });
  });
})();
</script>
  </body>
</html>